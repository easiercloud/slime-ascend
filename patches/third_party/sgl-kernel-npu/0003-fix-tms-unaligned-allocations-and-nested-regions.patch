From 1c65753fa4f0760d117134eabb5ce07af7a87e6c Mon Sep 17 00:00:00 2001
From: slime-sync <slime-sync@localhost>
Date: Mon, 26 Oct 2026 12:02:25 +0000
Subject: [PATCH] Handle unaligned ACL allocations and nested TMS regions

---
 contrib/torch_memory_saver/csrc/entrypoint.cpp | 18 ++++++++++++++++--
 contrib/torch_memory_saver/csrc/utils.h        | 15 +++++++++++++++
 .../torch_memory_saver/binary_wrapper.py       |  2 ++
 .../python/torch_memory_saver/entrypoint.py    | 12 +++++++++---
 4 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/contrib/torch_memory_saver/csrc/entrypoint.cpp b/contrib/torch_memory_saver/csrc/entrypoint.cpp
index 17ea097..57c02df 100644
--- a/contrib/torch_memory_saver/csrc/entrypoint.cpp
+++ b/contrib/torch_memory_saver/csrc/entrypoint.cpp
@@ -41,9 +41,15 @@ static thread_local ThreadLocalConfig thread_local_config;
 aclError aclrtMallocAlign32(void **ptr, size_t size,
                             aclrtMemMallocPolicy policy) {
   if (thread_local_config.is_interesting_region()) {
+    int device = CANNUtils::cann_ctx_get_device();
+    size_t granularity = CANNUtils::cann_mem_granularity(device);
+    // Ordinary ACL allocations need not satisfy the physical memory granularity.
+    // Leave those allocations with ACL instead of passing them to the VMM API.
+    if (granularity == 0 || size % granularity != 0) {
+      return APIForwarder::call_real_aclrt_malloc_align32(ptr, size, policy);
+    }
     return TorchMemorySaver::instance().malloc(
-        ptr, CANNUtils::cann_ctx_get_device(), size,
-        thread_local_config.current_tag_,
+        ptr, device, size, thread_local_config.current_tag_,
         thread_local_config.enable_cpu_backup());
   } else {
     return APIForwarder::call_real_aclrt_malloc_align32(ptr, size, policy);
@@ -95,6 +101,14 @@ bool tms_get_interesting_region() {
   return thread_local_config.is_interesting_region();
 }
 
+const char *tms_get_current_tag() {
+  return thread_local_config.current_tag_.c_str();
+}
+
+bool tms_get_enable_cpu_backup() {
+  return thread_local_config.enable_cpu_backup();
+}
+
 void tms_set_current_tag(const char *tag) {
   SIMPLE_CHECK(tag != nullptr, "tag should not be null");
   thread_local_config.current_tag_ = tag;
diff --git a/contrib/torch_memory_saver/csrc/utils.h b/contrib/torch_memory_saver/csrc/utils.h
index 980273f..944111e 100644
--- a/contrib/torch_memory_saver/csrc/utils.h
+++ b/contrib/torch_memory_saver/csrc/utils.h
@@ -37,6 +37,21 @@ static void cann_mem_create(aclrtDrvMemHandle *alloc_handle, size_t size,
   SIMPLE_CHECK(ret == ACL_SUCCESS, "aclrtMallocPhysical failed");
 }
 
+static size_t cann_mem_granularity(int device) {
+  // The physical allocation and map APIs require their reported granularity.
+  aclrtPhysicalMemProp prop = {};
+  prop.allocationType = ACL_MEM_ALLOCATION_TYPE_PINNED;
+  prop.location.type = ACL_MEM_LOCATION_TYPE_DEVICE;
+  prop.location.id = device;
+  prop.memAttr = ACL_HBM_MEM_HUGE;
+  prop.reserve = 0;
+  prop.handleType = ACL_MEM_HANDLE_TYPE_NONE;
+  size_t granularity = 0;
+  aclError ret = aclrtMemGetAllocationGranularity(
+      &prop, ACL_RT_MEM_ALLOC_GRANULARITY_MINIMUM, &granularity);
+  return ret == ACL_SUCCESS ? granularity : 0;
+}
+
 static int cann_ctx_get_device() {
   int ans;
   aclError ret = aclrtGetDevice(&ans);
diff --git a/contrib/torch_memory_saver/python/torch_memory_saver/binary_wrapper.py b/contrib/torch_memory_saver/python/torch_memory_saver/binary_wrapper.py
index 49ed972..65a8fa0 100644
--- a/contrib/torch_memory_saver/python/torch_memory_saver/binary_wrapper.py
+++ b/contrib/torch_memory_saver/python/torch_memory_saver/binary_wrapper.py
@@ -27,6 +27,8 @@ def _setup_function_signatures(cdll):
     cdll.tms_set_current_tag.argtypes = [ctypes.c_char_p]
     cdll.tms_set_interesting_region.argtypes = [ctypes.c_bool]
     cdll.tms_get_interesting_region.restype = ctypes.c_bool
+    cdll.tms_get_current_tag.restype = ctypes.c_char_p
+    cdll.tms_get_enable_cpu_backup.restype = ctypes.c_bool
     cdll.tms_set_enable_cpu_backup.argtypes = [ctypes.c_bool]
     cdll.tms_pause.argtypes = [ctypes.c_char_p]
     cdll.tms_resume.argtypes = [ctypes.c_char_p]
diff --git a/contrib/torch_memory_saver/python/torch_memory_saver/entrypoint.py b/contrib/torch_memory_saver/python/torch_memory_saver/entrypoint.py
index 9066a40..daf75d5 100644
--- a/contrib/torch_memory_saver/python/torch_memory_saver/entrypoint.py
+++ b/contrib/torch_memory_saver/python/torch_memory_saver/entrypoint.py
@@ -134,16 +134,22 @@ class _TorchMemorySaverImpl:
 
     @contextmanager
     def _with_region_config(self, tag: str, enable_cpu_backup: bool):
-        assert not self._binary_wrapper.cdll.tms_get_interesting_region()
+        cdll = self._binary_wrapper.cdll
+        previous = (
+            cdll.tms_get_current_tag().decode("utf-8"),
+            cdll.tms_get_interesting_region(),
+            cdll.tms_get_enable_cpu_backup(),
+        )
         self._binary_wrapper.set_config(
             tag=tag, interesting_region=True, enable_cpu_backup=enable_cpu_backup
         )
         try:
             yield
         finally:
-            assert self._binary_wrapper.cdll.tms_get_interesting_region()
             self._binary_wrapper.set_config(
-                tag=_TAG_DEFAULT, interesting_region=False, enable_cpu_backup=False
+                tag=previous[0],
+                interesting_region=previous[1],
+                enable_cpu_backup=previous[2],
             )
 
     @contextmanager
