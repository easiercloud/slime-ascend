From 2c37680e0215f2cd8eb268f53f6215f88d69cd5e Mon Sep 17 00:00:00 2001
From: slime-ascend <slime-ascend@local>
Date: Fri, 4 Sep 2026 07:45:57 +0000
Subject: [PATCH] isolate dependency paths for checkpoint and Ray workers

---
 slime/utils/external_utils/command_utils.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/slime/utils/external_utils/command_utils.py b/slime/utils/external_utils/command_utils.py
index a0b98a10..ecc718bf 100644
--- a/slime/utils/external_utils/command_utils.py
+++ b/slime/utils/external_utils/command_utils.py
@@ -52,7 +52,7 @@ def convert_checkpoint(
 
     exec_command(
         f"source {repo_base_dir}/scripts/models/{megatron_model_type}.sh && "
-        f"PYTHONPATH={repo_base_dir}:/root/Megatron-LM:${{PYTHONPATH:-}} "
+        f"PYTHONPATH=path/to/Megatron-LM:path/to/Megatron-Bridge/src:path/to/MegatronAdaptor:path/to/TransformerEngineNPU:$PYTHONPATH "
         f"torchrun "
         f"--nproc-per-node {num_gpus_per_node} "
         f"{multinode_args}"
@@ -137,8 +137,12 @@ def execute_train(
     runtime_env_json = json.dumps(
         {
             "env_vars": {
-                "PYTHONPATH": "/root/Megatron-LM/",
+                "PYTHONPATH": "path/to/Megatron-LM:path/to/Megatron-Bridge/src:path/to/MegatronAdaptor:path/to/TransformerEngineNPU:$PYTHONPATH",
                 "RAY_USE_UVLOOP": "0",
+                "SLIME_ENABLE_PROFILING": "False",
+                "RAY_EXPERIMENTAL_NOSET_ASCEND_RT_VISIBLE_DEVICES": "1",
+                "RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO": "0",
+                "RAY_EXPERIMENTAL_NOSET_CUDA_VISIBLE_DEVICES": "1",
                 "CUDA_DEVICE_MAX_CONNECTIONS": "1",
                 "NCCL_NVLS_ENABLE": str(int(check_has_nvlink())),
                 "no_proxy": f"127.0.0.1,{master_addr}",
-- 
2.34.1

