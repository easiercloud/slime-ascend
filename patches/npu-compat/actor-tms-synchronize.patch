From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slime-ascend <slime-ascend@local>
Date: Thu, 17 Sep 2026 00:00:00 +0000
Subject: [PATCH] [Ascend] synchronize NPU before TMS weight transfer

On Ascend, asynchronous graph work may still be winding down when the
offload path disables TorchMemorySaver. Synchronize the NPU stream before the
TMS transition so weight transfer starts from a quiescent stream.

---
 slime/backends/megatron_utils/actor.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/slime/backends/megatron_utils/actor.py b/slime/backends/megatron_utils/actor.py
index 0c39e1d..c74161a 100644
--- a/slime/backends/megatron_utils/actor.py
+++ b/slime/backends/megatron_utils/actor.py
@@ -602,6 +602,11 @@ class MegatronTrainRayActor(TrainRayActor):
             if dist.get_rank() == 0:
                 ray.get(self.rollout_manager.clear_updatable_num_new_engines.remote())
 
+        # Ascend's allocator rejects a TMS transition while an asynchronous
+        # graph capture is still winding down.  Synchronize before disabling
+        # TMS so weight transfer starts from a quiescent NPU stream.
+        if self.args.offload_train and hasattr(torch, "npu"):
+            torch.npu.synchronize()
         with torch_memory_saver.disable() if self.args.offload_train else nullcontext():
             print_memory("before update_weights")
             self.weight_updater.update_weights()
-- 
