From 9952bbfed5e841335a378595eab47e13df29bdf0 Mon Sep 17 00:00:00 2001
From: WBiXin <wangbingxuan@huawei.com>
Date: Sat, 21 Nov 2026 19:01:03 +0800
Subject: [PATCH] Bound deployment port search and support SLIME_MIN_PORT

---
 slime/utils/misc.py | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/slime/utils/misc.py b/slime/utils/misc.py
index 09084556..011f816a 100644
--- a/slime/utils/misc.py
+++ b/slime/utils/misc.py
@@ -1,3 +1,4 @@
+import os
 import importlib
 import subprocess
 import warnings
@@ -110,10 +111,14 @@ def get_current_node_ip():
 
 def get_free_port(start_port=10000, consecutive=1):
     # find the port where port, port + 1, port + 2, ... port + consecutive - 1 are all available
-    port = start_port
-    while not all(is_port_available(port + i) for i in range(consecutive)):
-        port += 1
-    return port
+    # Keep deployment-specific ports configurable and never scan invalid ports.
+    start_port = max(start_port, int(os.environ.get("SLIME_MIN_PORT", "1")))
+    if consecutive < 1 or not 1 <= start_port <= 65536 - consecutive:
+        raise ValueError(f"Invalid port range: {start_port=}, {consecutive=}")
+    for port in range(start_port, 65537 - consecutive):
+        if all(is_port_available(port + i) for i in range(consecutive)):
+            return port
+    raise RuntimeError(f"No block of {consecutive} free ports from {start_port} to 65535")
 
 
 def should_run_periodic_action(
-- 
