+def reshard_to_master_shards(model):
+    """End an inference-only forward boundary using native FSDP's public API.
+
+    Native root FSDP may retain BF16 unsharded compute parameters after a
+    no-grad forward. Restore the original FP32 DTensor Parameters before
+    inspecting/exporting masters or beginning a new autograd forward. Never
+    call this between a grad-enabled forward and its backward.
+    """
+    from torch.distributed.fsdp import FSDPModule
+    from torch.distributed.tensor import DTensor
+
+    modules = [module for module in model.modules() if isinstance(module, FSDPModule)]
+    if not modules:
+        raise RuntimeError("Expected the native FSDP model at an inference boundary")
+    # reshard() is deliberately non-recursive in the public FSDP API.
+    for module in reversed(modules):
+        module.reshard()
+    parameters = dict(model.named_parameters())
+    for name, parameter in parameters.items():
+        if not isinstance(parameter, DTensor) or parameter.to_local().dtype != torch.float32:
+            raise RuntimeError(f"Inference boundary did not restore the FP32 master shard: {name}")
+    return {"fsdp_modules": len(modules), "master_parameters": len(parameters)}
+
