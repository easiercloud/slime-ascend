diff --git a/slime/backends/fsdp2_utils/precision_audit.py b/slime/backends/fsdp2_utils/precision_audit.py
new file mode 100644
index 00000000..718b2aa1
--- /dev/null
+++ b/slime/backends/fsdp2_utils/precision_audit.py
@@ -0,0 +1,684 @@
+"""Optional measured precision and full byte audit for the real FSDP2 actor.
+
+Disabled unless SLIME_FSDP2_PRECISION_AUDIT=1 is passed to training workers.
+No training algorithm, communication result or checkpoint dtype is replaced.
+"""
+
+from contextlib import contextmanager
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+
+import torch
+from torch.utils._python_dispatch import TorchDispatchMode
+
+
+def cpu_tensor(value):
+    """Return an independent contiguous CPU copy, including a DTensor's shard."""
+    value = value.detach()
+    if hasattr(value, "to_local"):
+        value = value.to_local()
+    return value.to(device="cpu", copy=True).contiguous()
+
+
+def tensor_sha256(value):
+    """Hash exact contiguous bytes, including BF16 and signed zero representations."""
+    value = cpu_tensor(value)
+    raw = value.reshape(-1).view(torch.uint8).numpy()
+    return hashlib.sha256(memoryview(raw)).hexdigest()
+
+
+def tensor_record(value, *, hash_bytes=True):
+    if not isinstance(value, torch.Tensor):
+        raise TypeError(f"Expected a tensor, got {type(value).__name__}")
+    local = value.to_local() if hasattr(value, "to_local") else value
+    record = {"dtype": str(local.dtype), "device": str(local.device), "shape": list(local.shape),
+              "numel": local.numel(), "finite": bool(torch.isfinite(local.detach()).all().item())}
+    if hash_bytes:
+        record["sha256"] = tensor_sha256(local)
+    return record
+
+
+def placement_record(value):
+    if not hasattr(value, "placements"):
+        return {"sharded": False}
+    specs = []
+    for placement in value.placements:
+        if placement.is_replicate():
+            specs.append({"kind": "Replicate"})
+        elif placement.is_shard():
+            specs.append({"kind": "Shard", "dim": placement.dim})
+        else:
+            raise ValueError(f"Cannot cold-load compare a partial placement: {placement}")
+    return {"sharded": True, "global_shape": list(value.shape),
+            "mesh_shape": list(value.device_mesh.shape), "mesh_coordinate": value.device_mesh.get_coordinate(),
+            "placements": [str(p) for p in value.placements], "placement_specs": specs}
+
+
+def parameter_shards(model, *, expected_dtype=torch.float32, require_world_size=None):
+    records = {}
+    for name, parameter in model.named_parameters():
+        local = parameter.to_local() if hasattr(parameter, "to_local") else parameter
+        record = {**tensor_record(parameter), **placement_record(parameter)}
+        if local.dtype != expected_dtype or not record["finite"]:
+            raise AssertionError(f"Invalid resident parameter {name}: {record}")
+        if require_world_size is not None and (
+            not record["sharded"] or local.numel() * require_world_size != parameter.numel()
+        ):
+            raise AssertionError(f"Parameter {name} is not exactly {require_world_size}-way sharded")
+        records[name] = record
+    if not records:
+        raise AssertionError("No model parameters were inspected")
+    return records
+
+
+def gradient_records(model, *, require_all=True, expected_dtype=torch.float32):
+    records = {}
+    for name, parameter in model.named_parameters():
+        if not parameter.requires_grad:
+            continue
+        if parameter.grad is None:
+            records[name] = {"missing": True}
+            if require_all:
+                raise AssertionError(f"Trainable parameter has no gradient: {name}")
+            continue
+        record = tensor_record(parameter.grad)
+        record["missing"] = False
+        local = parameter.grad.to_local() if hasattr(parameter.grad, "to_local") else parameter.grad
+        record["l2"] = cpu_tensor(local).double().norm().item()
+        if local.dtype != expected_dtype or not record["finite"]:
+            raise AssertionError(f"Invalid gradient for {name}: {record}")
+        records[name] = record
+    return records
+
+
+def optimizer_records(model, optimizer, *, initialized):
+    records = {}
+    for name, parameter in model.named_parameters():
+        state = optimizer.state.get(parameter, {})
+        result = {}
+        for key, value in state.items():
+            if isinstance(value, torch.Tensor):
+                record = tensor_record(value)
+                if not record["finite"]:
+                    raise AssertionError(f"Nonfinite optimizer state: {name}.{key}")
+                if key in ("exp_avg", "exp_avg_sq") and value.dtype != torch.float32:
+                    raise AssertionError(f"Adam moment is not FP32: {name}.{key}: {value.dtype}")
+                if value.numel() == 1:
+                    record["value"] = value.item()
+                result[key] = record
+            else:
+                result[key] = {"value": value}
+        if initialized and parameter.requires_grad and not {"step", "exp_avg", "exp_avg_sq"} <= state.keys():
+            raise AssertionError(f"Missing Adam state for {name}")
+        records[name] = result
+    return records
+
+
+def buffer_records(model, expected_floating_dtype=torch.float32):
+    result = {name: tensor_record(value) for name, value in model.named_buffers()}
+    for name, record in result.items():
+        value = dict(model.named_buffers())[name]
+        if value.is_floating_point() and value.dtype != expected_floating_dtype:
+            raise AssertionError(f"Sensitive buffer is not {expected_floating_dtype}: {name}: {value.dtype}")
+        if not record["finite"]:
+            raise AssertionError(f"Nonfinite buffer: {name}")
+    return result
+
+
+def coldload_shard(full_tensor, record):
+    """Use the recorded mesh coordinate and placements, never rank modulo guesses."""
+    value = full_tensor.detach()
+    if list(value.shape) != record["global_shape"]:
+        raise AssertionError("Cold-load global shape differs from the live parameter")
+    for size, coordinate, spec in zip(record["mesh_shape"], record["mesh_coordinate"],
+                                      record["placement_specs"], strict=True):
+        if spec["kind"] == "Shard":
+            dimension = spec["dim"]
+            if value.shape[dimension] % size:
+                raise AssertionError("This audit requires evenly divisible shards")
+            value = value.chunk(size, dim=dimension)[coordinate]
+        elif spec["kind"] != "Replicate":
+            raise AssertionError("Unexpected placement")
+    value = value.contiguous()
+    if list(value.shape) != record["shape"]:
+        raise AssertionError("Cold-load local shape differs from the live shard")
+    return value
+
+
+def byte_equal(left, right):
+    left, right = cpu_tensor(left), cpu_tensor(right)
+    return (left.dtype == right.dtype and left.shape == right.shape
+            and torch.equal(left.reshape(-1).view(torch.uint8), right.reshape(-1).view(torch.uint8)))
+
+
+def _not_json(value):
+    raise TypeError(f"Not JSON serializable: {type(value).__name__}")
+
+
+def write_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    temporary.write_text(json.dumps(value, indent=2, allow_nan=False, default=lambda item: str(item) if isinstance(item, Path) else _not_json(item)) + "\n")
+    os.replace(temporary, path)
+
+
+def _tensors(value):
+    if isinstance(value, torch.Tensor):
+        yield value
+    elif isinstance(value, dict):
+        for child in value.values():
+            yield from _tensors(child)
+    elif isinstance(value, (list, tuple)):
+        for child in value:
+            yield from _tensors(child)
+
+
+class ModuleProbe:
+    """Observe real leaf inputs/outputs, unsharded weights and sensitive buffers."""
+
+    def __init__(self, model):
+        self.phase = "setup"
+        self.records = []
+        self.handles = []
+        self.module_types = {}
+        for name, module in model.named_modules():
+            kind = type(module).__name__
+            # Native FSDP dynamically subclasses independently wrapped leaves
+            # as FSDPLinear/FSDPEmbedding. Their real nn base types are retained.
+            dense_leaf = isinstance(module, (torch.nn.Linear, torch.nn.Embedding))
+            if not dense_leaf and "RMSNorm" not in kind and "RotaryEmbedding" not in kind:
+                continue
+            self.module_types[name] = type(module).__module__ + "." + type(module).__qualname__
+            self.handles.append(module.register_forward_pre_hook(self._pre(name), with_kwargs=True))
+            self.handles.append(module.register_forward_hook(self._post(name), with_kwargs=True))
+
+    def _append(self, name, event, tensors, parameters=None):
+        records = [tensor_record(tensor, hash_bytes=False) for tensor in tensors]
+        if any(not record["finite"] for record in records) or any(not record["finite"] for record in (parameters or {}).values()):
+            raise AssertionError(f"Nonfinite module {event}: {name}, phase {self.phase}")
+        self.records.append({"phase": self.phase, "module": name, "module_type": self.module_types[name], "event": event,
+                             "tensors": records, "parameters": parameters or {}})
+
+    def _pre(self, name):
+        def observe(module, inputs, kwargs):
+            parameters = {key: tensor_record(value, hash_bytes=False)
+                          for key, value in module.named_parameters(recurse=False)}
+            self._append(name, "input", _tensors((inputs, kwargs)), parameters)
+        return observe
+
+    def _post(self, name):
+        def observe(module, inputs, kwargs, output):
+            self._append(name, "output", _tensors(output))
+        return observe
+
+    def close(self):
+        for handle in self.handles:
+            handle.remove()
+        self.handles.clear()
+
+
+class OperatorProbe(TorchDispatchMode):
+    """Record metadata of existing sensitive ATen calls without changing results."""
+
+    def __init__(self):
+        super().__init__()
+        self.phase = "setup"
+        self.records = []
+
+    def __torch_dispatch__(self, func, types, args=(), kwargs=None):
+        result = func(*args, **(kwargs or {}))
+        name = func._schema.name.split("::")[-1]
+        if name in {"mean", "rsqrt", "softmax", "_softmax", "log_softmax", "_log_softmax", "sin", "cos"}:
+            def metadata(value):
+                return [{"dtype": str(tensor.dtype), "device": str(tensor.device), "shape": list(tensor.shape)}
+                        for tensor in _tensors(value)]
+            self.records.append({"phase": self.phase, "operator": str(func), "family": name.lstrip("_"),
+                                 "inputs": metadata((args, kwargs or {})), "outputs": metadata(result)})
+        return result
+
+
+def validate_operator_observations(records):
+    required = {"mean", "rsqrt", "softmax", "log_softmax", "sin", "cos"}
+    seen = {record["family"] for record in records}
+    if not required <= seen:
+        raise AssertionError(f"Sensitive operator evidence is incomplete: {required - seen}")
+    for record in records:
+        tensors = record["inputs"] + record["outputs"]
+        if not tensors or any(tensor["dtype"] != "torch.float32" for tensor in tensors):
+            raise AssertionError(f"Sensitive operator did not execute in FP32: {record}")
+    return {"passed": True, "operator_families": sorted(seen), "calls": len(records),
+            "observed_input_output_dtype": "torch.float32", "scope": "Existing forward ATen calls only"}
+
+
+def compare_response_logprobs(current, previous, mask):
+    """Detach existing response values; only independent CPU copies are inspected."""
+    actual_dtype = str(current.dtype)
+    current = cpu_tensor(current)
+    previous = cpu_tensor(torch.as_tensor(previous, dtype=torch.float32))
+    mask = cpu_tensor(torch.as_tensor(mask, dtype=torch.float32))
+    if current.ndim != 1 or current.shape != previous.shape or current.shape != mask.shape:
+        raise AssertionError("Current/old response logprob and mask shapes differ")
+    if current.dtype != torch.float32 or any(not torch.isfinite(value).all() for value in (current, previous, mask)):
+        raise AssertionError("Response audit requires actual finite FP32 current/old logprobs and mask")
+    if (mask < 0).any():
+        raise AssertionError("Response audit mask is negative")
+    difference = current - previous
+    ratio = difference.exp()
+    if not torch.isfinite(ratio).all():
+        raise AssertionError("Response audit probability ratio is nonfinite")
+    valid = mask > 0
+    return {"current_dtype": actual_dtype, "old_dtype_used_by_loss": str(previous.dtype),
+            "current_log_probs": current.tolist(), "old_log_probs": previous.tolist(),
+            "difference": difference.tolist(), "ratio": ratio.tolist(), "loss_mask": mask.tolist(),
+            "response_tokens": current.numel(), "valid_tokens": int(valid.sum().item()),
+            "all_response_max_abs": difference.abs().max().item() if current.numel() else 0.0,
+            "valid_response_max_abs": difference[valid].abs().max().item() if valid.any() else 0.0}
+
+
+def validate_logprob_tolerance(path, temperature, manifest):
+    raw = Path(path).read_bytes()
+    value = json.loads(raw)
+    limit = value.get("max_abs")
+    if (value.get("schema_version") != 1 or value.get("metric") != "response_token_logprob_max_abs"
+            or value.get("acceptance_ready") is not True or isinstance(limit, bool)
+            or not isinstance(limit, (int, float)) or not math.isfinite(limit) or limit < 0):
+        raise AssertionError("Independent logprob tolerance is not ready or has an invalid maximum")
+    if value.get("temperature") != temperature:
+        raise AssertionError("Independent logprob tolerance temperature differs from actual training")
+    full_hashes = manifest.get("precision_audit", {}).get("full_parameter_sha256")
+    candidate_hashes = value.get("full_parameter_sha256", {})
+    if candidate_hashes and all(isinstance(item, str) for item in candidate_hashes.values()):
+        candidate_hashes = {"checkpoint": candidate_hashes}
+    parameter_match = bool(full_hashes) and any(item == full_hashes for item in candidate_hashes.values())
+    files = {name: record["sha256"] for name, record in manifest["files"].items() if name.endswith(".safetensors")}
+    payloads = value.get("checkpoint_payload_sha256", {})
+    payload_match = bool(files) and any(
+        all(item.get(name) == digest for name, digest in files.items()) for item in payloads.values())
+    if not parameter_match and not payload_match:
+        raise AssertionError("Independent logprob tolerance was not calibrated on this accepted checkpoint")
+    return {"max_abs": float(limit), "temperature": temperature, "checkpoint_match": True,
+            "match_by": "complete parameter bytes" if parameter_match else "complete safetensors payload bytes",
+            "tolerance_file_sha256": hashlib.sha256(raw).hexdigest(), "calibration": value,
+            "scope": "Empirical independent-HF calibrated max_abs on this checkpoint; valid loss-mask tokens"}
+
+
+def policy_case_fingerprint(sample):
+    value = {"prompt_token_ids": [int(item) for item in sample["prompt_token_ids"]],
+             "response_token_ids": [int(item) for item in sample["response_token_ids"]],
+             "loss_mask": [float(item) for item in sample["loss_mask"]]}
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest()
+
+
+def validate_policy_cases(samples, calibration):
+    fingerprints = calibration.get("case_fingerprints_sha256")
+    if not isinstance(fingerprints, list) or not fingerprints or any(not isinstance(value, str) for value in fingerprints):
+        raise AssertionError("Independent HF calibration is missing its actual token/mask case fingerprints")
+    for sample in samples:
+        fingerprint = policy_case_fingerprint(sample)
+        if sample.get("case_fingerprint_sha256", fingerprint) != fingerprint:
+            raise AssertionError("Saved response token/mask case fingerprint is internally inconsistent")
+        if fingerprint not in fingerprints:
+            raise AssertionError("Actual response token/mask case was not independently HF calibrated")
+
+
+def evaluate_saved_policy_logprobs(records, calibration_path, *, expected_world_size=8, expected_steps=2):
+    """Validate saved actual-forward LPs post hoc, never recompute a forward."""
+    if not records:
+        raise AssertionError("No actual training-forward response records were provided")
+    if expected_world_size < 1 or expected_steps < 1:
+        raise AssertionError("Expected actual run inventory must be positive")
+    if {record["step"] for record in records} != set(range(1, expected_steps + 1)):
+        raise AssertionError("Saved response audit does not cover every expected optimizer step")
+    for step in range(1, expected_steps + 1):
+        step_records = [record for record in records if record["step"] == step]
+        if ({record["rank"] for record in step_records} != set(range(expected_world_size))
+                or any(record["world_size"] != expected_world_size for record in step_records)):
+            raise AssertionError("Saved response audit does not cover every actual training rank")
+        expected_batches = {record["expected_microbatches"] for record in step_records}
+        global_batches = {record["global_batch_size"] for record in step_records}
+        if len(expected_batches) != 1 or len(global_batches) != 1 or next(iter(expected_batches)) < 1:
+            raise AssertionError("Saved response audit has inconsistent global/microbatch inventory")
+        expected_pairs = {(rank, mb) for rank in range(expected_world_size) for mb in range(next(iter(expected_batches)))}
+        pairs = [(record["rank"], record["microbatch"]) for record in step_records]
+        ids = [sample["sample_rollout_id"] for record in step_records for sample in record["samples"]]
+        if (len(pairs) != len(expected_pairs) or set(pairs) != expected_pairs
+                or len(ids) != next(iter(global_batches)) or len(set(ids)) != len(ids)):
+            raise AssertionError("Saved response audit has missing or duplicate rank/microbatch/sample coverage")
+    checked = []
+    for record in records:
+        if record.get("old_logprob_source") != "external_rollout_log_probs":
+            raise AssertionError("Saved old logprobs are not from external rollout")
+        tolerance = validate_logprob_tolerance(calibration_path, record["temperature"], record["accepted_manifest"])
+        if (record["accepted_manifest"]["weight_version"] != record["accepted_weight_version"]
+                or record["accepted_weight_version"] != record["step"] - 1):
+            raise AssertionError("Saved response audit accepted weight version differs from the actual step")
+        samples = record["samples"]
+        if not samples:
+            raise AssertionError("Saved training microbatch has no response observations")
+        validate_policy_cases(samples, tolerance["calibration"])
+        maximum = 0.0
+        valid_count = 0
+        for sample in samples:
+            measured = compare_response_logprobs(torch.tensor(sample["current_log_probs"], dtype=torch.float32),
+                                               sample["old_log_probs"], sample["loss_mask"])
+            for key in ("difference", "ratio", "valid_tokens", "valid_response_max_abs", "all_response_max_abs"):
+                if measured[key] != sample[key]:
+                    raise AssertionError(f"Saved response audit is internally inconsistent: {key}")
+            maximum = max(maximum, measured["valid_response_max_abs"])
+            valid_count += measured["valid_tokens"]
+        if not valid_count:
+            raise AssertionError("Saved microbatch has no valid response tokens")
+        checked.append({"rank": record["rank"], "step": record["step"], "microbatch": record["microbatch"],
+                        "accepted_weight_version": record["accepted_weight_version"], "valid_tokens": valid_count,
+                        "max_abs": maximum, "limit": tolerance["max_abs"], "passed": maximum <= tolerance["max_abs"],
+                        "tolerance_file_sha256": tolerance["tolerance_file_sha256"]})
+    return {"passed": all(item["passed"] for item in checked), "records": checked,
+            "scope": "Saved actual training-forward current/rollout LPs; no new model forward"}
+
+
+class CollectiveProbe:
+    """Wrap the real process collectives, recording actual wire tensor dtypes.
+
+    No replacement result, mock collective, compiler patch or permission change
+    is used. The original call is always executed and exceptions propagate.
+    """
+
+    def __init__(self):
+        self.phase = "setup"
+        self.records = []
+        self.originals = {}
+
+    @contextmanager
+    def observe(self):
+        import torch.distributed as dist
+
+        try:
+            for name in ("reduce_scatter_tensor", "all_gather_into_tensor", "all_reduce"):
+                original = getattr(dist, name)
+                self.originals[name] = original
+                setattr(dist, name, self._wrap(name, original))
+            yield self
+        finally:
+            for name, original in self.originals.items():
+                setattr(dist, name, original)
+            self.originals.clear()
+
+    def _wrap(self, name, original):
+        def observed(*args, **kwargs):
+            # Capture metadata before the genuine collective. Avoid synchronizing
+            # async output buffers or introducing a second collective here.
+            tensors = list(_tensors(args)) + list(_tensors({k: v for k, v in kwargs.items()
+                                                          if k in ("tensor", "input_tensor", "output_tensor", "input", "output")}))
+            record = {"phase": self.phase, "collective": name, "op": str(kwargs.get("op", "default")),
+                      "async_op": kwargs.get("async_op", False),
+                      "tensors": [{"dtype": str(value.dtype), "device": str(value.device),
+                                   "shape": list(value.shape)} for value in tensors]}
+            self.records.append(record)
+            return original(*args, **kwargs)
+        return observed
+
+
+def validate_observations(module_records, collective_records, parameter_names, forward_dtype, world_size):
+    """Fail when the real forward/reduction evidence contradicts the policy."""
+    expected = {"bf16": "torch.bfloat16", "fp32": "torch.float32"}[forward_dtype]
+    seen = {}
+    for event in module_records:
+        if event["event"] != "input":
+            continue
+        for key, tensor in event["parameters"].items():
+            name = f"{event['module']}.{key}" if event["module"] else key
+            if tensor["dtype"] != expected or not tensor["finite"]:
+                raise AssertionError(f"Observed compute parameter {name} differs from {expected}: {tensor}")
+            seen.setdefault(name, set()).add(tensor["dtype"])
+    if set(seen) != set(parameter_names):
+        raise AssertionError(f"Compute probes did not observe every parameter: missing={set(parameter_names) - set(seen)}")
+    training = [event for event in collective_records if event["phase"].startswith("step")
+                and ("_old_mb" in event["phase"] or "_current_mb" in event["phase"])]
+    reductions = [event for event in training if event["collective"] == "reduce_scatter_tensor"]
+    gathers = [event for event in training if event["collective"] == "all_gather_into_tensor"]
+    if world_size > 1 and (not reductions or not gathers):
+        raise AssertionError("No real FSDP training all-gather/reduce-scatter was observed")
+    for event in reductions:
+        if not event["tensors"] or any(tensor["dtype"] != "torch.float32" for tensor in event["tensors"]):
+            raise AssertionError(f"Actual gradient reduction was not FP32: {event}")
+    for event in gathers:
+        if not event["tensors"] or any(tensor["dtype"] != expected for tensor in event["tensors"]):
+            raise AssertionError(f"Actual parameter all-gather differs from compute dtype: {event}")
+    return {"passed": True, "compute_parameters_observed": len(seen), "observed_compute_dtype": expected,
+            "training_all_gather_calls": len(gathers), "training_reduce_scatter_calls": len(reductions),
+            "observed_reduction_dtype": "torch.float32" if reductions else None,
+            "single_rank_has_no_wire_reduction": world_size == 1}
+
+
+def verify_full_state_shards(state, rank_records):
+    """Verify actual gathered/cold-loaded F32 state against all live shard bytes."""
+    if not rank_records or any(set(record) != set(state) for record in rank_records):
+        raise AssertionError("Live/gathered/cold-loaded parameter inventories differ")
+    if len(state) != 25:
+        raise AssertionError("The minimal two-layer actor audit requires all 25 parameters")
+    full_hashes = {}
+    for name, tensor in state.items():
+        if tensor.device.type != "cpu" or tensor.dtype != torch.float32 or not torch.isfinite(tensor).all():
+            raise AssertionError(f"Gathered state is not finite FP32 CPU: {name}")
+        full_hashes[name] = tensor_sha256(tensor)
+        for rank, records in enumerate(rank_records):
+            expected = records[name]
+            actual = coldload_shard(tensor, expected)
+            if str(actual.dtype) != expected["dtype"] or tensor_sha256(actual) != expected["sha256"]:
+                raise AssertionError(f"Live/gathered/cold-loaded bytes differ for rank {rank}, {name}")
+    return {"schema_version": 1, "world_size": len(rank_records), "parameter_count": len(state),
+            "shard_count": len(state) * len(rank_records), "gather_verified": True,
+            "full_parameter_sha256": full_hashes, "rank_shards": rank_records}
+
+
+def verify_cold_loaded_state(state, audit):
+    if audit.get("schema_version") != 1 or not audit.get("gather_verified"):
+        raise AssertionError("Invalid optional precision-audit manifest")
+    measured = verify_full_state_shards(state, audit["rank_shards"])
+    for key in ("world_size", "parameter_count", "shard_count", "full_parameter_sha256"):
+        if measured[key] != audit[key]:
+            raise AssertionError(f"Cold-loaded state differs from live/gathered audit: {key}")
+    return {"verified": True, "parameter_count": measured["parameter_count"],
+            "shard_count": measured["shard_count"], "comparison": "Complete contiguous CPU tensor bytes SHA256"}
+
+
+class ActorPrecisionAudit:
+    def __init__(self, model, optimizer, args, rank, world_size):
+        self.model, self.optimizer = model, optimizer
+        self.rank, self.world_size = rank, world_size
+        self.args = args
+        self.weight_root = Path(args.update_weight_disk_dir)
+        self.temperature = float(args.rollout_temperature)
+        self.old_source = ("external_rollout_log_probs" if getattr(args, "fsdp_external_rollout", False)
+                           else "rollout_payload_log_probs" if args.use_rollout_logprobs
+                           else "current_policy_step_start_snapshot")
+        self.tolerance_path = os.environ.get("SLIME_FSDP2_LOGPROB_TOLERANCE_FILE")
+        self.operators = OperatorProbe() if os.environ.get("SLIME_FSDP2_OPERATOR_AUDIT") == "1" else None
+        self.root = Path(os.environ.get("SLIME_FSDP2_AUDIT_DIR",
+                                       str(Path(args.update_weight_disk_dir).parent / "precision-audit")))
+        self.modules = ModuleProbe(model)
+        self.collectives = CollectiveProbe()
+        self.collective_context = self.collectives.observe()
+        self.collective_context.__enter__()
+        initial = self._synchronized(lambda: {
+            "parameters": parameter_shards(model, require_world_size=world_size),
+            "optimizer": optimizer_records(model, optimizer, initialized=False), "buffers": buffer_records(model)})
+        if len(initial["parameters"]) != 25:
+            raise AssertionError("Precision audit did not cover the complete 25-parameter model")
+        write_json(self.root / f"rank{rank:02d}-initial.json", initial)
+        self.pre_clip = None
+        self.module_start = self.collective_start = 0
+
+    def _synchronized(self, callback):
+        import torch.distributed as dist
+        from slime.utils.distributed_utils import get_gloo_group
+
+        result = {"error": None}
+        try:
+            result["value"] = callback()
+        except Exception as error:
+            result["error"] = f"rank {self.rank}: {type(error).__name__}: {error}"
+        errors = [None] * self.world_size
+        dist.all_gather_object(errors, result["error"], group=get_gloo_group())
+        if any(error for error in errors):
+            raise AssertionError("; ".join(error for error in errors if error))
+        return result["value"]
+
+    def begin_step(self, rollout_id, weight_version):
+        self.pre_clip = None
+        self.module_start = len(self.modules.records)
+        self.collective_start = len(self.collectives.records)
+        self.operator_start = len(self.operators.records) if self.operators is not None else 0
+        self.logprobs = []
+        self.rollout_id, self.weight_version = rollout_id, weight_version
+
+        def identify():
+            manifest = json.loads((self.weight_root / f"weight_v{weight_version:06d}" / "manifest.json").read_text())
+            if manifest["weight_version"] != weight_version or len(manifest["precision_audit"]["full_parameter_sha256"]) != 25:
+                raise AssertionError("The accepted weight identity is missing its complete 25-parameter audit")
+            tolerance = (validate_logprob_tolerance(self.tolerance_path, self.temperature, manifest)
+                         if self.tolerance_path else None)
+            if tolerance is not None and self.old_source != "external_rollout_log_probs":
+                raise AssertionError("An independent inference-LP tolerance requires real external rollout logprobs")
+            return manifest, tolerance
+        self.accepted_manifest, self.tolerance = self._synchronized(identify)
+
+    def phase(self, label):
+        self.modules.phase = self.collectives.phase = label
+        if self.operators is not None:
+            self.operators.phase = label
+
+    @contextmanager
+    def forward_observation(self):
+        if self.operators is None:
+            yield
+        else:
+            with self.operators:
+                yield
+
+    def observe_logprobs(self, current, old, data, indices, microbatch, step):
+        def capture():
+            samples = []
+            for index, actual in zip(indices, current, strict=True):
+                observed = compare_response_logprobs(actual, old[index], data["loss_masks"][index])
+                sample = {"sample_index": data["sample_indices"][index],
+                                "sample_rollout_id": data["rollout_ids"][index],
+                                "rollout_position": data["partition"][index],
+                                "prompt_token_ids": cpu_tensor(torch.as_tensor(data["tokens"][index][:-len(actual)])).tolist(),
+                                "response_token_ids": cpu_tensor(torch.as_tensor(data["tokens"][index][-len(actual):])).tolist(), **observed}
+                sample["case_fingerprint_sha256"] = policy_case_fingerprint(sample)
+                samples.append(sample)
+            record = {"schema_version": 1, "rank": self.rank, "world_size": self.world_size,
+                      "step": step, "microbatch": microbatch, "rollout_id": self.rollout_id,
+                      "global_batch_size": self.args.global_batch_size,
+                      "expected_microbatches": len(data["micro_batch_indices"]),
+                      "accepted_weight_version": self.weight_version,
+                      "version_source": "Actor last completed publication; cross-check manager and rollout receipts",
+                      "accepted_manifest": self.accepted_manifest, "temperature": self.temperature,
+                      "old_logprob_source": self.old_source, "samples": samples,
+                      "numeric_acceptance": "not_evaluated_without_independent_HF_calibration"}
+            if self.tolerance is not None:
+                record["tolerance"] = self.tolerance
+                record["numeric_acceptance"] = "passed" if all(
+                    sample["valid_response_max_abs"] <= self.tolerance["max_abs"] for sample in samples) else "failed"
+                try:
+                    validate_policy_cases(samples, self.tolerance["calibration"])
+                except AssertionError as error:
+                    record["numeric_acceptance"] = "failed"
+                    record["calibrated_case_error"] = str(error)
+            write_json(self.root / f"rank{self.rank:02d}-step{step:02d}-mb{microbatch:02d}-logprobs.json", record)
+            if record["numeric_acceptance"] == "failed":
+                raise AssertionError("Actual training/rollout response logprobs exceed the independent HF tolerance")
+            return record
+        self.logprobs.append(self._synchronized(capture))
+
+    def before_clip(self):
+        import torch.distributed as dist
+        from slime.utils.distributed_utils import get_gloo_group
+
+        local = {"rank": self.rank, "sample_rollout_ids": [sample["sample_rollout_id"]
+                 for record in self.logprobs for sample in record["samples"]],
+                 "valid_tokens": sum(sample["valid_tokens"] for record in self.logprobs for sample in record["samples"]),
+                 "max_abs": max((sample["valid_response_max_abs"] for record in self.logprobs
+                                 for sample in record["samples"]), default=0.0)}
+        all_ranks = [None] * self.world_size
+        dist.all_gather_object(all_ranks, local, group=get_gloo_group())
+        identities = [identity for record in all_ranks for identity in record["sample_rollout_ids"]]
+        if len(identities) != self.args.global_batch_size or len(set(identities)) != len(identities):
+            raise AssertionError("Actual response logprob audit did not cover the complete global batch exactly once")
+        self.logprob_global = {"max_abs": max(record["max_abs"] for record in all_ranks),
+                               "valid_tokens": sum(record["valid_tokens"] for record in all_ranks),
+                               "samples": len(identities), "ranks": all_ranks,
+                               "numeric_acceptance": "passed" if self.tolerance is not None else "not_evaluated_without_independent_HF_calibration"}
+        self.pre_clip = self._synchronized(lambda: gradient_records(self.model))
+
+    def after_step(self, step, metrics):
+        def capture():
+            if self.pre_clip is None:
+                raise AssertionError("The pre-clipping gradient inventory was not captured")
+            parameters = parameter_shards(self.model, require_world_size=self.world_size)
+            for parameter in self.model.parameters():
+                if self.optimizer.state[parameter]["step"].item() != step:
+                    raise AssertionError("Actual Adam step differs from the completed optimizer step")
+            modules = self.modules.records[self.module_start:]
+            communications = self.collectives.records[self.collective_start:]
+            policy = validate_observations(modules, communications, parameters, "bf16", self.world_size)
+            operators = self.operators.records[self.operator_start:] if self.operators is not None else None
+            operator_policy = validate_operator_observations(operators) if operators is not None else None
+            return {"step": step, "rank": self.rank, "world_size": self.world_size,
+                    "metrics": metrics, "parameters": parameters, "gradients_pre_clip": self.pre_clip,
+                    "gradients_post_clip": gradient_records(self.model),
+                    "optimizer": optimizer_records(self.model, self.optimizer, initialized=True),
+                    "buffers": buffer_records(self.model), "observed_policy": policy,
+                    "module_probes": modules, "collective_probes": communications,
+                    "operator_probes": operators, "observed_sensitive_operator_policy": operator_policy,
+                    "global_response_logprob_observations": self.logprob_global,
+                    "response_logprob_microbatches": self.logprobs}
+        record = self._synchronized(capture)
+        write_json(self.root / f"rank{self.rank:02d}-step{step:02d}.json", record)
+
+    def before_publish(self, version):
+        import torch.distributed as dist
+        from slime.utils.distributed_utils import get_gloo_group
+
+        shards = self._synchronized(lambda: parameter_shards(self.model, require_world_size=self.world_size))
+        all_shards = [None] * self.world_size
+        dist.all_gather_object(all_shards, shards, group=get_gloo_group())
+        write_json(self.root / f"rank{self.rank:02d}-weight-v{version:06d}-live-shards.json", shards)
+        return all_shards
+
+
+def reload_sglang_from_disk(url, model_path, weight_version, timeout=600):
+    """Synchronously update the explicitly configured SGLang and verify identity."""
+    from urllib.parse import urlsplit
+    import requests
+
+    address = urlsplit(url)
+    if address.scheme not in ("http", "https") or not address.netloc or address.query or address.fragment:
+        raise ValueError("SLIME_FSDP2_SGLANG_URL must be an HTTP(S) base URL")
+    endpoint = url.rstrip("/")
+    payload = {"model_path": str(Path(model_path).resolve()), "load_format": "safetensors",
+               "weight_version": str(weight_version), "is_async": False, "flush_cache": True,
+               "abort_all_requests": False}
+    with requests.Session() as session:
+        # A directly configured local service must not be sent to a proxy from
+        # an unrelated shell environment. No credentials or cookies are reused.
+        session.trust_env = False
+        response = session.post(endpoint + "/update_weights_from_disk", json=payload, timeout=timeout)
+        response.raise_for_status()
+        update = response.json()
+        if not isinstance(update, dict) or update.get("success") is not True:
+            raise RuntimeError(f"SGLang rejected synchronous weight update: {update}")
+        response = session.get(endpoint + "/model_info", timeout=timeout)
+        response.raise_for_status()
+        identity = response.json()
+        if str(identity.get("weight_version")) != str(weight_version):
+            raise RuntimeError(f"SGLang weight version differs after disk update: {identity}")
+        if Path(identity.get("model_path", "")).resolve() != Path(model_path).resolve():
+            raise RuntimeError(f"SGLang checkpoint path differs after disk update: {identity}")
+    return {"verified": True, "weight_version": str(weight_version), "model_path": payload["model_path"],
+            "update_response": update, "model_info": identity, "sync": True, "cache_flushed": True}
