diff --git a/tests/fsdp2/test_precision_audit.py b/tests/fsdp2/test_precision_audit.py
new file mode 100644
index 00000000..6ef39ea4
--- /dev/null
+++ b/tests/fsdp2/test_precision_audit.py
@@ -0,0 +1,286 @@
+"""CPU byte/HTTP contract checks; real NPU precision remains an execution case."""
+
+import copy
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+from pathlib import Path
+import sys
+import threading
+
+import pytest
+import torch
+from transformers import Qwen3Config, Qwen3ForCausalLM
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from slime.backends.fsdp2_utils.export import verify_exported_model, write_export
+from slime.backends.fsdp2_utils.precision_audit import (reload_sglang_from_disk, tensor_record,
+                                                      verify_cold_loaded_state, verify_full_state_shards)
+
+
+def _tiny_model():
+    torch.manual_seed(19)
+    config = Qwen3Config(vocab_size=32, hidden_size=16, intermediate_size=32,
+                        num_hidden_layers=2, num_attention_heads=2, num_key_value_heads=1, head_dim=8)
+    config._attn_implementation = "eager"
+    return Qwen3ForCausalLM(config).float().eval()
+
+
+def _rank_shards(state):
+    result = []
+    for rank in range(8):
+        records = {}
+        for name, value in state.items():
+            shard = value.chunk(8, dim=0)[rank].contiguous()
+            records[name] = {**tensor_record(shard), "sharded": True, "global_shape": list(value.shape),
+                             "mesh_shape": [1, 8], "mesh_coordinate": [0, rank],
+                             "placements": ["R", "S(0)"],
+                             "placement_specs": [{"kind": "Replicate"}, {"kind": "Shard", "dim": 0}]}
+        result.append(records)
+    return result
+
+
+def test_full_25_by_8_live_gathered_saved_coldloaded_bytes(tmp_path):
+    model = _tiny_model()
+    state = model.state_dict()
+    audit = verify_full_state_shards(state, _rank_shards(state))
+    assert audit["parameter_count"] == 25 and audit["shard_count"] == 200
+    tokens = torch.tensor([[1, 2, 3, 4]])
+    with torch.no_grad():
+        logits = model(input_ids=tokens).logits[0, -1, :16].tolist()
+    probe = {"input_ids": tokens.tolist(), "logits": logits, "forward_dtype": "torch.float32", "atol": 1e-6, "rtol": 1e-6}
+    publication = write_export(model, state, tmp_path, 0, probe, {}, precision_audit=audit)
+    receipt = verify_exported_model(**publication)
+    assert receipt["precision_audit"]["verified"] is True
+    assert receipt["precision_audit"]["parameter_count"] == 25
+    assert receipt["precision_audit"]["shard_count"] == 200
+    manifest = json.loads(Path(publication["manifest_path"]).read_text())
+    assert manifest["schema_version"] == 2 and manifest["precision_audit"] == audit
+
+
+def test_coldload_detects_one_changed_parameter_and_missing_rank_inventory():
+    model = _tiny_model()
+    state = model.state_dict()
+    audit = verify_full_state_shards(state, _rank_shards(state))
+    changed = dict(state)
+    name = next(iter(changed))
+    changed[name] = changed[name].clone()
+    changed[name].reshape(-1)[-1] += 0.01
+    with pytest.raises(AssertionError, match="bytes differ"):
+        verify_cold_loaded_state(changed, audit)
+    bad = copy.deepcopy(audit)
+    del bad["rank_shards"][7][name]
+    with pytest.raises(AssertionError, match="inventories differ"):
+        verify_cold_loaded_state(state, bad)
+    bad = copy.deepcopy(audit)
+    bad["full_parameter_sha256"][name] = "0" * 64
+    with pytest.raises(AssertionError, match="full_parameter_sha256"):
+        verify_cold_loaded_state(state, bad)
+
+
+def test_http_receiver_requires_success_and_explicit_matching_version(tmp_path):
+    requests = []
+    behavior = {"success": True, "version": "0"}
+    model_path = str(tmp_path.resolve())
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *_args):
+            pass
+
+        def do_POST(self):
+            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
+            requests.append((self.path, body))
+            self.send_response(200)
+            self.end_headers()
+            self.wfile.write(json.dumps({"success": behavior["success"], "message": "unit HTTP contract"}).encode())
+
+        def do_GET(self):
+            requests.append((self.path, None))
+            self.send_response(200)
+            self.end_headers()
+            self.wfile.write(json.dumps({"weight_version": behavior["version"], "model_path": model_path}).encode())
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    worker = threading.Thread(target=server.serve_forever, daemon=True)
+    worker.start()
+    url = f"http://127.0.0.1:{server.server_port}"
+    try:
+        receipt = reload_sglang_from_disk(url, model_path, 0, timeout=5)
+        assert receipt["verified"] and receipt["sync"]
+        assert requests[0][0] == "/update_weights_from_disk" and requests[1][0] == "/model_info"
+        assert requests[0][1]["is_async"] is False and requests[0][1]["flush_cache"] is True
+        assert requests[0][1]["weight_version"] == "0"
+        behavior["version"] = "9"
+        with pytest.raises(RuntimeError, match="version differs"):
+            reload_sglang_from_disk(url, model_path, 0, timeout=5)
+        behavior["success"] = False
+        with pytest.raises(RuntimeError, match="rejected"):
+            reload_sglang_from_disk(url, model_path, 0, timeout=5)
+    finally:
+        server.shutdown()
+        server.server_close()
+        worker.join(timeout=5)
+
+
+def test_external_rollout_requires_explicit_custom_function_old_logprobs_and_url(tmp_path):
+    from slime.utils.arguments import get_slime_extra_args_provider
+    from slime.utils.fsdp2_arguments import parse_fsdp2_args
+
+    config = tmp_path / "config.json"
+    config.write_text('{"model_type":"qwen3","num_hidden_layers":2}')
+    common = ["--train-backend", "fsdp2", "--fsdp-random-init", "--fsdp-model-config", str(config),
+              "--rollout-batch-size", "4", "--n-samples-per-prompt", "4", "--num-rollout", "2",
+              "--update-weight-disk-dir", str(tmp_path / "weights")]
+    external = ["--fsdp-external-rollout", "--rollout-function-path", "online_rollout.generate_rollout",
+                "--use-rollout-logprobs", "--train-env-vars", '{"SLIME_FSDP2_SGLANG_URL":"http://127.0.0.1:30000"}']
+    args = parse_fsdp2_args(get_slime_extra_args_provider(), common + external)
+    assert args.fsdp_external_rollout and not args.fsdp_fixed_rollout and args.use_rollout_logprobs
+    assert args.actor_num_gpus_per_node == 8 and args.debug_train_only
+    with pytest.raises(SystemExit):
+        parse_fsdp2_args(get_slime_extra_args_provider(), common + external + ["--fsdp-fixed-rollout"])
+    with pytest.raises(SystemExit):
+        parse_fsdp2_args(get_slime_extra_args_provider(), common + ["--fsdp-external-rollout"])
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+def test_observer_captures_real_linear_embedding_subclasses_and_compute_dtype(dtype):
+    from slime.backends.fsdp2_utils.precision_audit import ModuleProbe, validate_observations
+
+    # Native FSDP dynamically changes leaf classes while retaining their nn
+    # bases. Exercise the same subclass contract without inventing FSDP state.
+    class DerivedEmbedding(torch.nn.Embedding):
+        pass
+
+    class DerivedLinear(torch.nn.Linear):
+        pass
+
+    class Model(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.embed_tokens = DerivedEmbedding(32, 16)
+            self.lm_head = DerivedLinear(16, 32, bias=False)
+
+        def forward(self, tokens):
+            return self.lm_head(self.embed_tokens(tokens))
+
+    model = Model().to(dtype=dtype)
+    probe = ModuleProbe(model)
+    try:
+        actual = model(torch.tensor([[1, 2, 3, 4]]))
+        assert actual.dtype == dtype
+        result = validate_observations(probe.records, [], dict(model.named_parameters()),
+                                       "bf16" if dtype == torch.bfloat16 else "fp32", 1)
+        assert result["compute_parameters_observed"] == 2
+        weights = {event["module"] + "." + name: record
+                   for event in probe.records for name, record in event["parameters"].items()}
+        assert set(weights) == {"embed_tokens.weight", "lm_head.weight"}
+        assert all(record["dtype"] == str(dtype) and record["finite"] for record in weights.values())
+        assert any("DerivedEmbedding" in event["module_type"] for event in probe.records)
+        assert any("DerivedLinear" in event["module_type"] for event in probe.records)
+        with pytest.raises(AssertionError, match="observe every parameter"):
+            validate_observations(probe.records, [], [*weights, "deliberately_missing.weight"],
+                                  "bf16" if dtype == torch.bfloat16 else "fp32", 1)
+    finally:
+        probe.close()
+
+
+def test_sensitive_operator_probe_records_real_fp32_internals_without_changing_forward_or_grad():
+    from slime.backends.fsdp2_utils.loss import response_log_probs
+    from slime.backends.fsdp2_utils.precision_audit import OperatorProbe, validate_operator_observations
+
+    model = _tiny_model().to(dtype=torch.bfloat16)
+    # Mirror the actor: master/resident parameters may be FP32 while compute
+    # is BF16; RoPE's sensitive buffers are deliberately retained in FP32.
+    for module in model.modules():
+        for name, value in list(module.named_buffers(recurse=False)):
+            if value.is_floating_point():
+                setattr(module, name, value.float())
+    tokens = torch.tensor([[1, 2, 3, 4, 5]])
+    baseline = response_log_probs(model(input_ids=tokens, use_cache=False).logits, tokens, [5], [2], .7)[0]
+    baseline.sum().backward()
+    expected_gradients = {name: value.grad.clone() for name, value in model.named_parameters()}
+    model.zero_grad(set_to_none=True)
+    probe = OperatorProbe()
+    with probe:
+        actual = response_log_probs(model(input_ids=tokens, use_cache=False).logits, tokens, [5], [2], .7)[0]
+    actual.sum().backward()
+    assert torch.equal(baseline, actual)
+    assert all(torch.equal(expected_gradients[name], value.grad) for name, value in model.named_parameters())
+    assert validate_operator_observations(probe.records)["passed"] is True
+    with pytest.raises(AssertionError, match="incomplete"):
+        validate_operator_observations([])
+    changed = copy.deepcopy(probe.records)
+    changed[0]["inputs"][0]["dtype"] = "torch.bfloat16"
+    with pytest.raises(AssertionError, match="FP32"):
+        validate_operator_observations(changed)
+
+
+def test_response_logprob_audit_uses_existing_detached_values_and_preserves_mask_and_graph():
+    from slime.backends.fsdp2_utils.precision_audit import compare_response_logprobs
+
+    current = torch.tensor([-2., -3., -4.], requires_grad=True)
+    previous = [-2.01, -3.02, -8.]
+    record = compare_response_logprobs(current, previous, [1, 1, 0])
+    assert record["response_tokens"] == 3 and record["valid_tokens"] == 2
+    assert record["all_response_max_abs"] == 4.
+    assert record["valid_response_max_abs"] < .021
+    assert record["loss_mask"] == [1, 1, 0]
+    current.sum().backward()
+    assert torch.equal(current.grad, torch.ones(3))
+    with pytest.raises(AssertionError, match="shapes"):
+        compare_response_logprobs(current, previous[:1], [1, 1, 0])
+    with pytest.raises(AssertionError, match="finite"):
+        compare_response_logprobs(current, [float('nan'), -3, -4], [1, 1, 0])
+
+
+def test_posthoc_tolerance_requires_actual_checkpoint_identity_and_checks_saved_values(tmp_path):
+    from slime.backends.fsdp2_utils.precision_audit import (compare_response_logprobs,
+        evaluate_saved_policy_logprobs, policy_case_fingerprint, validate_logprob_tolerance)
+
+    manifest = {"weight_version": 0, "files": {"model.safetensors": {"sha256": "a" * 64}},
+                "precision_audit": {"full_parameter_sha256": {"example": "b" * 64}}}
+    value = {"schema_version": 1, "metric": "response_token_logprob_max_abs", "acceptance_ready": True,
+             "temperature": .7, "max_abs": .03, "checkpoint_payload_sha256": {"v0": {"model.safetensors": "a" * 64}}}
+    path = tmp_path / "tolerance.json"
+    path.write_text(json.dumps(value))
+    sample = {"prompt_token_ids": [1, 2], "response_token_ids": [3, 4, 5],
+              **compare_response_logprobs(torch.tensor([-2., -3., -4.]), [-2.01, -3.02, -8.], [1, 1, 0])}
+    value["case_fingerprints_sha256"] = [policy_case_fingerprint(sample)]
+    path.write_text(json.dumps(value))
+    records = [{"rank": 0, "step": 1, "microbatch": 0, "accepted_weight_version": 0,
+                "old_logprob_source": "external_rollout_log_probs", "accepted_manifest": manifest,
+                "temperature": .7, "samples": [{"sample_rollout_id": 0, **sample}],
+                "world_size": 1, "expected_microbatches": 1, "global_batch_size": 1}]
+    result = evaluate_saved_policy_logprobs(records, path, expected_world_size=1, expected_steps=1)
+    assert result["passed"] and result["records"][0]["valid_tokens"] == 2
+    value["max_abs"] = .001
+    path.write_text(json.dumps(value))
+    assert not evaluate_saved_policy_logprobs(records, path, expected_world_size=1, expected_steps=1)["passed"]
+    with pytest.raises(AssertionError, match="temperature"):
+        validate_logprob_tolerance(path, 1., manifest)
+    changed = copy.deepcopy(records)
+    changed[0]["samples"][0]["difference"][0] = 0.
+    with pytest.raises(AssertionError, match="inconsistent"):
+        evaluate_saved_policy_logprobs(changed, path, expected_world_size=1, expected_steps=1)
+    value["checkpoint_payload_sha256"]["v0"]["model.safetensors"] = "c" * 64
+    path.write_text(json.dumps(value))
+    with pytest.raises(AssertionError, match="this accepted checkpoint"):
+        evaluate_saved_policy_logprobs(records, path, expected_world_size=1, expected_steps=1)
+    with pytest.raises(AssertionError, match="No actual"):
+        evaluate_saved_policy_logprobs([], path)
+
+
+    with pytest.raises(AssertionError, match="every expected optimizer step"):
+        evaluate_saved_policy_logprobs(records, path, expected_world_size=1, expected_steps=2)
+    with pytest.raises(AssertionError, match="every actual training rank"):
+        evaluate_saved_policy_logprobs(records, path, expected_world_size=8, expected_steps=1)
+    with pytest.raises(AssertionError, match="missing or duplicate"):
+        evaluate_saved_policy_logprobs(records + records, path, expected_world_size=1, expected_steps=1)
+
+
+    value["checkpoint_payload_sha256"]["v0"]["model.safetensors"] = "a" * 64
+    value["case_fingerprints_sha256"] = ["0" * 64]
+    path.write_text(json.dumps(value))
+    with pytest.raises(AssertionError, match="case was not independently HF calibrated"):
+        evaluate_saved_policy_logprobs(records, path, expected_world_size=1, expected_steps=1)
+    assert policy_case_fingerprint({**sample, "loss_mask": [1., 1., 0.]}) == policy_case_fingerprint(sample)
