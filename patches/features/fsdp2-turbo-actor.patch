@@ -0,0 +1,96 @@
+"""Independent tiny-tensor numerical oracles; no NPU or Ray actor required."""
+
+import importlib.util
+from pathlib import Path
+import sys
+
+import pytest
+import torch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+MODULE = ROOT / "slime/backends/fsdp2_utils/loss.py"
+spec = importlib.util.spec_from_file_location("fsdp2_test_loss", MODULE)
+loss = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(loss)
+
+
+def test_response_shift_excludes_prompt_padding_and_keeps_gradient():
+    torch.manual_seed(9)
+    logits = torch.randn(2, 6, 7, requires_grad=True)
+    tokens = torch.tensor([[1, 2, 3, 4, 5, 6], [6, 5, 4, 3, 0, 0]])
+    values = loss.response_log_probs(logits, tokens, [6, 4], [3, 2], temperature=0.7)
+    oracle = [torch.stack([logits[0, t - 1].float().div(0.7).log_softmax(0)[tokens[0, t]]
+                           for t in (3, 4, 5)]),
+              torch.stack([logits[1, t - 1].float().div(0.7).log_softmax(0)[tokens[1, t]]
+                           for t in (2, 3)])]
+    torch.testing.assert_close(values, oracle)
+    sum(x.sum() for x in values).backward()
+    assert logits.grad[0, :2].count_nonzero() == 0
+    assert logits.grad[1, 3:].count_nonzero() == 0
+    assert logits.grad[0, 2:5].count_nonzero() > 0
+
+
+def _oracle(current, previous, rewards, masks, denoms):
+    answer = current[0].sum() * 0
+    for x, old, advantage, mask, denom in zip(current, previous, rewards, masks, denoms, strict=True):
+        ratio = (x - old).exp()
+        token_loss = -torch.minimum(ratio * advantage, ratio.clamp(0.8, 1.2) * advantage)
+        answer = answer + (token_loss * mask).sum() / max(denom, 1)
+    return answer
+
+
+def test_policy_clip_and_response_mask_match_independent_formula_and_gradient():
+    current = [torch.tensor([-0.2, -1.1, -0.3], requires_grad=True),
+               torch.tensor([-1.4, -0.5], requires_grad=True)]
+    old = [torch.tensor([-0.7, -0.4, -0.3]), torch.tensor([-0.3, -0.7])]
+    masks = [torch.tensor([1., 0., 1.]), torch.tensor([1., 1.])]
+    rewards = [1.3, -0.7]
+    actual, _ = loss.grpo_contribution(current, old, rewards, masks, [2, 2])
+    expected = _oracle(current, old, rewards, masks, [2, 2])
+    torch.testing.assert_close(actual, expected)
+    actual_grads = torch.autograd.grad(actual, current, retain_graph=True)
+    expected_grads = torch.autograd.grad(expected, current)
+    torch.testing.assert_close(actual_grads, expected_grads)
+    assert actual_grads[0][1] == 0
+
+
+def test_eight_rank_avg_and_accumulation_match_single_global_rollout_mean():
+    # Unequal masks and one rollout split across microbatches/ranks expose both
+    # an erroneous token mean and an extra /num_microbatches factor.
+    parameter = torch.tensor(0.1, requires_grad=True)
+    features = [torch.tensor([i / 9, -0.3, 0.7]) for i in range(16)]
+    old = [torch.full((3,), -1.0) for _ in features]
+    rewards = [(-1.) ** i * (i + 1) / 8 for i in range(16)]
+    masks = [torch.tensor([1., i % 2, 1.]) for i in range(16)]
+    # Segments 0 and 8 are one rollout, whose denominator must be the global
+    # sum (4); all other samples correspond to distinct rollouts.
+    denoms = [float(m.sum()) for m in masks]
+    denoms[0] = denoms[8] = float(masks[0].sum() + masks[8].sum())
+    count = 15
+    current = [-1 + parameter * feature for feature in features]
+    global_loss = _oracle(current, old, rewards, masks, denoms) / count
+    global_gradient = torch.autograd.grad(global_loss, parameter)[0]
+    rank_gradients = []
+    for rank in range(8):
+        local = torch.tensor(0.1, requires_grad=True)
+        for i in (rank, rank + 8):
+            contribution, _ = loss.grpo_contribution([-1 + local * features[i]], [old[i]],
+                                                      [rewards[i]], [masks[i]], [denoms[i]])
+            (contribution * loss.backward_scale(8, count)).backward()
+        rank_gradients.append(local.grad)
+    torch.testing.assert_close(torch.stack(rank_gradients).mean(), global_gradient)
+
+
+def test_fully_masked_response_is_zero_with_zero_gradient():
+    current = torch.tensor([-1., -2.], requires_grad=True)
+    result, _ = loss.grpo_contribution([current], [current.detach()], [2.], [torch.zeros(2)], [0.])
+    result.backward()
+    assert result.item() == 0 and current.grad.count_nonzero() == 0
+
+
+def test_reject_bad_denominator_and_shapes():
+    with pytest.raises(ValueError, match="denominator"):
+        loss.grpo_contribution([torch.ones(2)], [torch.ones(2)], [1.], [torch.ones(2)], [1.])
+    with pytest.raises(ValueError, match="shape"):
+        loss.grpo_contribution([torch.ones(2)], [torch.ones(1)], [1.], [torch.ones(2)], [2.])
