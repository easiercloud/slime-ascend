+
+
+def test_atomic_hf_export_coldload_and_tamper_detection(tmp_path):
+    torch.manual_seed(8)
+    config = Qwen3Config(vocab_size=32, hidden_size=16, intermediate_size=24,
+                         num_hidden_layers=1, num_attention_heads=2, num_key_value_heads=1, head_dim=8)
+    config._attn_implementation = "eager"
+    model = Qwen3ForCausalLM(config).float().eval()
+    tokens = torch.tensor([[1, 2, 3, 4]])
+    with torch.no_grad():
+        logits = model(input_ids=tokens).logits[0, -1, :16].tolist()
+    probe = {"input_ids": tokens.tolist(), "logits": logits, "atol": 1e-6, "rtol": 1e-6}
+    published = export.write_export(model, model.state_dict(), tmp_path, 0, probe, {"fixture": "cpu"})
+    result = export.verify_exported_model(**published)
+    assert result["verified"] and result["weight_version"] == 0 and result["probe_max_abs"] < 1e-6
+    root = Path(published["model_path"])
+    assert json.loads((root / "receiver-receipt.json").read_text())["tensor_count"] == len(model.state_dict())
+    assert not list(tmp_path.glob(".weight-writing-*"))
+    with pytest.raises(FileExistsError):
+        export.write_export(model, model.state_dict(), tmp_path, 0, probe, {})
+    with pytest.raises(ValueError, match="version"):
+        export.verify_exported_model(published["model_path"], published["manifest_path"], 1)
+    tensor_file = next(root.glob("*.safetensors"))
+    with tensor_file.open("ab") as stream:
+        stream.write(b"corrupt")
+    with pytest.raises(ValueError, match="checksum"):
+        export.verify_exported_model(**published)
