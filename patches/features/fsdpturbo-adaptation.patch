+@pytest.mark.parametrize("estimator", ["grpo", "gspo", "cispo"])
+def test_masked_policy_objectives_match_independent_values_and_gradients(estimator):
+    new = [torch.tensor([-0.1, -0.8, -1.4], requires_grad=True), torch.tensor([-1.2, -0.1], requires_grad=True)]
+    old = [torch.tensor([-0.5, -5.0, -1.55], requires_grad=True), torch.tensor([-1.0, -0.3], requires_grad=True)]
+    masks = [torch.tensor([1., 0., 1.]), torch.tensor([1., 1.])]
+    rewards = [1.3, -0.7]
+    data = {"loss_masks": masks, "rewards": rewards, "rollout_mask_sums": [2, 2]}
+    loss, metrics = microbatch_loss(args(estimator), data, [0, 1], new, old)
+
+    expected_loss = loss.new_zeros(())
+    expected_clip = loss.new_zeros(())
+    expected_kl = loss.new_zeros(())
+    for current, previous, mask, reward in zip(new, old, masks, rewards, strict=True):
+        delta = current - previous.detach()
+        if estimator == "gspo":
+            delta = delta[mask.bool()].mean().expand_as(current)
+        ratio = delta.exp()
+        bound = ratio.clamp(0.8, 1.3)
+        if estimator == "cispo":
+            token_loss = -bound.detach() * reward * current
+            clipped = ratio != bound
+        else:
+            token_loss = -torch.minimum(ratio * reward, bound * reward)
+            clipped = bound * reward < ratio * reward
+        expected_loss += (token_loss * mask).sum() / 2
+        expected_clip += (clipped * mask).sum() / 2
+        expected_kl += (-delta.detach() * mask).sum() / 2
+    torch.testing.assert_close(loss, expected_loss)
+    torch.testing.assert_close(metrics, torch.stack((expected_loss.detach(), expected_clip, expected_kl)))
+    loss.backward()
+    for current, expected in zip(new, torch.autograd.grad(expected_loss, new), strict=True):
+        torch.testing.assert_close(current.grad, expected)
+    assert all(previous.grad is None for previous in old)
+    assert new[0].grad[1] == 0  # Masked token affects neither loss nor GSPO's sequence ratio.
+    if estimator == "cispo":
+        assert new[0].grad[0] != 0  # A clipped CISPO ratio still contributes a policy gradient.
