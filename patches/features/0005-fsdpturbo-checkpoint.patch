diff --git a/slime/backends/fsdp_utils/checkpoint.py b/slime/backends/fsdp_utils/checkpoint.py
new file mode 100644
index 00000000..08857af6
--- /dev/null
+++ b/slime/backends/fsdp_utils/checkpoint.py
@@ -0,0 +1,214 @@
+"""Synchronous, same-topology training checkpoints, separate from HF publication."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import random
+import tempfile
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.distributed as dist
+import torch.distributed.checkpoint as dcp
+from torch.distributed.checkpoint.state_dict import get_state_dict, set_state_dict
+from torch.distributed.fsdp import FSDPModule
+
+from slime.utils import accelerator
+from slime.utils.distributed_utils import get_gloo_group
+
+
+FORMAT = "slime-fsdpturbo-training-v1"
+POLICY_FIELDS = ("lr", "fsdp_adam_beta1", "fsdp_adam_beta2", "fsdp_adam_eps",
+                 "fsdp_weight_decay", "clip_grad", "rollout_temperature", "eps_clip",
+                 "eps_clip_high", "eps_clip_c", "global_batch_size", "micro_batch_size",
+                 "use_rollout_logprobs")
+
+
+def collective_action(action):
+    """Agree on local validation/I/O failures before entering another collective."""
+    result, error = None, None
+    try:
+        result = action()
+    except Exception as exc:
+        error = f"{type(exc).__name__}: {exc}"
+    errors = [None] * dist.get_world_size()
+    dist.all_gather_object(errors, error, group=get_gloo_group())
+    if any(errors):
+        raise RuntimeError(f"FSDP checkpoint operation failed: {errors}")
+    return result
+
+
+def root_action(action):
+    result = collective_action(lambda: action() if dist.get_rank() == 0 else None)
+    values = [result]
+    dist.broadcast_object_list(values, src=0, group=get_gloo_group())
+    return values[0]
+
+
+def capture_rng():
+    # Store NumPy using tensors/primitives so weights_only=True remains possible.
+    name, keys, position, has_gauss, cached = np.random.get_state()
+    backend = getattr(torch, accelerator.device_type())
+    return {"python": random.getstate(), "numpy": (name, torch.from_numpy(keys.astype(np.int64)), position, has_gauss, cached),
+            "torch": torch.get_rng_state(), "device": backend.get_rng_state(accelerator.current_device()).cpu()}
+
+
+def restore_rng(state):
+    random.setstate(state["python"])
+    name, keys, position, has_gauss, cached = state["numpy"]
+    np.random.set_state((name, keys.numpy().astype(np.uint32), position, has_gauss, cached))
+    torch.set_rng_state(state["torch"])
+    getattr(torch, accelerator.device_type()).set_rng_state(state["device"], accelerator.current_device())
+
+
+def signature(trainer):
+    config = trainer.model.config.to_dict()
+    for key in ("_name_or_path", "transformers_version"):
+        config.pop(key, None)
+    value = {"world_size": dist.get_world_size(), "parallelism": {"fsdp": dist.get_world_size(), "dp": 1, "tp": 1, "cp": 1},
+            "model_config": config, "policy": {key: getattr(trainer.args, key) for key in POLICY_FIELDS},
+            "scheduler": "constant", "master_dtype": "float32", "compute_dtype": "bfloat16",
+            "runtime": {name: importlib.metadata.version(name) for name in ("torch", "torch-npu", "transformers")}}
+    # HF configs can contain integer dictionary keys (id2label) and tuples.
+    # Compare the same JSON representation before and after persistence.
+    return json.loads(json.dumps(value, sort_keys=True))
+
+
+def file_record(path):
+    with path.open("rb") as stream:
+        return {"size": path.stat().st_size, "sha256": hashlib.file_digest(stream, "sha256").hexdigest()}
+
+
+def validate_manifest(directory, expected):
+    """Fail closed, including on incomplete writes, incompatible jobs or corruption."""
+    directory = Path(directory)
+    if directory.name.startswith("."):
+        raise ValueError("Incomplete temporary checkpoint cannot be loaded")
+    value = json.loads((directory / "COMMITTED.json").read_text())
+    if value.get("format") != FORMAT or value.get("signature") != expected:
+        raise ValueError("Checkpoint format, topology, model, runtime or training configuration mismatch")
+    for key in ("rollout_id", "next_rollout_id", "optimizer_steps", "weight_version"):
+        if type(value.get(key)) is not int or value[key] < 0:
+            raise ValueError(f"Invalid checkpoint progress: {key}")
+    if value["next_rollout_id"] != value["rollout_id"] + 1 or value["optimizer_steps"] == 0:
+        raise ValueError("Invalid checkpoint training boundary")
+    required = {"state/.metadata", *(f"rng-rank-{rank}.pt" for rank in range(expected["world_size"]))}
+    records = value.get("files", {})
+    if not required.issubset(records) or not any(name.endswith(".distcp") for name in records):
+        raise ValueError("Incomplete checkpoint manifest")
+    for name, record in records.items():
+        path = directory / name
+        if Path(name).is_absolute() or ".." in Path(name).parts or path.is_symlink() or not path.resolve().is_relative_to(directory.resolve()):
+            raise ValueError("Invalid checkpoint payload path")
+        if file_record(path) != record:
+            raise ValueError(f"Checkpoint payload corrupted: {name}")
+    return value
+
+
+class TrainingState:
+    def __init__(self, trainer):
+        self.trainer = trainer
+
+    def state_dict(self):
+        model, optim = get_state_dict(self.trainer.model, self.trainer.optimizer)
+        return {"model": model, "optimizer": optim}
+
+    def load_state_dict(self, state):
+        set_state_dict(self.trainer.model, self.trainer.optimizer,
+                       model_state_dict=state["model"], optim_state_dict=state["optimizer"])
+
+
+def reshard(trainer):
+    for module in trainer.model.modules():
+        if isinstance(module, FSDPModule):
+            module.reshard()
+
+
+def save(trainer, directory, rollout_id, weight_version):
+    def boundary():
+        if trainer.last_rollout_id != rollout_id or trainer.optimizer_steps <= 0:
+            raise ValueError("Save requires a completed training rollout boundary")
+        return {"format": FORMAT, "signature": signature(trainer), "rollout_id": rollout_id,
+                "next_rollout_id": rollout_id + 1, "optimizer_steps": trainer.optimizer_steps,
+                "weight_version": weight_version, "scope": "trainer only; no rollout source or serving state"}
+
+    metadata = collective_action(boundary)
+    boundaries = [None] * dist.get_world_size()
+    dist.all_gather_object(boundaries, metadata, group=get_gloo_group())
+    if any(value != metadata for value in boundaries):
+        raise ValueError("Training ranks disagree on checkpoint boundary")
+    reshard(trainer)
+    destination = Path(directory) / f"iter_{rollout_id:07d}"
+
+    def prepare():
+        if destination.exists():
+            raise FileExistsError(f"Refusing to replace checkpoint: {destination}")
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        return tempfile.mkdtemp(prefix=f".{destination.name}-", dir=destination.parent)
+
+    temporary = Path(root_action(prepare))
+    rng = collective_action(capture_rng)
+    # Failed saves intentionally retain a hidden diagnostic directory; no commit
+    # marker or latest pointer is published and it cannot be used for restoration.
+    dcp.save({"training": TrainingState(trainer)}, checkpoint_id=str(temporary / "state"))
+    collective_action(lambda: torch.save(rng, temporary / f"rng-rank-{dist.get_rank()}.pt"))
+
+    def commit():
+        files = [p for p in temporary.rglob("*") if p.is_file()]
+        metadata["files"] = {str(p.relative_to(temporary)): file_record(p) for p in files}
+        (temporary / "COMMITTED.json").write_text(json.dumps(metadata, indent=2) + "\n")
+        for path in [*files, temporary / "COMMITTED.json"]:
+            with path.open("rb") as stream:
+                os.fsync(stream.fileno())
+        for path in (temporary / "state", temporary):
+            fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+        temporary.rename(destination)
+        fd = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        return {"path": str(destination), "rollout_id": rollout_id,
+                "optimizer_steps": trainer.optimizer_steps, "weight_version": weight_version}
+
+    report = root_action(commit)
+    collective_action(lambda: restore_rng(rng))
+    return report
+
+
+def load(trainer, directory):
+    # Hash validation happens on rank zero before any DCP model collectives.
+    metadata = root_action(lambda: validate_manifest(directory, signature(trainer)))
+    collective_action(lambda: _validate_signature(metadata, signature(trainer)))
+    rng = collective_action(lambda: torch.load(Path(directory) / f"rng-rank-{dist.get_rank()}.pt",
+                                              map_location="cpu", weights_only=True))
+    dcp.load({"training": TrainingState(trainer)}, checkpoint_id=str(Path(directory) / "state"))
+    trainer.optimizer_steps = metadata["optimizer_steps"]
+    trainer.last_rollout_id = metadata["rollout_id"]
+    collective_action(lambda: _validate_optimizer(trainer))
+    collective_action(lambda: restore_rng(rng))
+    return metadata
+
+
+def _validate_signature(metadata, expected):
+    if metadata["signature"] != expected:
+        raise ValueError("Training ranks disagree on checkpoint configuration")
+
+
+def _validate_optimizer(trainer):
+    params = list(trainer.model.parameters())
+    if len(trainer.optimizer.state) != len(params):
+        raise ValueError("Incomplete optimizer state")
+    for parameter in params:
+        state = trainer.optimizer.state[parameter]
+        if int(state["step"].item()) != trainer.optimizer_steps:
+            raise ValueError("Optimizer step differs from checkpoint progress")
+        for key in ("exp_avg", "exp_avg_sq"):
+            if state[key].shape != parameter.shape or state[key].dtype != torch.float32:
+                raise ValueError("Invalid AdamW moment shape/dtype")
diff --git a/slime/backends/fsdp_utils/checkpoint_check.py b/slime/backends/fsdp_utils/checkpoint_check.py
new file mode 100644
index 00000000..af8c6c09
--- /dev/null
+++ b/slime/backends/fsdp_utils/checkpoint_check.py
@@ -0,0 +1,122 @@
+"""Acceptance through real Slime actors: continuous versus recreated trainers."""
+
+import hashlib
+import json
+import os
+import random
+from pathlib import Path
+
+import numpy as np
+import ray
+import torch
+from ray.util.placement_group import remove_placement_group
+
+from slime.utils import accelerator
+
+
+def tensor_digest(value):
+    if hasattr(value, "to_local"):
+        value = value.to_local()
+    value = value.detach().cpu().contiguous()
+    return hashlib.sha256(value.reshape(-1).view(torch.uint8).numpy().tobytes()).hexdigest()
+
+
+def state_probe(trainer, weight_version):
+    from .checkpoint import capture_rng, reshard, restore_rng
+
+    reshard(trainer)
+    state = capture_rng()
+    # The probe samples each RNG stream without changing subsequent training.
+    try:
+        random_sample = {"python": [random.random() for _ in range(4)],
+                         "numpy": np.random.random(4).tolist(), "torch": torch.rand(4).tolist(),
+                         "device": torch.rand(4, device=accelerator.device()).cpu().tolist()}
+    finally:
+        restore_rng(state)
+    model, optimizer = {}, {}
+    for name, value in trainer.model.named_parameters():
+        model[name] = tensor_digest(value)
+        optimizer[name] = {key: tensor_digest(item) if isinstance(item, torch.Tensor) else item
+                           for key, item in trainer.optimizer.state[value].items()}
+    return {"pid": os.getpid(), "model": model, "optimizer": optimizer, "rng_samples": random_sample,
+            "optimizer_steps": trainer.optimizer_steps, "last_rollout_id": trainer.last_rollout_id,
+            "weight_version": weight_version}
+
+
+def equal_state(left, right):
+    checks = {key: left[key] == right[key] for key in
+              ("model", "optimizer", "rng_samples", "optimizer_steps", "last_rollout_id", "weight_version")}
+    if not all(checks.values()):
+        raise AssertionError(f"Restored training state is not identical: {checks}")
+    return checks
+
+
+def run_checkpoint_check(args):
+    from slime.data.batch_builder import BatchBuilder
+    from slime.ray.placement_group import allocate_train_group, create_placement_groups
+    from .grpo_fixture import fixed_samples
+
+    placements = group = None
+    result = {"passed": False, "scope": "same-topology trainer continuation; fixed rollouts, no live serving or data cursor"}
+    report = Path(args.fsdp_init_report)
+    report.parent.mkdir(parents=True, exist_ok=True)
+    original_load = args.fsdp_checkpoint_load
+    try:
+        placements = create_placement_groups(args)
+        group = allocate_train_group(args, args.actor_num_nodes, args.actor_num_gpus_per_node, placements["actor"])
+        # Exercise nonzero version restoration independently of a live server.
+        group._disk_weight_version = 7
+        starts = group.create()
+        if len(set(starts)) != 1:
+            raise AssertionError("Ranks restored different rollout progress")
+        start = starts[0]
+        result["initial_start_rollout_id"] = start
+        result["runtime"] = ray.get([actor.check_runtime.remote() for actor in group._actor_handlers], timeout=120)
+        assert all(not item["forbidden_imports"] and not item["imports_before_provider"] for item in result["runtime"])
+        builder = BatchBuilder(args)
+        builder.train_parallel_config = {"dp_size": 2, "cp_size": 1, "vpp_size": 1,
+                                         "microbatch_group_size_per_vp_stage": 1}
+        refs = builder.split_by_dp(builder.convert(fixed_samples()))
+        call = lambda method: ray.get([getattr(actor, method).remote() for actor in group._actor_handlers], timeout=1200)
+        result["first_training"] = ray.get(group.async_train(start, refs), timeout=1200)
+        before_save = call("checkpoint_probe")
+        group.save_model(start, force_sync=True)
+        saved = call("checkpoint_probe")
+        result["save_preserves_state"] = [equal_state(a, b) for a, b in zip(before_save, saved, strict=True)]
+        result["continuous_training"] = ray.get(group.async_train(start + 1, refs), timeout=1200)
+        continuous = call("checkpoint_probe")
+        call("shutdown")
+        group.release()
+        group.args.fsdp_checkpoint_load = Path(args.fsdp_checkpoint_save) / f"iter_{start:07d}"
+        group._disk_weight_version = 0
+        starts = group.create()
+        assert starts == [start + 1] * 2
+        restored = call("checkpoint_probe")
+        result["restore_equal"] = [equal_state(a, b) for a, b in zip(saved, restored, strict=True)]
+        assert all(a["pid"] != b["pid"] for a, b in zip(saved, restored, strict=True)), "Actors must be recreated"
+        result["resumed_training"] = ray.get(group.async_train(start + 1, refs), timeout=1200)
+        resumed = call("checkpoint_probe")
+        result["continuation_equal"] = [equal_state(a, b) for a, b in zip(continuous, resumed, strict=True)]
+        assert result["continuous_training"] == result["resumed_training"], "Training metrics differ after restore"
+        # Exercise a second checkpoint after continuation, preserving the earlier one.
+        group.save_model(start + 1, force_sync=True)
+        result.update(saved=saved, restored=restored, continuous=continuous, resumed=resumed,
+                      checkpoint=str(group.args.fsdp_checkpoint_load), next_rollout_id=start + 1,
+                      recreated_actors=True, metrics_exact=True, tolerance=0, passed=True)
+        result["shutdown"] = call("shutdown")
+        print("FSDP_CHECKPOINT_CHECK_PASSED", json.dumps({key: value for key, value in result.items()
+              if key not in {"saved", "restored", "continuous", "resumed"}}), flush=True)
+    except Exception as exc:
+        result["error"] = f"{type(exc).__name__}: {exc}"
+        raise
+    finally:
+        report.write_text(json.dumps(result, indent=2) + "\n")
+        args.fsdp_checkpoint_load = original_load
+        if group is not None:
+            group.release()
+        if placements is not None:
+            seen = set()
+            for value in placements.values():
+                if value is not None and value[0] is not None and value[0].id not in seen:
+                    remove_placement_group(value[0])
+                    seen.add(value[0].id)
