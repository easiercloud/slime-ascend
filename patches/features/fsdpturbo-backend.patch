@@ -0,0 +1,40 @@
+"""Test masking and global-token normalization independently of FSDPTurbo."""
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from slime.backends.fsdp_utils.model import causal_loss_sum, globally_normalized_loss, load_qwen3
+
+
+def test_variable_length_gradients_match_global_token_mean():
+    torch.manual_seed(9)
+    logits = torch.randn(2, 5, 11, requires_grad=True)
+    tokens = torch.tensor([[1, 2, 3, 0, 0], [4, 5, 6, 7, 8]])
+    mask = torch.tensor([[1, 1, 1, 0, 0], [1, 1, 1, 1, 1]])
+    loss0, count0 = causal_loss_sum(logits[:1], tokens[:1], mask[:1])
+    loss1, count1 = causal_loss_sum(logits[1:], tokens[1:], mask[1:])
+    assert (count0.item(), count1.item()) == (2, 4)
+    distributed_mean = (globally_normalized_loss(loss0, 6, 2) + globally_normalized_loss(loss1, 6, 2)) / 2
+    expected = F.cross_entropy(torch.cat((logits[0, :2], logits[1, :4])), torch.tensor([2, 3, 5, 6, 7, 8]))
+    torch.testing.assert_close(distributed_mean, expected)
+    actual_grad = torch.autograd.grad(distributed_mean, logits, retain_graph=True)[0]
+    expected_grad = torch.autograd.grad(expected, logits)[0]
+    torch.testing.assert_close(actual_grad, expected_grad)
+    assert torch.count_nonzero(actual_grad[0, 2:]) == 0
+
+
+def test_empty_batch_is_rejected():
+    with pytest.raises(ValueError, match="at least one"):
+        globally_normalized_loss(torch.tensor(0.0), 0, 2)
+
+
+def test_loading_requires_local_checkpoint(tmp_path):
+    with pytest.raises(ValueError, match="local"):
+        load_qwen3(tmp_path, torch.float32)
+
+
+def test_loading_rejects_unvalidated_architecture(tmp_path):
+    (tmp_path / "config.json").write_text('{"model_type": "llama"}')
+    with pytest.raises(ValueError, match="dense qwen3 only"):
+        load_qwen3(tmp_path, torch.float32)
