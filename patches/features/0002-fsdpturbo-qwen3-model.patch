diff --git a/slime/backends/fsdp_utils/model.py b/slime/backends/fsdp_utils/model.py
new file mode 100644
index 00000000..ceae7c3f
--- /dev/null
+++ b/slime/backends/fsdp_utils/model.py
@@ -0,0 +1,74 @@
+"""Conservative Qwen3 model loading and native FSDP2 through FSDPTurbo.
+
+Provider and Transformers imports stay lazy to preserve the serving interpreter.
+This module owns no rollout, checkpoint export or GRPO policy.
+"""
+
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+
+def load_qwen3(checkpoint, dtype):
+    from transformers import AutoConfig, AutoModelForCausalLM
+
+    checkpoint = Path(checkpoint)
+    if not (checkpoint / "config.json").is_file():
+        raise ValueError("Expected a local Hugging Face checkpoint with config.json")
+    config = AutoConfig.from_pretrained(checkpoint, local_files_only=True, trust_remote_code=False)
+    if config.model_type != "qwen3":
+        raise ValueError(f"This model milestone supports dense qwen3 only, got {config.model_type}")
+    if config.attention_dropout != 0:
+        raise ValueError("Deterministic model validation requires attention_dropout=0")
+    config.use_cache = False
+    model, info = AutoModelForCausalLM.from_pretrained(
+        checkpoint, config=config, dtype=dtype, attn_implementation="eager",
+        local_files_only=True, trust_remote_code=False, output_loading_info=True,
+    )
+    for key in ("missing_keys", "unexpected_keys", "mismatched_keys", "error_msgs"):
+        if info.get(key):
+            raise ValueError(f"Incomplete checkpoint loading: {key}={info[key]}")
+    if any(t.is_meta for t in (*model.parameters(), *model.buffers())):
+        raise ValueError("Checkpoint loading left meta tensors")
+    if config.tie_word_embeddings and model.model.embed_tokens.weight is not model.lm_head.weight:
+        raise ValueError("Checkpoint loading did not preserve tied embeddings")
+    return model.train()
+
+
+def wrap_qwen3(model, world_size):
+    from fsdp_turbo.fsdp_turbo import FSDPTurbo
+    from fsdp_turbo.fsdp_turbo_config import DistributedConfig, FSDPPlanConfig, FSDPTurboConfig
+
+    # Decoder layers are separate units; tied embedding/head belong to root.
+    config = FSDPTurboConfig(distributed=DistributedConfig(
+        data_parallel_size=1, fully_shard_parallel_size=world_size,
+        tensor_parallel_size=1, expert_parallel_size=1,
+        fsdp_plan=FSDPPlanConfig(
+            apply_modules={"model.layers.{*}": {}}, fsdp_implementation="native",
+            param_dtype="bf16", reduce_dtype="fp32", cpu_offload=False,
+            num_to_forward_prefetch=0, num_to_backward_prefetch=0,
+        ),
+    ))
+    return FSDPTurbo(config, model)
+
+
+def causal_loss_sum(logits, input_ids, attention_mask):
+    """Sum next-token CE over valid adjacent tokens; padding contributes zero."""
+    valid = attention_mask[:, 1:].bool() & attention_mask[:, :-1].bool()
+    labels = input_ids[:, 1:].masked_fill(~valid, -100)
+    return F.cross_entropy(logits[:, :-1].float().reshape(-1, logits.size(-1)),
+                           labels.reshape(-1), ignore_index=-100, reduction="sum"), valid.sum()
+
+
+def globally_normalized_loss(loss_sum, global_tokens, world_size):
+    """Compensate FSDP's mean gradient reduction for variable token counts."""
+    if global_tokens <= 0:
+        raise ValueError("A training batch must contain at least one valid next-token target")
+    return loss_sum * (world_size / global_tokens)
+
+
+def make_check_optimizer(parameters):
+    """Fixed acceptance-test optimizer; production optimizer policy is future work."""
+    return torch.optim.AdamW(parameters, lr=1e-4, betas=(0.9, 0.999), eps=1e-6,
+                             weight_decay=0.01, foreach=False)
diff --git a/slime/backends/fsdp_utils/model_check.py b/slime/backends/fsdp_utils/model_check.py
new file mode 100644
index 00000000..4b37fc49
--- /dev/null
+++ b/slime/backends/fsdp_utils/model_check.py
@@ -0,0 +1,183 @@
+"""Two-rank numerical oracle, deliberately independent of rollout/GRPO.
+
+The reference is an unsharded BF16 HF model on each rank. Its gradients are
+explicitly averaged in FP32, then CPU FP32 AdamW supplies the update oracle.
+All comparisons cover every unique parameter, including the tied embedding.
+"""
+
+import gc
+import math
+
+import torch
+import torch.distributed as dist
+from torch.distributed.tensor import DTensor
+from torch.distributed.fsdp import FSDPModule
+
+from slime.utils import accelerator
+from .model import (causal_loss_sum, globally_normalized_loss, load_qwen3,
+                    make_check_optimizer, wrap_qwen3)
+
+
+class Comparison:
+    def __init__(self):
+        self.error2 = self.reference2 = self.actual2 = self.dot = 0.0
+        self.max_abs = 0.0
+
+    def add(self, actual, reference):
+        actual, reference = actual.detach().float().cpu(), reference.detach().float().cpu()
+        if not torch.isfinite(actual).all() or not torch.isfinite(reference).all():
+            raise ValueError("Nonfinite values in numerical validation")
+        error = actual - reference
+        self.error2 += error.square().sum(dtype=torch.float64).item()
+        self.reference2 += reference.square().sum(dtype=torch.float64).item()
+        self.actual2 += actual.square().sum(dtype=torch.float64).item()
+        self.dot += (actual * reference).sum(dtype=torch.float64).item()
+        self.max_abs = max(self.max_abs, error.abs().max().item())
+
+    def report(self):
+        return {"relative_l2": math.sqrt(self.error2 / max(self.reference2, 1e-30)),
+                "max_abs": self.max_abs,
+                "cosine": max(-1.0, min(1.0, self.dot / max(math.sqrt(self.actual2 * self.reference2), 1e-30))),
+                "reference_norm": math.sqrt(self.reference2), "actual_norm": math.sqrt(self.actual2)}
+
+
+def fixed_batch(rank, device):
+    # Reproducible in-vocabulary IDs, distinct samples and unequal valid lengths.
+    length = (23, 32)[rank]
+    ids = ((torch.arange(32, device=device) * 37 + 100 + rank * 53) % 10000).unsqueeze(0)
+    mask = (torch.arange(32, device=device) < length).unsqueeze(0)
+    ids = ids.masked_fill(~mask, 0)
+    return ids, mask.long()
+
+
+def check_model(args):
+    from fsdp_turbo.utils.device import set_accelerator_compatible
+
+    set_accelerator_compatible()
+    rank, world = dist.get_rank(), dist.get_world_size()
+    if world != 2:
+        raise ValueError("The fixed model oracle requires two ranks")
+    torch.manual_seed(1234)
+    device = torch.device(accelerator.device_type(), accelerator.current_device())
+    ids, mask = fixed_batch(rank, device)
+    count = (mask[:, 1:] * mask[:, :-1]).sum()
+    dist.all_reduce(count)
+    total_tokens = int(count.item())
+    print(f"[model-check rank={rank}] loading unsharded reference", flush=True)
+    reference = load_qwen3(args.hf_checkpoint, torch.bfloat16).to(device)
+    ref_logits = reference(input_ids=ids, attention_mask=mask, use_cache=False).logits
+    ref_sum, _ = causal_loss_sum(ref_logits, ids, mask)
+    globally_normalized_loss(ref_sum, total_tokens, world).backward()
+    ref_loss = ref_sum.detach().clone()
+    dist.all_reduce(ref_loss)
+    ref_loss = float(ref_loss.item() / total_tokens)
+    ref_logits = ref_logits.detach().cpu()
+    reference_grads = {}
+    for name, parameter in reference.named_parameters():
+        if parameter.grad is None:
+            raise ValueError(f"Reference parameter has no gradient: {name}")
+        grad = parameter.grad.float()
+        dist.all_reduce(grad)
+        grad.div_(world)
+        reference_grads[name] = grad.cpu()
+        parameter.grad = None
+    reference.to(device="cpu", dtype=torch.float32)
+    initial = {name: parameter.detach().clone() for name, parameter in reference.named_parameters()}
+    for name, parameter in reference.named_parameters():
+        parameter.grad = reference_grads[name]
+    # FP64 accumulation keeps the CPU oracle accurate for the large embedding.
+    ref_norm = math.sqrt(sum(grad.square().sum(dtype=torch.float64).item()
+                             for grad in reference_grads.values()))
+    if not math.isfinite(ref_norm) or ref_norm <= 0:
+        raise ValueError("Reference gradients must have a finite positive norm")
+    ref_scale = min(1.0, 1.0 / (ref_norm + 1e-6))
+    for parameter in reference.parameters():
+        parameter.grad.mul_(ref_scale)
+    ref_optimizer = make_check_optimizer(reference.parameters())
+    ref_optimizer.step()
+    del ref_optimizer
+    gc.collect()
+    print(f"[model-check rank={rank}] loading FP32 master weights and wrapping FSDP", flush=True)
+    model = load_qwen3(args.hf_checkpoint, torch.float32)
+    turbo = wrap_qwen3(model, world)
+    parameters = dict(model.named_parameters())
+    if set(parameters) != set(initial):
+        raise ValueError("Wrapping changed unique parameter names")
+    global_numel = sum(p.numel() for p in parameters.values())
+    if not all(isinstance(p, DTensor) for p in parameters.values()):
+        raise ValueError("Expected all parameters to be DTensors")
+    local_numel = sum(p.to_local().numel() for p in parameters.values())
+    units = sum(isinstance(module, FSDPModule) for module in model.modules())
+    tied = model.model.embed_tokens.weight is model.lm_head.weight
+    initial_comparison = Comparison()
+    for name, parameter in parameters.items():
+        initial_comparison.add(parameter.full_tensor(), initial[name])
+    optimizer = make_check_optimizer(model.parameters())
+    print(f"[model-check rank={rank}] FSDP forward/backward", flush=True)
+    logits = turbo(input_ids=ids, attention_mask=mask, use_cache=False).logits
+    loss_sum, _ = causal_loss_sum(logits, ids, mask)
+    globally_normalized_loss(loss_sum, total_tokens, world).backward()
+    loss = loss_sum.detach().clone()
+    dist.all_reduce(loss)
+    loss = float(loss.item() / total_tokens)
+    logits_comparison = Comparison()
+    logits_comparison.add(logits.detach().cpu()[mask.cpu().bool()], ref_logits[mask.cpu().bool()])
+    norm2 = torch.zeros((), device=device)
+    for parameter in parameters.values():
+        if parameter.grad is None:
+            raise ValueError("FSDP parameter has no gradient")
+        norm2 += parameter.grad.to_local().float().square().sum()
+    dist.all_reduce(norm2)
+    grad_norm = norm2.sqrt().item()
+    scale = min(1.0, 1.0 / (grad_norm + 1e-6))
+    gradient_comparison = Comparison()
+    raw_gradient_comparison = Comparison()
+    for name, parameter in parameters.items():
+        raw_gradient_comparison.add(parameter.grad.full_tensor(), reference_grads[name] / ref_scale)
+        parameter.grad.mul_(scale)
+        gradient_comparison.add(parameter.grad.full_tensor(), reference_grads[name])
+    print(f"[model-check rank={rank}] AdamW and full update comparison", flush=True)
+    optimizer.step()
+    optimizer_sharded = all(
+        isinstance(state[key], DTensor) and state[key].to_local().shape == parameter.to_local().shape
+        for parameter, state in optimizer.state.items() for key in ("exp_avg", "exp_avg_sq")
+    )
+    delta_comparison = Comparison()
+    ref_parameters = dict(reference.named_parameters())
+    for name, parameter in parameters.items():
+        delta_comparison.add(parameter.full_tensor().detach().cpu() - initial[name],
+                             ref_parameters[name].detach() - initial[name])
+    metrics = {"initial_weights": initial_comparison.report(), "logits": logits_comparison.report(),
+               "raw_gradients": raw_gradient_comparison.report(),
+               "clipped_gradients": gradient_comparison.report(), "update_delta": delta_comparison.report()}
+    # Fixed BF16 acceptance limits, chosen before hardware execution. Comparing
+    # delta (not final weights) prevents tiny learning rates from hiding errors.
+    limits = {"logits_relative_l2": 0.02, "gradient_relative_l2": 0.03,
+              "gradient_cosine_min": 0.999, "update_relative_l2": 0.10,
+              "loss_relative": 0.01, "grad_norm_relative": 0.03}
+    checks = {
+        "initial_exact": metrics["initial_weights"]["max_abs"] == 0,
+        "half_parameter_storage": local_numel * world == global_numel,
+        "decoder_and_root_units": units == model.config.num_hidden_layers + 1,
+        "tied_embeddings": not model.config.tie_word_embeddings or tied,
+        "fp32_master_and_gradients": all(p.dtype == p.grad.dtype == torch.float32 for p in parameters.values()),
+        "optimizer_states_sharded": optimizer_sharded and len(optimizer.state) == len(parameters),
+        "logits": metrics["logits"]["relative_l2"] <= limits["logits_relative_l2"],
+        "loss": abs(loss-ref_loss) / max(abs(ref_loss), 1e-12) <= limits["loss_relative"],
+        "gradients": metrics["clipped_gradients"]["relative_l2"] <= limits["gradient_relative_l2"],
+        "raw_gradients": metrics["raw_gradients"]["relative_l2"] <= limits["gradient_relative_l2"],
+        "gradient_direction": metrics["clipped_gradients"]["cosine"] >= limits["gradient_cosine_min"],
+        "grad_norm": 0 < grad_norm and abs(grad_norm-ref_norm) / max(ref_norm, 1e-12) <= limits["grad_norm_relative"],
+        "update": 0 < metrics["update_delta"]["actual_norm"] and metrics["update_delta"]["relative_l2"] <= limits["update_relative_l2"],
+    }
+    result = {"passed": all(checks.values()), "rank": rank, "checks": checks, "metrics": metrics,
+              "limits": limits, "loss": loss, "reference_loss": ref_loss, "grad_norm": grad_norm,
+              "reference_grad_norm": ref_norm, "clip_scale": scale, "reference_clip_scale": ref_scale,
+              "global_tokens": total_tokens, "global_parameter_numel": global_numel,
+              "local_parameter_numel": local_numel, "fsdp_units": units, "checkpoint": args.hf_checkpoint,
+              "optimizer": {"lr": 1e-4, "betas": [0.9, 0.999], "eps": 1e-6, "weight_decay": 0.01, "clip_grad": 1.0},
+              "precision": {"master": "fp32", "compute": "bf16", "reduce": "fp32"}}
+    print(f"[model-check rank={rank}] result={result}", flush=True)
+    del parameters, optimizer, turbo, model, reference, reference_grads, initial
+    gc.collect()
+    return result
