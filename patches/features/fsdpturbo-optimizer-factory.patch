index 0000000000000000000000000000000000000000..ccc07fae1b9e2943a61dd8e2d0db3bbb3e818f29
--- /dev/null
+++ b/slime/backends/fsdp_utils/optimizer.py
@@ -0,0 +1,62 @@
+"""Adapt Slime optimizer configuration and named groups to Turbo's factory."""
+
+import json
+
+
+def optimizer_config(args):
+    """Resolve optimizer selection and extension hooks from Slime arguments."""
+    kwargs = getattr(args, "fsdp_optimizer_kwargs", None)
+    return {
+        "type": getattr(args, "fsdp_optimizer_type", "AdamW"),
+        "kwargs": {} if kwargs is None else kwargs,
+        "param_groups": getattr(args, "fsdp_optimizer_param_groups", None),
+        "provider": getattr(args, "fsdp_optimizer_provider", None),
+    }
+
+
+def parameter_groups(model, args):
+    """Materialize each trainable parameter exactly once in Slime-owned groups."""
+    from slime.utils.misc import load_function
+
+    provider = getattr(args, "fsdp_optimizer_param_groups", None)
+    groups = load_function(provider)(model, args) if provider else [{
+        "params": [parameter for parameter in model.parameters() if parameter.requires_grad],
+    }]
+    result, supplied = [], []
+    for group in groups:
+        group = dict(group)
+        group["params"] = list(group["params"])
+        group.setdefault("weight_decay", args.fsdp_weight_decay)
+        if group["params"]:
+            result.append(group)
+            supplied.extend(id(parameter) for parameter in group["params"])
+    expected = {id(parameter) for parameter in model.parameters() if parameter.requires_grad}
+    if not expected or set(supplied) != expected or len(supplied) != len(expected):
+        raise ValueError("Optimizer groups must contain each trainable model parameter exactly once")
+    return result
+
+
+def make_optimizer(model, args):
+    from fsdp_turbo.training.factories.optimizer_factory import OptimizerFactory
+    from slime.utils.misc import load_function
+
+    config = optimizer_config(args)
+    kwargs = {"lr": args.lr}
+    if config["provider"] is None and config["type"] in ("Adam", "AdamW"):
+        kwargs.update(betas=(args.fsdp_adam_beta1, args.fsdp_adam_beta2),
+                      eps=args.fsdp_adam_eps, foreach=False)
+    kwargs.update(config["kwargs"])
+    provider = load_function(config["provider"]) if config["provider"] else None
+    return OptimizerFactory.create(config["type"], parameter_groups(model, args), custom_fn=provider, **kwargs)
+
+
+def optimizer_signature(model, optimizer):
+    """Describe actual group membership and settings without optimizer-specific state keys."""
+    names = {id(parameter): name for name, parameter in model.named_parameters()}
+    groups = []
+    for group in optimizer.param_groups:
+        settings = {key: value for key, value in group.items() if key != "params"}
+        settings["params"] = [names[id(parameter)] for parameter in group["params"]]
+        groups.append(settings)
+    value = {"class": f"{type(optimizer).__module__}.{type(optimizer).__qualname__}", "groups": groups}
+    return json.loads(json.dumps(value, sort_keys=True))
