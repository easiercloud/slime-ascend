diff --git a/slime/backends/fsdp_utils/checkpoint.py b/slime/backends/fsdp_utils/checkpoint.py
new file mode 100644
index 00000000..08857af6
--- /dev/null
+++ b/slime/backends/fsdp_utils/checkpoint.py
@@ -0,0 +1,214 @@
+"""Synchronous, same-topology training checkpoints, separate from HF publication."""
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import random
+import tempfile
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.distributed as dist
+import torch.distributed.checkpoint as dcp
+from torch.distributed.checkpoint.state_dict import get_state_dict, set_state_dict
+from torch.distributed.fsdp import FSDPModule
+
+from slime.utils import accelerator
+from slime.utils.distributed_utils import get_gloo_group
+
+
+FORMAT = "slime-fsdpturbo-training-v1"
+POLICY_FIELDS = ("lr", "fsdp_adam_beta1", "fsdp_adam_beta2", "fsdp_adam_eps",
+                 "fsdp_weight_decay", "clip_grad", "rollout_temperature", "eps_clip",
+                 "eps_clip_high", "eps_clip_c", "global_batch_size", "micro_batch_size",
+                 "use_rollout_logprobs")
+
+
+def collective_action(action):
+    """Agree on local validation/I/O failures before entering another collective."""
+    result, error = None, None
+    try:
+        result = action()
+    except Exception as exc:
+        error = f"{type(exc).__name__}: {exc}"
+    errors = [None] * dist.get_world_size()
+    dist.all_gather_object(errors, error, group=get_gloo_group())
+    if any(errors):
+        raise RuntimeError(f"FSDP checkpoint operation failed: {errors}")
+    return result
+
+
+def root_action(action):
+    result = collective_action(lambda: action() if dist.get_rank() == 0 else None)
+    values = [result]
+    dist.broadcast_object_list(values, src=0, group=get_gloo_group())
+    return values[0]
+
+
+def capture_rng():
+    # Store NumPy using tensors/primitives so weights_only=True remains possible.
+    name, keys, position, has_gauss, cached = np.random.get_state()
+    backend = getattr(torch, accelerator.device_type())
+    return {"python": random.getstate(), "numpy": (name, torch.from_numpy(keys.astype(np.int64)), position, has_gauss, cached),
+            "torch": torch.get_rng_state(), "device": backend.get_rng_state(accelerator.current_device()).cpu()}
+
+
+def restore_rng(state):
+    random.setstate(state["python"])
+    name, keys, position, has_gauss, cached = state["numpy"]
+    np.random.set_state((name, keys.numpy().astype(np.uint32), position, has_gauss, cached))
+    torch.set_rng_state(state["torch"])
+    getattr(torch, accelerator.device_type()).set_rng_state(state["device"], accelerator.current_device())
+
+
+def signature(trainer):
+    config = trainer.model.config.to_dict()
+    for key in ("_name_or_path", "transformers_version"):
+        config.pop(key, None)
+    value = {"world_size": dist.get_world_size(), "parallelism": {"fsdp": dist.get_world_size(), "dp": 1, "tp": 1, "cp": 1},
+            "model_config": config, "policy": {key: getattr(trainer.args, key) for key in POLICY_FIELDS},
+            "scheduler": "constant", "master_dtype": "float32", "compute_dtype": "bfloat16",
+            "runtime": {name: importlib.metadata.version(name) for name in ("torch", "torch-npu", "transformers")}}
+    # HF configs can contain integer dictionary keys (id2label) and tuples.
+    # Compare the same JSON representation before and after persistence.
+    return json.loads(json.dumps(value, sort_keys=True))
+
+
+def file_record(path):
+    with path.open("rb") as stream:
+        return {"size": path.stat().st_size, "sha256": hashlib.file_digest(stream, "sha256").hexdigest()}
+
+
+def validate_manifest(directory, expected):
+    """Fail closed, including on incomplete writes, incompatible jobs or corruption."""
+    directory = Path(directory)
+    if directory.name.startswith("."):
+        raise ValueError("Incomplete temporary checkpoint cannot be loaded")
+    value = json.loads((directory / "COMMITTED.json").read_text())
+    if value.get("format") != FORMAT or value.get("signature") != expected:
+        raise ValueError("Checkpoint format, topology, model, runtime or training configuration mismatch")
+    for key in ("rollout_id", "next_rollout_id", "optimizer_steps", "weight_version"):
+        if type(value.get(key)) is not int or value[key] < 0:
+            raise ValueError(f"Invalid checkpoint progress: {key}")
+    if value["next_rollout_id"] != value["rollout_id"] + 1 or value["optimizer_steps"] == 0:
+        raise ValueError("Invalid checkpoint training boundary")
+    required = {"state/.metadata", *(f"rng-rank-{rank}.pt" for rank in range(expected["world_size"]))}
+    records = value.get("files", {})
+    if not required.issubset(records) or not any(name.endswith(".distcp") for name in records):
+        raise ValueError("Incomplete checkpoint manifest")
+    for name, record in records.items():
+        path = directory / name
+        if Path(name).is_absolute() or ".." in Path(name).parts or path.is_symlink() or not path.resolve().is_relative_to(directory.resolve()):
+            raise ValueError("Invalid checkpoint payload path")
+        if file_record(path) != record:
+            raise ValueError(f"Checkpoint payload corrupted: {name}")
+    return value
+
+
+class TrainingState:
+    def __init__(self, trainer):
+        self.trainer = trainer
+
+    def state_dict(self):
+        model, optim = get_state_dict(self.trainer.model, self.trainer.optimizer)
+        return {"model": model, "optimizer": optim}
+
+    def load_state_dict(self, state):
+        set_state_dict(self.trainer.model, self.trainer.optimizer,
+                       model_state_dict=state["model"], optim_state_dict=state["optimizer"])
+
+
+def reshard(trainer):
+    for module in trainer.model.modules():
+        if isinstance(module, FSDPModule):
+            module.reshard()
+
+
+def save(trainer, directory, rollout_id, weight_version):
+    def boundary():
+        if trainer.last_rollout_id != rollout_id or trainer.optimizer_steps <= 0:
+            raise ValueError("Save requires a completed training rollout boundary")
+        return {"format": FORMAT, "signature": signature(trainer), "rollout_id": rollout_id,
+                "next_rollout_id": rollout_id + 1, "optimizer_steps": trainer.optimizer_steps,
+                "weight_version": weight_version, "scope": "trainer only; no rollout source or serving state"}
+
+    metadata = collective_action(boundary)
+    boundaries = [None] * dist.get_world_size()
+    dist.all_gather_object(boundaries, metadata, group=get_gloo_group())
+    if any(value != metadata for value in boundaries):
+        raise ValueError("Training ranks disagree on checkpoint boundary")
+    reshard(trainer)
+    destination = Path(directory) / f"iter_{rollout_id:07d}"
+
+    def prepare():
+        if destination.exists():
+            raise FileExistsError(f"Refusing to replace checkpoint: {destination}")
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        return tempfile.mkdtemp(prefix=f".{destination.name}-", dir=destination.parent)
+
+    temporary = Path(root_action(prepare))
+    rng = collective_action(capture_rng)
+    # Failed saves intentionally retain a hidden diagnostic directory; no commit
+    # marker or latest pointer is published and it cannot be used for restoration.
+    dcp.save({"training": TrainingState(trainer)}, checkpoint_id=str(temporary / "state"))
+    collective_action(lambda: torch.save(rng, temporary / f"rng-rank-{dist.get_rank()}.pt"))
+
+    def commit():
+        files = [p for p in temporary.rglob("*") if p.is_file()]
+        metadata["files"] = {str(p.relative_to(temporary)): file_record(p) for p in files}
+        (temporary / "COMMITTED.json").write_text(json.dumps(metadata, indent=2) + "\n")
+        for path in [*files, temporary / "COMMITTED.json"]:
+            with path.open("rb") as stream:
+                os.fsync(stream.fileno())
+        for path in (temporary / "state", temporary):
+            fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+        temporary.rename(destination)
+        fd = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        return {"path": str(destination), "rollout_id": rollout_id,
+                "optimizer_steps": trainer.optimizer_steps, "weight_version": weight_version}
+
+    report = root_action(commit)
+    collective_action(lambda: restore_rng(rng))
+    return report
+
+
+def load(trainer, directory):
+    # Hash validation happens on rank zero before any DCP model collectives.
+    metadata = root_action(lambda: validate_manifest(directory, signature(trainer)))
+    collective_action(lambda: _validate_signature(metadata, signature(trainer)))
+    rng = collective_action(lambda: torch.load(Path(directory) / f"rng-rank-{dist.get_rank()}.pt",
+                                              map_location="cpu", weights_only=True))
+    dcp.load({"training": TrainingState(trainer)}, checkpoint_id=str(Path(directory) / "state"))
+    trainer.optimizer_steps = metadata["optimizer_steps"]
+    trainer.last_rollout_id = metadata["rollout_id"]
+    collective_action(lambda: _validate_optimizer(trainer))
+    collective_action(lambda: restore_rng(rng))
+    return metadata
+
+
+def _validate_signature(metadata, expected):
+    if metadata["signature"] != expected:
+        raise ValueError("Training ranks disagree on checkpoint configuration")
+
+
+def _validate_optimizer(trainer):
+    params = list(trainer.model.parameters())
+    if len(trainer.optimizer.state) != len(params):
+        raise ValueError("Incomplete optimizer state")
+    for parameter in params:
+        state = trainer.optimizer.state[parameter]
+        if int(state["step"].item()) != trainer.optimizer_steps:
+            raise ValueError("Optimizer step differs from checkpoint progress")
+        for key in ("exp_avg", "exp_avg_sq"):
+            if state[key].shape != parameter.shape or state[key].dtype != torch.float32:
+                raise ValueError("Invalid AdamW moment shape/dtype")
diff --git a/slime/backends/fsdp_utils/checkpoint_check.py b/slime/backends/fsdp_utils/checkpoint_check.py
new file mode 100644
index 00000000..af8c6c09
--- /dev/null
+++ b/slime/backends/fsdp_utils/checkpoint_check.py
@@ -0,0 +1,122 @@
+"""Acceptance through real Slime actors: continuous versus recreated trainers."""
+
+import hashlib
+import json
+import os
+import random
+from pathlib import Path
+
+import numpy as np
+import ray
+import torch
+from ray.util.placement_group import remove_placement_group
+
+from slime.utils import accelerator
+
+
+def tensor_digest(value):
+    if hasattr(value, "to_local"):
+        value = value.to_local()
+    value = value.detach().cpu().contiguous()
+    return hashlib.sha256(value.reshape(-1).view(torch.uint8).numpy().tobytes()).hexdigest()
+
+
+def state_probe(trainer, weight_version):
+    from .checkpoint import capture_rng, reshard, restore_rng
+
+    reshard(trainer)
+    state = capture_rng()
+    # The probe samples each RNG stream without changing subsequent training.
+    try:
+        random_sample = {"python": [random.random() for _ in range(4)],
+                         "numpy": np.random.random(4).tolist(), "torch": torch.rand(4).tolist(),
+                         "device": torch.rand(4, device=accelerator.device()).cpu().tolist()}
+    finally:
+        restore_rng(state)
+    model, optimizer = {}, {}
+    for name, value in trainer.model.named_parameters():
+        model[name] = tensor_digest(value)
+        optimizer[name] = {key: tensor_digest(item) if isinstance(item, torch.Tensor) else item
+                           for key, item in trainer.optimizer.state[value].items()}
+    return {"pid": os.getpid(), "model": model, "optimizer": optimizer, "rng_samples": random_sample,
+            "optimizer_steps": trainer.optimizer_steps, "last_rollout_id": trainer.last_rollout_id,
+            "weight_version": weight_version}
+
+
+def equal_state(left, right):
+    checks = {key: left[key] == right[key] for key in
+              ("model", "optimizer", "rng_samples", "optimizer_steps", "last_rollout_id", "weight_version")}
+    if not all(checks.values()):
+        raise AssertionError(f"Restored training state is not identical: {checks}")
+    return checks
+
+
+def run_checkpoint_check(args):
+    from slime.data.batch_builder import BatchBuilder
+    from slime.ray.placement_group import allocate_train_group, create_placement_groups
+    from .grpo_fixture import fixed_samples
+
+    placements = group = None
+    result = {"passed": False, "scope": "same-topology trainer continuation; fixed rollouts, no live serving or data cursor"}
+    report = Path(args.fsdp_init_report)
+    report.parent.mkdir(parents=True, exist_ok=True)
+    original_load = args.fsdp_checkpoint_load
+    try:
+        placements = create_placement_groups(args)
+        group = allocate_train_group(args, args.actor_num_nodes, args.actor_num_gpus_per_node, placements["actor"])
+        # Exercise nonzero version restoration independently of a live server.
+        group._disk_weight_version = 7
+        starts = group.create()
+        if len(set(starts)) != 1:
+            raise AssertionError("Ranks restored different rollout progress")
+        start = starts[0]
+        result["initial_start_rollout_id"] = start
+        result["runtime"] = ray.get([actor.check_runtime.remote() for actor in group._actor_handlers], timeout=120)
+        assert all(not item["forbidden_imports"] and not item["imports_before_provider"] for item in result["runtime"])
+        builder = BatchBuilder(args)
+        builder.train_parallel_config = {"dp_size": 2, "cp_size": 1, "vpp_size": 1,
+                                         "microbatch_group_size_per_vp_stage": 1}
+        refs = builder.split_by_dp(builder.convert(fixed_samples()))
+        call = lambda method: ray.get([getattr(actor, method).remote() for actor in group._actor_handlers], timeout=1200)
+        result["first_training"] = ray.get(group.async_train(start, refs), timeout=1200)
+        before_save = call("checkpoint_probe")
+        group.save_model(start, force_sync=True)
+        saved = call("checkpoint_probe")
+        result["save_preserves_state"] = [equal_state(a, b) for a, b in zip(before_save, saved, strict=True)]
+        result["continuous_training"] = ray.get(group.async_train(start + 1, refs), timeout=1200)
+        continuous = call("checkpoint_probe")
+        call("shutdown")
+        group.release()
+        group.args.fsdp_checkpoint_load = Path(args.fsdp_checkpoint_save) / f"iter_{start:07d}"
+        group._disk_weight_version = 0
+        starts = group.create()
+        assert starts == [start + 1] * 2
+        restored = call("checkpoint_probe")
+        result["restore_equal"] = [equal_state(a, b) for a, b in zip(saved, restored, strict=True)]
+        assert all(a["pid"] != b["pid"] for a, b in zip(saved, restored, strict=True)), "Actors must be recreated"
+        result["resumed_training"] = ray.get(group.async_train(start + 1, refs), timeout=1200)
+        resumed = call("checkpoint_probe")
+        result["continuation_equal"] = [equal_state(a, b) for a, b in zip(continuous, resumed, strict=True)]
+        assert result["continuous_training"] == result["resumed_training"], "Training metrics differ after restore"
+        # Exercise a second checkpoint after continuation, preserving the earlier one.
+        group.save_model(start + 1, force_sync=True)
+        result.update(saved=saved, restored=restored, continuous=continuous, resumed=resumed,
+                      checkpoint=str(group.args.fsdp_checkpoint_load), next_rollout_id=start + 1,
+                      recreated_actors=True, metrics_exact=True, tolerance=0, passed=True)
+        result["shutdown"] = call("shutdown")
+        print("FSDP_CHECKPOINT_CHECK_PASSED", json.dumps({key: value for key, value in result.items()
+              if key not in {"saved", "restored", "continuous", "resumed"}}), flush=True)
+    except Exception as exc:
+        result["error"] = f"{type(exc).__name__}: {exc}"
+        raise
+    finally:
+        report.write_text(json.dumps(result, indent=2) + "\n")
+        args.fsdp_checkpoint_load = original_load
+        if group is not None:
+            group.release()
+        if placements is not None:
+            seen = set()
+            for value in placements.values():
+                if value is not None and value[0] is not None and value[0].id not in seen:
+                    remove_placement_group(value[0])
+                    seen.add(value[0].id)
diff --git a/slime/backends/fsdp_utils/grpo.py b/slime/backends/fsdp_utils/grpo.py
new file mode 100644
index 00000000..a78ede7f
--- /dev/null
+++ b/slime/backends/fsdp_utils/grpo.py
@@ -0,0 +1,115 @@
+"""Dense, padded GRPO primitives independent of Megatron and FSDPTurbo imports."""
+
+import math
+
+import torch
+import torch.nn.functional as F
+
+
+def validate_batch(data, vocab_size):
+    """Validate BatchBuilder's DP-local view before distributed model execution."""
+    required = ("tokens", "response_lengths", "total_lengths", "loss_masks", "rewards",
+                "rollout_ids", "rollout_mask_sums", "partition", "micro_batch_indices",
+                "num_microbatches", "global_batch_sizes")
+    for key in required:
+        if key not in data:
+            raise ValueError(f"Missing rollout field: {key}")
+    n = len(data["tokens"])
+    if not n:
+        raise ValueError("Every training rank must receive samples")
+    for key in required[:8]:
+        if len(data[key]) != n:
+            raise ValueError(f"Unaligned rollout field: {key}")
+    for key in ("multimodal_train_inputs", "teacher_log_probs", "rollout_routed_experts",
+                "rollout_top_p_token_ids", "rollout_top_p_token_offsets"):
+        if key in data:
+            raise ValueError(f"Unsupported GRPO payload: {key}")
+    for i in range(n):
+        tokens, mask = torch.as_tensor(data["tokens"][i]), torch.as_tensor(data["loss_masks"][i])
+        length, response = data["total_lengths"][i], data["response_lengths"][i]
+        if not isinstance(length, int) or not isinstance(response, int):
+            raise ValueError("Sequence and response lengths must be integers")
+        if not isinstance(data["rollout_ids"][i], int) or not isinstance(data["partition"][i], int):
+            raise ValueError("Rollout IDs and partition indices must be integers")
+        if tokens.ndim != 1 or tokens.dtype not in (torch.int32, torch.int64):
+            raise ValueError("Tokens must be one-dimensional integer arrays")
+        if len(tokens) != length or not 0 <= response < length:
+            raise ValueError("Response length must leave at least one prompt token")
+        if int(tokens.min()) < 0 or int(tokens.max()) >= vocab_size:
+            raise ValueError("Token ID outside model vocabulary")
+        if mask.ndim != 1 or mask.numel() != response or not torch.all((mask == 0) | (mask == 1)):
+            raise ValueError("Loss masks must be binary and response-aligned")
+        if not math.isfinite(float(data["rewards"][i])):
+            raise ValueError("Rewards must be finite")
+        denominator = float(data["rollout_mask_sums"][i])
+        if not math.isfinite(denominator) or denominator < mask.sum().item():
+            raise ValueError("Invalid whole-rollout loss-mask denominator")
+    if "rollout_log_probs" in data:
+        if len(data["rollout_log_probs"]) != n:
+            raise ValueError("Unaligned rollout log probabilities")
+        for old, length in zip(data["rollout_log_probs"], data["response_lengths"], strict=True):
+            old = torch.as_tensor(old)
+            if old.ndim != 1 or old.numel() != length or not torch.isfinite(old).all():
+                raise ValueError("Rollout log probabilities must be finite and response-aligned")
+    counts, sizes = data["num_microbatches"], data["global_batch_sizes"]
+    if not counts or len(counts) != len(sizes) or any(not isinstance(x, int) or x <= 0 for x in [*counts, *sizes]):
+        raise ValueError("Invalid optimizer-step schedule")
+    microbatches = data["micro_batch_indices"]
+    if len(microbatches) != sum(counts) or any(not mb for mb in microbatches):
+        raise ValueError("Invalid microbatch schedule")
+    flat = [i for mb in microbatches for i in mb]
+    if any(not isinstance(i, int) for i in flat) or sorted(flat) != list(range(n)):
+        raise ValueError("Microbatch schedule must consume each local sample exactly once")
+    if len(data["partition"]) != n or len(set(data["partition"])) != n:
+        raise ValueError("Invalid global sample partition")
+
+
+def collate(data, indices, device):
+    """Right-pad independent sequences; use attention masks for HF eager attention."""
+    lengths = [data["total_lengths"][i] for i in indices]
+    ids = torch.zeros((len(indices), max(lengths)), dtype=torch.long, device=device)
+    attention = torch.zeros_like(ids)
+    for row, (i, length) in enumerate(zip(indices, lengths, strict=True)):
+        ids[row, :length] = torch.as_tensor(data["tokens"][i], device=device, dtype=torch.long)
+        attention[row, :length] = 1
+    return {"input_ids": ids, "attention_mask": attention, "use_cache": False}
+
+
+def response_log_probs(logits, input_ids, lengths, response_lengths, temperature):
+    """The first response target is predicted at prompt_length-1, including EOS."""
+    result = []
+    for row, (length, response) in enumerate(zip(lengths, response_lengths, strict=True)):
+        prompt = length - response
+        rows = logits[row, prompt - 1:length - 1].float() / temperature
+        targets = input_ids[row, prompt:length]
+        result.append(-F.cross_entropy(rows, targets, reduction="none"))
+    return result
+
+
+def clipped_policy_loss(new, old, advantage, clip_low, clip_high, dual_clip=None):
+    """Eager PPO clip objective, matching slime.utils.ppo_utils without torch.compile."""
+    ratio = (new - old.detach()).exp()
+    advantage = torch.as_tensor(advantage, dtype=new.dtype, device=new.device).detach()
+    unclipped = -ratio * advantage
+    clipped = -ratio.clamp(1 - clip_low, 1 + clip_high) * advantage
+    loss = torch.maximum(unclipped, clipped)
+    if dual_clip is not None:
+        loss = torch.where(advantage < 0, torch.minimum(loss, -dual_clip * advantage), loss)
+    return loss, (clipped > unclipped).float(), old.detach() - new
+
+
+def microbatch_loss(args, data, indices, new_log_probs, old_log_probs):
+    """Sum each segment's share of its rollout mean; caller scales for DP/step."""
+    loss = sum(log_probs.sum() * 0 for log_probs in new_log_probs)
+    metrics = loss.detach().new_zeros(3)
+    for i, new in zip(indices, new_log_probs, strict=True):
+        old = old_log_probs[i].to(device=new.device, dtype=torch.float32)
+        values, clipped, kl = clipped_policy_loss(new, old, data["rewards"][i], args.eps_clip,
+                                                 args.eps_clip_high, args.eps_clip_c)
+        mask = torch.as_tensor(data["loss_masks"][i], device=new.device, dtype=torch.float32)
+        denominator = max(float(data["rollout_mask_sums"][i]), 1.0)
+        term = (values * mask).sum() / denominator
+        loss = loss + term
+        metrics += torch.stack((term.detach(), (clipped * mask).sum() / denominator,
+                                (kl.detach() * mask).sum() / denominator))
+    return loss, metrics
diff --git a/slime/backends/fsdp_utils/grpo_check.py b/slime/backends/fsdp_utils/grpo_check.py
new file mode 100644
index 00000000..040bdecf
--- /dev/null
+++ b/slime/backends/fsdp_utils/grpo_check.py
@@ -0,0 +1,167 @@
+"""Independent, stepwise unsharded GRPO oracle on identical input weights.
+
+Each step starts from the actor's FP32 weights. Reference AdamW moments and
+original old logprobs are retained independently. This isolates backend math
+from BF16 boundary crossings due to preceding optimizer rounding differences.
+It is NOT an independent multi-step trajectory-equivalence test.
+"""
+
+import math
+
+import torch
+import torch.distributed as dist
+from torch.distributed.tensor import DTensor
+
+from slime.utils import accelerator
+from .model import load_qwen3
+from .model_check import Comparison
+
+
+def reference_forward(model, data, indices, temperature, device):
+    lengths = [len(data["tokens"][i]) for i in indices]
+    ids = torch.zeros(len(indices), max(lengths), dtype=torch.long, device=device)
+    mask = torch.zeros_like(ids)
+    for row, (i, length) in enumerate(zip(indices, lengths, strict=True)):
+        ids[row, :length] = torch.as_tensor(data["tokens"][i], device=device)
+        mask[row, :length] = 1
+    logits = model(input_ids=ids, attention_mask=mask, use_cache=False).logits
+    result = []
+    for row, i in enumerate(indices):
+        end, response = lengths[row], data["response_lengths"][i]
+        start = end - response
+        distribution = (logits[row, start - 1:end - 1].float() / temperature).log_softmax(-1)
+        result.append(distribution.gather(-1, ids[row, start:end, None]).squeeze(-1))
+    return result
+
+
+class GRPOOracle:
+    def __init__(self, args, data):
+        from fsdp_turbo.utils.device import set_accelerator_compatible
+
+        set_accelerator_compatible()
+        self.args, self.data = args, data
+        self.rank, self.world = dist.get_rank(), dist.get_world_size()
+        self.device = torch.device(accelerator.device_type(), accelerator.current_device())
+        print(f"[grpo-check rank={self.rank}] independent unsharded reference", flush=True)
+        self.reference = load_qwen3(args.hf_checkpoint, torch.bfloat16).to(self.device)
+        self.master = load_qwen3(args.hf_checkpoint, torch.float32).to(self.device)
+        self.optimizer = torch.optim.AdamW(self.master.parameters(), lr=args.lr,
+                                          betas=(args.fsdp_adam_beta1, args.fsdp_adam_beta2),
+                                          eps=args.fsdp_adam_eps, weight_decay=args.fsdp_weight_decay, foreach=False)
+        self.old = [None] * len(data["tokens"])
+        with torch.no_grad():
+            for indices in data["micro_batch_indices"]:
+                for i, lp in zip(indices, reference_forward(self.reference, data, indices, args.rollout_temperature, self.device), strict=True):
+                    self.old[i] = lp.cpu().clone()
+        self.expected, self.comparisons, self.steps = [], [], []
+        self.old_comparison, self.initial_comparison = Comparison(), Comparison()
+        self.fp32_grads = True
+        self.previous = {}
+
+    def check_old(self, actual):
+        for a, b in zip(actual, self.old, strict=True):
+            self.old_comparison.add(a, b)
+
+    def prepare_step(self, step, model):
+        args, data, device = self.args, self.data, self.device
+        parameters = dict(self.master.named_parameters())
+        compute = dict(self.reference.named_parameters())
+        print(f"[grpo-check rank={self.rank}] independent reference step {step + 1}", flush=True)
+        with torch.no_grad():
+            for name, p in model.named_parameters():
+                actual = p.full_tensor().detach()
+                if step == 0:
+                    self.initial_comparison.add(actual, parameters[name])
+                self.previous[name] = actual.cpu()
+                parameters[name].copy_(actual)
+                compute[name].copy_(actual.to(torch.bfloat16))
+        # Never copy actor optimizer state: the reference retains its own moments.
+        grads = {name: torch.zeros_like(p, device="cpu") for name, p in parameters.items()}
+        log_probs = {}
+        metrics = torch.zeros(3, device=device)
+        offset = sum(data["num_microbatches"][:step])
+        count, global_size = data["num_microbatches"][step], data["global_batch_sizes"][step]
+        for indices in data["micro_batch_indices"][offset:offset + count]:
+            self.reference.zero_grad(set_to_none=True)
+            values = reference_forward(self.reference, data, indices, args.rollout_temperature, device)
+            loss = sum(lp.sum() * 0 for lp in values)
+            for i, lp in zip(indices, values, strict=True):
+                log_probs[i] = lp.detach().cpu()
+                old = self.old[i].to(device)
+                ratio = torch.exp(lp - old)
+                advantage = float(data["rewards"][i])
+                bounded = torch.clamp(ratio, 1 - args.eps_clip, 1 + args.eps_clip_high)
+                objective = torch.minimum(ratio * advantage, bounded * advantage)
+                if args.eps_clip_c is not None and advantage < 0:
+                    objective = torch.maximum(objective, objective.new_tensor(args.eps_clip_c * advantage))
+                mask = torch.as_tensor(data["loss_masks"][i], device=device)
+                divisor = max(float(data["rollout_mask_sums"][i]), 1.0)
+                term = -(objective * mask).sum() / divisor
+                loss = loss + term
+                metrics += torch.stack((term.detach(),
+                                        (((bounded * advantage) < (ratio * advantage)).float() * mask).sum() / divisor,
+                                        ((old - lp.detach()) * mask).sum() / divisor))
+            (loss * self.world / global_size).backward()
+            for name, p in self.reference.named_parameters():
+                grad = p.grad.float()
+                dist.all_reduce(grad)
+                grads[name].add_(grad.cpu(), alpha=1 / self.world)
+                p.grad = None
+        dist.all_reduce(metrics)
+        metrics /= global_size
+        norm = math.sqrt(sum(g.square().sum(dtype=torch.float64).item() for g in grads.values()))
+        scale = min(1.0, args.clip_grad / (norm + 1e-6)) if args.clip_grad > 0 else 1.0
+        for name, p in parameters.items():
+            p.grad = grads[name].to(device) * scale
+        self.optimizer.step()
+        self.optimizer.zero_grad(set_to_none=True)
+        deltas = {name: p.detach().cpu() - self.previous[name] for name, p in parameters.items()}
+        self.expected.append({"grads": grads, "deltas": deltas, "log_probs": log_probs,
+                              "metrics": metrics.cpu().tolist(), "grad_norm": norm})
+        self.comparisons.append({"log_probs": Comparison(), "gradients": Comparison(), "delta": Comparison()})
+
+    def check_log_probs(self, step, indices, actual):
+        for i, value in zip(indices, actual, strict=True):
+            self.comparisons[step]["log_probs"].add(value, self.expected[step]["log_probs"][i])
+
+    def check_gradients(self, step, model):
+        print(f"[grpo-check rank={self.rank}] compare raw gradients step {step + 1}", flush=True)
+        for name, p in model.named_parameters():
+            self.fp32_grads &= isinstance(p.grad, DTensor) and p.dtype == p.grad.dtype == torch.float32
+            self.comparisons[step]["gradients"].add(p.grad.full_tensor(), self.expected[step]["grads"].pop(name))
+
+    def check_update(self, step, model, report):
+        for name, p in model.named_parameters():
+            actual = p.full_tensor().detach().cpu()
+            self.comparisons[step]["delta"].add(actual - self.previous[name], self.expected[step]["deltas"].pop(name))
+        self.steps.append(dict(report))
+
+    def report(self, trainer):
+        limits = {"logprob_max_abs": 1e-3, "loss_abs": 1e-3, "gradient_relative_l2": 0.03,
+                  "gradient_cosine_min": 0.999, "update_relative_l2": 0.10, "grad_norm_relative": 0.03}
+        details = []
+        for step, (actual, expected) in enumerate(zip(self.steps, self.expected, strict=True)):
+            metrics = {name: value.report() for name, value in self.comparisons[step].items()}
+            checks = {"log_probs": metrics["log_probs"]["max_abs"] <= limits["logprob_max_abs"],
+                      "loss": abs(actual["loss"] - expected["metrics"][0]) <= limits["loss_abs"],
+                      "gradients": metrics["gradients"]["relative_l2"] <= limits["gradient_relative_l2"],
+                      "gradient_direction": metrics["gradients"]["cosine"] >= limits["gradient_cosine_min"],
+                      "grad_norm": abs(actual["grad_norm"] - expected["grad_norm"]) / max(expected["grad_norm"], 1e-12) <= limits["grad_norm_relative"],
+                      "update": 0 < metrics["delta"]["actual_norm"] and metrics["delta"]["relative_l2"] <= limits["update_relative_l2"]}
+            details.append({"checks": checks, "metrics": metrics, "reference_loss": expected["metrics"][0],
+                            "reference_grad_norm": expected["grad_norm"]})
+        parameters = list(trainer.model.parameters())
+        checks = {"two_updates": trainer.optimizer_steps == 2 and len(self.steps) == 2,
+                  "initial_exact": self.initial_comparison.report()["max_abs"] == 0,
+                  "old_log_probs": self.old_comparison.report()["max_abs"] <= limits["logprob_max_abs"],
+                  "half_storage": all(isinstance(p, DTensor) and p.to_local().numel() * 2 == p.numel() for p in parameters),
+                  "fp32_master_and_gradients": self.fp32_grads,
+                  "optimizer_states_sharded": len(trainer.optimizer.state) == len(parameters) and all(
+                      isinstance(state[k], DTensor) and state[k].to_local().shape == p.to_local().shape
+                      for p, state in trainer.optimizer.state.items() for k in ("exp_avg", "exp_avg_sq")),
+                  "optimizer_moments_retained": all(int(state["step"].item()) == 2 for state in trainer.optimizer.state.values()),
+                  "numerical_steps": all(all(item["checks"].values()) for item in details)}
+        return {"passed": all(checks.values()), "rank": self.rank, "checks": checks,
+                "comparison_mode": "stepwise identical input weights; independent persistent AdamW moments",
+                "independent_trajectory_equivalence": False,
+                "limits": limits, "steps": details, "old_log_probs": self.old_comparison.report()}
diff --git a/slime/backends/fsdp_utils/grpo_fixture.py b/slime/backends/fsdp_utils/grpo_fixture.py
new file mode 100644
index 00000000..bb79e92a
--- /dev/null
+++ b/slime/backends/fsdp_utils/grpo_fixture.py
@@ -0,0 +1,47 @@
+"""Deterministic acceptance fixture using the existing Slime data and actor path."""
+
+import ray
+
+from slime.data.batch_builder import BatchBuilder
+from slime.utils.types import Sample
+
+
+def fixed_samples():
+    rewards = [1.0, 0.0, 0.5, 1.5, 0.0, 1.0, 0.0, 1.0]
+    samples = []
+    for rid, reward in enumerate(rewards):
+        for segment in range((3, 1, 2, 2, 1, 1, 1, 1)[rid]):
+            prompt, response = 5 + rid % 3 + segment, 4 + (rid + segment) % 4
+            tokens = [100 + rid * 53 + segment * 17 + pos * 37 for pos in range(prompt + response)]
+            tokens[-1] = 151645  # Qwen3 end-of-turn target, included in the loss.
+            mask = [int(pos % 3 != 1) for pos in range(response)]
+            samples.append(Sample(index=len(samples), rollout_id=rid, group_index=rid // 4,
+                                  tokens=tokens, response_length=response, reward=reward,
+                                  loss_mask=mask, remove_sample=(rid == 0 and segment == 1),
+                                  status=Sample.Status.TRUNCATED if rid == 7 else Sample.Status.COMPLETED))
+    return samples
+
+
+def run_grpo_check(args, group):
+    if (args.rollout_batch_size, args.n_samples_per_prompt, args.global_batch_size, args.micro_batch_size) != (2, 4, 4, 2):
+        raise ValueError("Fixed GRPO fixture requires rollout-batch-size=2, n-samples-per-prompt=4, global-batch-size=4, micro-batch-size=2")
+    if args.use_rollout_logprobs:
+        raise ValueError("Fixed fixture recomputes old actor logprobs; it has no sampler logprobs")
+    builder = BatchBuilder(args)
+    builder.train_parallel_config = {"dp_size": 2, "cp_size": 1, "vpp_size": 1,
+                                     "microbatch_group_size_per_vp_stage": 1}
+    samples = fixed_samples()
+    converted = builder.convert(samples)
+    refs = builder.split_by_dp(converted)
+    ray.get([actor.prepare_grpo_check.remote(refs) for actor in group._actor_handlers], timeout=1200)
+    ranks = ray.get(group.async_train(0, refs), timeout=1200)
+    owners = {}
+    for rank, result in enumerate(ranks):
+        for i in result["partition"]:
+            owners.setdefault(converted["rollout_ids"][i], set()).add(rank)
+    assert any(len(value) == 2 for value in owners.values()), "Fixture must exercise a rollout split across ranks"
+    return {"fixture": {"rollouts": 8, "segments": len(samples), "prompt_groups": 2,
+                         "segmented_rollout_crosses_ranks": True,
+                         "global_batch_size": 4, "micro_batch_size": 2,
+                         "normalized_rewards": converted["rewards"],
+                         "rollout_mask_sums": converted["rollout_mask_sums"]}, "ranks": ranks}
