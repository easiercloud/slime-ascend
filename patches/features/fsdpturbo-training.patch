diff --git a/slime/backends/fsdp_utils/publication.py b/slime/backends/fsdp_utils/publication.py
new file mode 100644
index 00000000..7300930c
--- /dev/null
+++ b/slime/backends/fsdp_utils/publication.py
@@ -0,0 +1,34 @@
+"""Driver-side disk publication without importing the training environment."""
+
+import ray
+
+
+def validate_acknowledgements(replies, versions, expected):
+    if not replies or len(replies) != len(versions):
+        raise RuntimeError("No complete serving acknowledgement")
+    if any(not isinstance(reply, dict) or reply.get("success") is not True for reply in replies):
+        raise RuntimeError(f"SGLang rejected weight reload: {replies}")
+    if any(str(value) != str(expected) for value in versions):
+        raise RuntimeError(f"Serving weight version mismatch: expected {expected}, got {versions}")
+
+
+def publish_to_engines(group):
+    if group._rollout_manager is None:
+        raise ValueError("FSDP disk publication requires a rollout manager")
+    expected = str(group._disk_weight_version + 1)
+    engines, *_ = ray.get(group._rollout_manager.get_updatable_engines_and_lock.remote(), timeout=120)
+    if not engines:
+        raise RuntimeError("FSDP publication requires a live serving engine")
+    exports = ray.get([actor.update_weights.remote() for actor in group._actor_handlers], timeout=1200)
+    if any(item != exports[0] for item in exports) or exports[0]["weight_version"] != expected:
+        raise RuntimeError("Training ranks disagree on exported snapshot")
+    ray.get([engine.pause_generation.remote(mode="abort") for engine in engines], timeout=120)
+    # On any failure leave engines paused: a partially updated fleet must not serve.
+    ray.get([engine.flush_cache.remote() for engine in engines], timeout=120)
+    replies = ray.get([engine.update_weights_from_disk.remote(
+        model_path=exports[0]["path"], weight_version=expected, flush_cache=True,
+        load_format="safetensors") for engine in engines], timeout=600)
+    versions = ray.get([engine.get_weight_version.remote() for engine in engines], timeout=120)
+    validate_acknowledgements(replies, versions, expected)
+    ray.get([engine.continue_generation.remote() for engine in engines], timeout=120)
+    return {**exports[0], "engine_versions": versions, "acknowledgements": replies}
diff --git a/slime/backends/fsdp_utils/trainer.py b/slime/backends/fsdp_utils/trainer.py
new file mode 100644
index 00000000..c297c561
--- /dev/null
+++ b/slime/backends/fsdp_utils/trainer.py
@@ -0,0 +1,161 @@
+"""FSDPTurbo GRPO updates consuming Slime's existing rollout batch contract."""
+
+import math
+
+import torch
+import torch.distributed as dist
+from torch.distributed.fsdp import FSDPModule
+
+from slime.utils import accelerator
+from slime.utils.distributed_utils import get_gloo_group
+
+from .grpo import collate, microbatch_loss, response_log_probs, validate_batch
+from .model import load_qwen3, wrap_qwen3
+
+
+def collective_validate(data, args, vocab_size):
+    """Reject a bad rank's input on every rank before any model collectives."""
+    error = None
+    try:
+        validate_batch(data, vocab_size)
+        if args.use_rollout_logprobs and "rollout_log_probs" not in data:
+            raise ValueError("--use-rollout-logprobs requires rollout_log_probs")
+    except (ValueError, TypeError, IndexError, KeyError, RuntimeError) as exc:
+        error = str(exc)
+    errors = [None] * dist.get_world_size()
+    dist.all_gather_object(errors, error, group=get_gloo_group())
+    if any(errors):
+        raise ValueError(f"Invalid distributed GRPO batch: {errors}")
+    plan = {key: data[key] for key in ("partition", "num_microbatches", "global_batch_sizes",
+                                      "micro_batch_indices", "rollout_ids", "rollout_mask_sums", "rewards")}
+    plan["mask_sums"] = [int(torch.as_tensor(mask).sum()) for mask in data["loss_masks"]]
+    plans = [None] * dist.get_world_size()
+    dist.all_gather_object(plans, plan, group=get_gloo_group())
+    for other in plans:
+        if any(other[key] != plan[key] for key in ("num_microbatches", "global_batch_sizes")):
+            raise ValueError("Training ranks disagree on optimizer-step schedule")
+    partitions = [i for p in plans for i in p["partition"]]
+    if len(set(partitions)) != len(partitions):
+        raise ValueError("Training ranks received overlapping sample partitions")
+    offset = 0
+    seen_rollouts = set()
+    for count, global_size in zip(plan["num_microbatches"], plan["global_batch_sizes"], strict=True):
+        totals, reported, rewards = {}, {}, {}
+        for p in plans:
+            for mb in p["micro_batch_indices"][offset:offset + count]:
+                for i in mb:
+                    rid = p["rollout_ids"][i]
+                    totals[rid] = totals.get(rid, 0) + p["mask_sums"][i]
+                    denominator = float(p["rollout_mask_sums"][i])
+                    if rid in reported and reported[rid] != denominator:
+                        raise ValueError("Segments disagree on whole-rollout mask totals")
+                    reported[rid] = denominator
+                    reward = float(p["rewards"][i])
+                    if rid in rewards and rewards[rid] != reward:
+                        raise ValueError("Segments disagree on normalized rollout reward")
+                    rewards[rid] = reward
+        if totals != reported or len(totals) != global_size or seen_rollouts.intersection(totals):
+            raise ValueError("Invalid global rollout counts, mask totals or cross-step segmentation")
+        seen_rollouts.update(totals)
+        offset += count
+
+
+def make_optimizer(parameters, args):
+    return torch.optim.AdamW(parameters, lr=args.lr,
+                             betas=(args.fsdp_adam_beta1, args.fsdp_adam_beta2),
+                             eps=args.fsdp_adam_eps, weight_decay=args.fsdp_weight_decay, foreach=False)
+
+
+def clip_sharded_gradients(model, max_norm):
+    norm2 = torch.zeros((), device=accelerator.device())
+    for parameter in model.parameters():
+        if parameter.grad is None:
+            raise ValueError("GRPO backward left a parameter without a gradient")
+        norm2 += parameter.grad.to_local().float().square().sum()
+    # This backend fixes replica-DP=1; every unique shard contributes once.
+    dist.all_reduce(norm2)
+    norm = norm2.sqrt().item()
+    if not math.isfinite(norm):
+        raise ValueError("Nonfinite GRPO gradient norm; optimizer step cancelled")
+    scale = min(1.0, max_norm / (norm + 1e-6)) if max_norm > 0 else 1.0
+    for parameter in model.parameters():
+        parameter.grad.mul_(scale)
+    return norm
+
+
+class GRPOTrainer:
+    def __init__(self, args):
+        from fsdp_turbo.utils.device import set_accelerator_compatible
+
+        set_accelerator_compatible()
+        self.args = args
+        self.model = load_qwen3(args.hf_checkpoint, torch.float32)
+        self.turbo = wrap_qwen3(self.model, dist.get_world_size())
+        self.optimizer = make_optimizer(self.model.parameters(), args)
+        self.optimizer_steps = 0
+        self.last_rollout_id = None
+
+    def _forward(self, data, indices):
+        batch = collate(data, indices, accelerator.device())
+        logits = self.turbo(**batch).logits
+        return response_log_probs(logits, batch["input_ids"], [data["total_lengths"][i] for i in indices],
+                                  [data["response_lengths"][i] for i in indices], self.args.rollout_temperature)
+
+    def train_batch(self, rollout_id, data, observer=None):
+        args, world = self.args, dist.get_world_size()
+        collective_validate(data, args, self.model.config.vocab_size)
+        self.turbo.train()
+        # Freeze old-policy logprobs for the ENTIRE rollout before any updates.
+        if args.use_rollout_logprobs:
+            old = [torch.as_tensor(value).float().detach().clone() for value in data["rollout_log_probs"]]
+        else:
+            old = [None] * len(data["tokens"])
+            with torch.no_grad():
+                for indices in data["micro_batch_indices"]:
+                    for i, value in zip(indices, self._forward(data, indices), strict=True):
+                        old[i] = value.detach().cpu().clone()
+        # A no-grad forward can leave root parameters gathered. Return to FP32
+        # shards before inspecting master weights or starting the training pass.
+        for module in self.model.modules():
+            if isinstance(module, FSDPModule):
+                module.reshard()
+        if observer is not None:
+            observer.check_old(old)
+        offset = 0
+        reports = []
+        for step, (count, global_size) in enumerate(zip(data["num_microbatches"], data["global_batch_sizes"], strict=True)):
+            if observer is not None:
+                observer.prepare_step(step, self.model)
+            self.optimizer.zero_grad(set_to_none=True)
+            metrics = torch.zeros(3, device=accelerator.device())
+            for indices in data["micro_batch_indices"][offset:offset + count]:
+                log_probs = self._forward(data, indices)
+                loss, micro_metrics = microbatch_loss(args, data, indices, log_probs, old)
+                # FSDP averages across ranks, but accumulates microbatches by sum.
+                # Do not divide again by the number of microbatches.
+                (loss * (world / global_size)).backward()
+                metrics += micro_metrics
+                if observer is not None:
+                    observer.check_log_probs(step, indices, log_probs)
+            dist.all_reduce(metrics)
+            metrics /= global_size
+            if not torch.isfinite(metrics).all():
+                raise ValueError("Nonfinite GRPO metrics; optimizer step cancelled")
+            if observer is not None:
+                observer.check_gradients(step, self.model)
+            grad_norm = clip_sharded_gradients(self.model, args.clip_grad)
+            self.optimizer.step()
+            self.optimizer_steps += 1
+            report = {"step": self.optimizer_steps, "loss": metrics[0].item(),
+                      "pg_clipfrac": metrics[1].item(), "ppo_kl": metrics[2].item(),
+                      "grad_norm": grad_norm, "lr": args.lr, "global_rollouts": global_size,
+                      "microbatches_per_rank": count}
+            if observer is not None:
+                observer.check_update(step, self.model, report)
+            reports.append(report)
+            offset += count
+        self.optimizer.zero_grad(set_to_none=True)
+        self.last_rollout_id = rollout_id
+        return {"rollout_id": rollout_id, "optimizer_steps": self.optimizer_steps, "steps": reports,
+                "partition": data["partition"],
+                "old_log_probs_source": "rollout" if args.use_rollout_logprobs else "frozen_actor"}
diff --git a/slime/backends/fsdp_utils/weight_sync.py b/slime/backends/fsdp_utils/weight_sync.py
new file mode 100644
index 00000000..46b09e4c
--- /dev/null
+++ b/slime/backends/fsdp_utils/weight_sync.py
@@ -0,0 +1,89 @@
+"""Publish HF inference snapshots, not resumable optimizer checkpoints."""
+
+import hashlib
+import json
+import shutil
+import tempfile
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+from torch.distributed.fsdp import FSDPModule
+from torch.distributed.tensor import DTensor
+
+from slime.utils.distributed_utils import get_gloo_group
+
+
+def root_action(action):
+    """Propagate rank-zero filesystem failures before the next model collective."""
+    result = [None]
+    if dist.get_rank() == 0:
+        try:
+            result[0] = {"value": action()}
+        except Exception as exc:
+            result[0] = {"error": f"{type(exc).__name__}: {exc}"}
+    dist.broadcast_object_list(result, src=0, group=get_gloo_group())
+    if "error" in result[0]:
+        raise RuntimeError(f"HF weight publication failed: {result[0]['error']}")
+    return result[0]["value"]
+
+
+def write_snapshot(model, state, source, destination, version, optimizer_steps):
+    """A sibling temporary directory becomes visible only after a complete write."""
+    from safetensors.torch import save_file
+
+    destination = Path(destination)
+    if destination.exists():
+        raise FileExistsError(f"Refusing to replace existing snapshot: {destination}")
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = Path(tempfile.mkdtemp(prefix=f".{destination.name}-", dir=destination.parent))
+    try:
+        # Explicit cloning handles the tied embedding/head safetensors alias.
+        state = {name: tensor.contiguous().clone() for name, tensor in state.items()}
+        if model.config.tie_word_embeddings:
+            if not torch.equal(state["model.embed_tokens.weight"], state["lm_head.weight"]):
+                raise ValueError("Export lost tied embedding/head equality")
+        save_file(state, str(temporary / "model.safetensors"), metadata={"format": "pt"})
+        model.config.save_pretrained(temporary)
+        for name in ("tokenizer.json", "tokenizer_config.json", "special_tokens_map.json",
+                     "generation_config.json", "vocab.json", "merges.txt", "chat_template.jinja"):
+            path = Path(source) / name
+            if path.is_file():
+                shutil.copyfile(path, temporary / name)
+        with (temporary / "model.safetensors").open("rb") as stream:
+            digest = hashlib.file_digest(stream, "sha256").hexdigest()
+        report = {"weight_version": str(version), "optimizer_steps": optimizer_steps,
+                  "sha256": digest, "tensor_count": len(state), "dtype": "bfloat16",
+                  "path": str(destination), "resumable_training_checkpoint": False}
+        (temporary / "fsdp-publication.json").write_text(json.dumps(report, indent=2) + "\n")
+        temporary.rename(destination)
+        return report
+    finally:
+        if temporary.exists():
+            shutil.rmtree(temporary)
+
+
+@torch.no_grad()
+def export_weights(trainer, version):
+    model, args = trainer.model, trainer.args
+    target = Path(args.update_weight_disk_dir) / f"weight_v{version:06d}"
+    root_action(lambda: _check_destination(target))
+    for module in model.modules():
+        if isinstance(module, FSDPModule):
+            module.reshard()
+    state = {}
+    # All ranks take part in each gather. Only rank zero retains CPU tensors.
+    # Keep HF names unchanged, as in Miles' FSDP HF weight iterator.
+    for name, value in model.state_dict().items():
+        full = value.full_tensor() if isinstance(value, DTensor) else value
+        if dist.get_rank() == 0:
+            state[name] = full.to(dtype=torch.bfloat16, device="cpu").clone()
+        del full
+    return root_action(lambda: write_snapshot(model, state, args.hf_checkpoint, target,
+                                              version, trainer.optimizer_steps))
+
+
+def _check_destination(target):
+    if target.exists():
+        raise FileExistsError(f"Snapshot already exists: {target}")
+    target.parent.mkdir(parents=True, exist_ok=True)
