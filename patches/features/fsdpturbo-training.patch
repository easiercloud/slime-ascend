+"""Checkpoint integrity, argument isolation and real CPU DCP state restoration."""
+
+import json
+import sys
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.distributed.checkpoint as dcp
+
+from slime.backends.fsdp_utils.checkpoint import FORMAT, POLICY_FIELDS, TrainingState, file_record, signature, validate_manifest
+
+
+def test_signature_survives_json_roundtrip(monkeypatch):
+    import slime.backends.fsdp_utils.checkpoint as checkpoint
+
+    monkeypatch.setattr(checkpoint.dist, "get_world_size", lambda: 2)
+    monkeypatch.setattr(checkpoint.importlib.metadata, "version", lambda name: "fixed-version")
+    trainer = SimpleNamespace(model=SimpleNamespace(config=SimpleNamespace(
+        to_dict=lambda: {"id2label": {0: "LABEL_0"}, "shape": (2, 4)})),
+        args=SimpleNamespace(**{key: 1 for key in POLICY_FIELDS}))
+    value = signature(trainer)
+    assert json.loads(json.dumps(value)) == value
+
+
+def committed(tmp_path):
+    directory = tmp_path / "iter_0000000"
+    (directory / "state").mkdir(parents=True)
+    files = ["state/.metadata", "state/__0_0.distcp", "rng-rank-0.pt", "rng-rank-1.pt"]
+    for name in files:
+        (directory / name).write_bytes(b"test payload")
+    signature = {"world_size": 2}
+    manifest = {"format": FORMAT, "signature": signature, "rollout_id": 0, "next_rollout_id": 1,
+                "optimizer_steps": 2, "weight_version": 7,
+                "files": {name: file_record(directory / name) for name in files}}
+    (directory / "COMMITTED.json").write_text(json.dumps(manifest))
+    return directory, signature, manifest
+
+
+def test_complete_checkpoint(tmp_path):
+    directory, signature, manifest = committed(tmp_path)
+    assert validate_manifest(directory, signature) == manifest
+
+
+@pytest.mark.parametrize("failure", ["missing_commit", "truncated_json", "missing_shard", "corrupt_shard",
+                                    "missing_rng", "missing_metadata", "wrong_world", "bad_progress", "path_escape"])
+def test_invalid_checkpoint_rejected(tmp_path, failure):
+    directory, signature, manifest = committed(tmp_path)
+    if failure == "missing_shard":
+        (directory / "state/__0_0.distcp").unlink()
+    elif failure == "corrupt_shard":
+        (directory / "state/__0_0.distcp").write_bytes(b"same size???")
+    elif failure == "missing_rng":
+        del manifest["files"]["rng-rank-1.pt"]
+    elif failure == "missing_metadata":
+        del manifest["files"]["state/.metadata"]
+    elif failure == "wrong_world":
+        manifest["signature"] = {"world_size": 4}
+    elif failure == "bad_progress":
+        manifest["next_rollout_id"] = 9
+    elif failure == "path_escape":
+        manifest["files"]["../outside"] = {}
+    (directory / "COMMITTED.json").write_text(json.dumps(manifest))
+    if failure == "missing_commit":
+        (directory / "COMMITTED.json").unlink()
+    elif failure == "truncated_json":
+        (directory / "COMMITTED.json").write_text('{"format":')
+    with pytest.raises((ValueError, OSError)):
+        validate_manifest(directory, signature)
+
+
+def test_temporary_checkpoint_not_loadable(tmp_path):
+    directory, signature, _ = committed(tmp_path)
+    hidden = directory.with_name(".iter_0000000-incomplete")
+    directory.rename(hidden)
+    with pytest.raises(ValueError, match="Incomplete"):
+        validate_manifest(hidden, signature)
+
+
+def test_real_dcp_optimizer_restoration_and_continuation(tmp_path):
+    def trainer():
+        model = torch.nn.Linear(4, 3)
+        return SimpleNamespace(model=model, optimizer=torch.optim.AdamW(model.parameters(), lr=0.01))
+
+    def step(state):
+        state.optimizer.zero_grad(set_to_none=True)
+        loss = state.model(torch.arange(8.).reshape(2, 4)).square().mean()
+        loss.backward()
+        state.optimizer.step()
+        return loss.item()
+
+    original = trainer()
+    step(original)
+    directory = str(tmp_path / "state")
+    dcp.save({"training": TrainingState(original)}, checkpoint_id=directory)
+    restored = trainer()
+    assert not restored.optimizer.state
+    dcp.load({"training": TrainingState(restored)}, checkpoint_id=directory)
+    assert step(original) == step(restored)
+    for a, b in zip(original.model.parameters(), restored.model.parameters(), strict=True):
+        torch.testing.assert_close(a, b, rtol=0, atol=0)
+        for name, value in original.optimizer.state[a].items():
+            torch.testing.assert_close(value, restored.optimizer.state[b][name], rtol=0, atol=0)
+
+
+def test_checkpoint_parser_is_separate_from_megatron_load(monkeypatch, tmp_path):
+    from slime.utils.arguments import parse_args
+
+    (tmp_path / "config.json").write_text('{"model_type":"qwen3"}')
+    argv = ["train.py", "--train-backend", "fsdp", "--fsdp-checkpoint-check",
+        "--fsdp-python-executable", sys.executable, "--fsdp-init-report", str(tmp_path / "report.json"),
+        "--hf-checkpoint", str(tmp_path), "--actor-num-gpus-per-node", "2", "--num-gpus-per-node", "4",
+        "--rollout-batch-size", "2", "--n-samples-per-prompt", "4", "--global-batch-size", "4",
+        "--micro-batch-size", "2", "--fsdp-checkpoint-save", str(tmp_path / "checkpoints")]
+    monkeypatch.setattr(sys, "argv", argv)
+    before = set(sys.modules)
+    args = parse_args()
+    assert args.fsdp_checkpoint_check and args.debug_train_only
+    assert args.load is None and args.save is None
+    assert args.fsdp_checkpoint_save == tmp_path / "checkpoints"
+    assert not any(name.split(".")[0] in {"megatron", "megatron_adaptor"} for name in set(sys.modules) - before)
+    argv.extend(["--fsdp-checkpoint-load", str(tmp_path / "missing")])
+    with pytest.raises(ValueError, match="committed"):
+        parse_args()
