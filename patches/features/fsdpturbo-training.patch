@@ -0,0 +1,187 @@
+"""GRPO contract tests, executable on CPU without importing FSDPTurbo."""
+
+from copy import deepcopy
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from slime.backends.fsdp_utils.grpo import (clipped_policy_loss, collate, microbatch_loss,
+                                           response_log_probs, validate_batch)
+
+
+def batch():
+    return {"tokens": [torch.tensor([1, 2, 3, 4]), torch.tensor([2, 3, 4])],
+            "total_lengths": [4, 3], "response_lengths": [2, 1],
+            "loss_masks": [[1, 0], [1]], "rewards": [1.0, 1.0],
+            "rollout_ids": [0, 0], "rollout_mask_sums": [2, 2], "partition": [0, 1],
+            "micro_batch_indices": [[0], [1]], "num_microbatches": [2], "global_batch_sizes": [1]}
+
+
+def args():
+    return SimpleNamespace(eps_clip=0.2, eps_clip_high=0.3, eps_clip_c=None)
+
+
+def test_response_alignment_temperature_and_padding():
+    data = batch()
+    padded = collate(data, [0, 1], "cpu")
+    assert padded["input_ids"].tolist() == [[1, 2, 3, 4], [2, 3, 4, 0]]
+    assert padded["attention_mask"].tolist() == [[1, 1, 1, 1], [1, 1, 1, 0]]
+    logits = torch.arange(2 * 4 * 5, dtype=torch.float32).reshape(2, 4, 5).requires_grad_()
+    actual = response_log_probs(logits, padded["input_ids"], [4, 3], [2, 1], 0.7)
+    expected = (logits / 0.7).log_softmax(-1)
+    torch.testing.assert_close(actual[0], expected[0, [1, 2], [3, 4]])
+    torch.testing.assert_close(actual[1], expected[1, [1], [4]])
+    sum(v.sum() for v in actual).backward()
+    assert logits.grad[0, 0].count_nonzero() == logits.grad[0, 3].count_nonzero() == 0
+    assert logits.grad[1, 2:].count_nonzero() == 0
+
+
+@pytest.mark.parametrize("advantage", [2.0, -2.0])
+@pytest.mark.parametrize("dual", [None, 2.0])
+def test_clipping_branches_and_detached_old_advantage(advantage, dual):
+    ratio = torch.tensor([0.4, 0.9, 1.1, 1.8, 3.0])
+    new = ratio.log().requires_grad_()
+    old = torch.zeros_like(new, requires_grad=True)
+    adv = torch.tensor(advantage, requires_grad=True)
+    loss, _, _ = clipped_policy_loss(new, old, adv, 0.2, 0.3, dual)
+    expected = -torch.minimum(ratio * advantage, ratio.clamp(0.8, 1.3) * advantage)
+    if dual and advantage < 0:
+        expected = expected.clamp(max=-dual * advantage)
+    torch.testing.assert_close(loss, expected)
+    loss.sum().backward()
+    assert old.grad is None and adv.grad is None
+    # Positive advantage clips the high ratio branch; negative clips the low.
+    assert new.grad[3 if advantage > 0 else 0] == 0
+
+
+def test_segment_denominator_and_microbatch_accumulation():
+    data = batch()
+    parameter = torch.tensor(0.0, requires_grad=True)
+    old = [torch.zeros(2), torch.zeros(1)]
+    for i in (0, 1):
+        lp = parameter.expand(data["response_lengths"][i])
+        loss, _ = microbatch_loss(args(), data, [i], [lp], old)
+        # Simulate two ranks, each owning one segment. FSDP averages grads.
+        (loss * 2).backward()
+    assert parameter.grad.item() / 2 == pytest.approx(-1.0)
+
+
+@pytest.mark.parametrize("response", [0, 2])
+def test_empty_or_fully_masked_response_is_differentiable_zero(response):
+    data = batch()
+    data["response_lengths"][0] = response
+    data["loss_masks"][0] = [0] * response
+    data["rollout_mask_sums"][0] = 0
+    logits = torch.randn(1, 4, 5, requires_grad=True)
+    lp = response_log_probs(logits, data["tokens"][0][None], [4], [response], 1.0)
+    loss, metrics = microbatch_loss(args(), data, [0], lp, [torch.zeros(response)])
+    loss.backward()
+    assert loss.item() == 0 and metrics.count_nonzero() == 0 and logits.grad.count_nonzero() == 0
+
+
+@pytest.mark.parametrize("field,value", [
+    ("rewards", [float("nan"), 1]), ("loss_masks", [[1], [1]]),
+    ("response_lengths", [4, 1]), ("rollout_mask_sums", [0, 2]),
+    ("micro_batch_indices", [[0], [0]]), ("global_batch_sizes", []),
+    ("rollout_log_probs", [[0, float("inf")], [0]]),
+])
+def test_malformed_batches_rejected(field, value):
+    data = batch()
+    validate_batch(data, 5)
+    data[field] = value
+    with pytest.raises(ValueError):
+        validate_batch(data, 5)
+
+
+@pytest.mark.parametrize("defect", [None, "overlap", "denominator", "schedule", "remote_error"])
+def test_collective_batch_validation(monkeypatch, defect):
+    from slime.backends.fsdp_utils import trainer as module
+
+    data = batch()
+    config = SimpleNamespace(use_rollout_logprobs=False)
+    monkeypatch.setattr(module.dist, "get_world_size", lambda: 2)
+    monkeypatch.setattr(module, "get_gloo_group", lambda: None)
+    def gather(output, value, group):
+        if value is None:
+            output[:] = [None, "bad remote token ID" if defect == "remote_error" else None]
+        else:
+            remote = deepcopy(value)
+            remote["partition"] = [2, 3]
+            remote["rollout_ids"] = [1, 1]
+            if defect == "overlap":
+                remote["partition"] = [0, 3]
+            elif defect == "denominator":
+                remote["rollout_mask_sums"] = [3, 3]
+            elif defect == "schedule":
+                remote["global_batch_sizes"] = [3]
+            output[:] = [value, remote]
+    data["global_batch_sizes"] = [2]
+    monkeypatch.setattr(module.dist, "all_gather_object", gather)
+    if defect:
+        with pytest.raises(ValueError):
+            module.collective_validate(data, config, 5)
+    else:
+        module.collective_validate(data, config, 5)
+
+
+def builder_args():
+    return SimpleNamespace(custom_reward_post_process_path=None, custom_convert_samples_to_train_data_path=None,
+                           advantage_estimator="grpo", rewards_normalization=True, grpo_std_normalization=True,
+                           reward_key=None, rollout_batch_size=2, n_samples_per_prompt=4, rollout_top_p=1.0)
+
+
+def test_real_batch_builder_normalizes_unique_rollouts_once():
+    from slime.data.batch_builder import BatchBuilder
+    from slime.backends.fsdp_utils.grpo_fixture import fixed_samples
+
+    samples = fixed_samples()
+    data = BatchBuilder(builder_args()).convert(samples)
+    raw = torch.tensor([1.0, 0.0, 0.5, 1.5])
+    normalized = (raw - raw.mean()) / (raw.std() + 1e-6)
+    torch.testing.assert_close(torch.tensor(data["rewards"][:8]), normalized.repeat_interleave(torch.tensor([3, 1, 2, 2])))
+    assert not any(data["loss_masks"][1])
+    assert data["rollout_mask_sums"][0] == data["rollout_mask_sums"][1] == data["rollout_mask_sums"][2]
+    assert data["rollout_mask_sums"][0] == sum(data["loss_masks"][0]) + sum(data["loss_masks"][2])
+    assert data["truncated"][-1] == 1
+    for sample in samples:
+        sample.reward = 1.0
+    assert BatchBuilder(builder_args()).convert(samples)["rewards"] == [0.0] * len(samples)
+    assert BatchBuilder(builder_args()).convert(samples[:1])["rewards"] == [0.0]
+
+
+@pytest.mark.parametrize("supplied", [False, True])
+def test_old_policy_is_frozen_across_steps_and_optimizer_persists(monkeypatch, supplied):
+    from slime.backends.fsdp_utils import trainer as module
+
+    model = torch.nn.Linear(1, 1, bias=False)
+    model.weight.data.zero_()
+    model.config = SimpleNamespace(vocab_size=5)
+    instance = module.GRPOTrainer.__new__(module.GRPOTrainer)
+    instance.model = instance.turbo = model
+    instance.args = args()
+    instance.args.use_rollout_logprobs = supplied
+    instance.args.clip_grad = 0
+    instance.args.lr = 0.1
+    instance.optimizer = torch.optim.SGD(model.parameters(), lr=0.1)
+    instance.optimizer_steps = 0
+    calls = []
+    def forward(data, indices):
+        calls.append(torch.is_grad_enabled())
+        return [model.weight.flatten().expand(data["response_lengths"][i]) for i in indices]
+    instance._forward = forward
+    monkeypatch.setattr(module, "collective_validate", lambda *unused: None)
+    monkeypatch.setattr(module, "clip_sharded_gradients", lambda *unused: 1.0)
+    monkeypatch.setattr(module.accelerator, "device", lambda: "cpu")
+    monkeypatch.setattr(module.dist, "get_world_size", lambda: 1)
+    monkeypatch.setattr(module.dist, "all_reduce", lambda *unused: None)
+    data = batch()
+    data.update(rollout_ids=[0, 1], rollout_mask_sums=[1, 1], num_microbatches=[1, 1], global_batch_sizes=[1, 1])
+    if supplied:
+        data["rollout_log_probs"] = [torch.zeros(2), torch.zeros(1)]
+    result = instance.train_batch(0, data)
+    assert result["optimizer_steps"] == 2
+    assert calls == ([True, True] if supplied else [False, False, True, True])
+    assert result["steps"][0]["loss"] == pytest.approx(-1)
+    assert result["steps"][1]["loss"] == pytest.approx(-torch.exp(torch.tensor(0.1)).item())
+    assert model.weight.item() == pytest.approx(0.1 + 0.1 * torch.exp(torch.tensor(0.1)).item())
