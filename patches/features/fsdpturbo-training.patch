+@pytest.mark.parametrize("status", [200, 404, 401, 500])
+def test_sglang_version_fallback_only_for_missing_endpoint(monkeypatch, status):
+    import requests
+    from slime.backends.sglang_utils.sglang_engine import SGLangEngine
+
+    calls = []
+
+    def get(url, timeout):
+        calls.append((url, timeout))
+        reply = requests.Response()
+        reply.status_code = status if len(calls) == 1 else 200
+        reply._content = b'{"weight_version":"7"}'
+        return reply
+
+    monkeypatch.setattr(requests, "get", get)
+    engine = SimpleNamespace(node_rank=0, server_host="127.0.0.1", server_port=1234,
+                             args=SimpleNamespace(rollout_health_check_timeout=5))
+    if status in (401, 500):
+        with pytest.raises(requests.HTTPError):
+            SGLangEngine.get_weight_version(engine)
+    else:
+        assert SGLangEngine.get_weight_version(engine) == "7"
+    assert len(calls) == (2 if status == 404 else 1)
+    if status == 404:
+        assert calls[-1] == ("http://127.0.0.1:1234/model_info", 5)
+
