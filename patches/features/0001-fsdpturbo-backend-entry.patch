--- /dev/null
+++ b/slime/backends/fsdp_utils/actor.py
@@ -0,0 +1,97 @@
+"""FSDP actor lifecycle; model execution is added in subsequent milestones."""
+
+import importlib.metadata
+import os
+import sys
+
+import torch
+import torch.distributed as dist
+
+from slime.ray.train_actor import TrainRayActor
+from slime.utils import accelerator
+from slime.utils.distributed_utils import set_gloo_group
+
+
+class FSDPTrainRayActor(TrainRayActor):
+    """Own one training rank and its communication groups."""
+
+    def init(self, args, role, with_ref=False, with_opd_teacher=False):
+        from slime.backends.fsdp_utils.arguments import validate_fsdp_args
+
+        validate_fsdp_args(args)
+        if role != "actor" or with_ref or with_opd_teacher:
+            raise ValueError("FSDP currently supports only an actor without reference or teacher models")
+        # Establish rendezvous before provider imports can trigger slow JIT builds.
+        super().init(args, role, with_ref, with_opd_teacher)
+        self.imports_before_provider = sorted(
+            name for name in sys.modules
+            if name.split(".")[0] in {"megatron", "megatron_adaptor", "transformer_engine", "sglang"}
+        )
+        from fsdp_turbo.fsdp_turbo import FSDPTurbo
+        from fsdp_turbo.fsdp_turbo_config import FSDPTurboConfig
+
+        self.provider = FSDPTurbo.__name__
+        self.provider_config = FSDPTurboConfig.__name__
+        self.train_parallel_config = {
+            "dp_size": self._world_size, "cp_size": 1, "vpp_size": 1,
+            "microbatch_group_size_per_vp_stage": 1,
+        }
+        return args.start_rollout_id
+
+    def check_runtime(self):
+        """Collectively check both floating point formats and report isolation."""
+        device = torch.device(accelerator.device_type(), accelerator.current_device())
+        checks = []
+        expected_sum = self._world_size * (self._world_size + 1) // 2
+        for dtype in (torch.float32, torch.bfloat16):
+            local = torch.full((8,), self._rank + 1, device=device, dtype=dtype)
+            reduced = local.clone()
+            dist.all_reduce(reduced)
+            torch.testing.assert_close(reduced, torch.full_like(reduced, expected_sum), rtol=0, atol=0)
+            gathered = torch.empty(8 * self._world_size, device=device, dtype=dtype)
+            dist.all_gather_into_tensor(gathered, local)
+            expected = torch.arange(1, self._world_size + 1, device=device, dtype=dtype).repeat_interleave(8)
+            torch.testing.assert_close(gathered, expected, rtol=0, atol=0)
+            scattered = torch.empty_like(local)
+            dist.reduce_scatter_tensor(scattered, local.repeat(self._world_size))
+            torch.testing.assert_close(scattered, torch.full_like(scattered, expected_sum), rtol=0, atol=0)
+            checks.append({"dtype": str(dtype), "all_reduce": True, "all_gather": True, "reduce_scatter": True})
+        forbidden = sorted(name for name in sys.modules
+                           if name.split(".")[0] in {"megatron", "megatron_adaptor", "sglang"})
+        # FSDPTurbo registers optional CUDA ops even on NPU. Its upstream
+        # imports can load TransformerEngine; distinguish these from Slime's
+        # trainer dependencies instead of hiding modules or patching upstream.
+        optional_provider_imports = sorted({name.split(".")[0] for name in sys.modules
+                                            if name.startswith("transformer_engine")})
+        return {
+            "rank": self._rank, "world_size": self._world_size, "device": str(device),
+            "pid": os.getpid(), "python": sys.executable,
+            "transformers": importlib.metadata.version("transformers"),
+            "provider": self.provider, "provider_config": self.provider_config,
+            "train_parallel_config": self.train_parallel_config,
+            "forbidden_imports": forbidden, "checks": checks,
+            "imports_before_provider": self.imports_before_provider,
+            "optional_provider_imports": optional_provider_imports,
+        }
+
+    def shutdown(self):
+        """Destroy this actor's process groups before Ray releases its resources."""
+        if dist.is_initialized():
+            dist.destroy_process_group()
+        set_gloo_group(None)
+        return {"rank": self._rank, "distributed_initialized": dist.is_initialized()}
+
+    def train(self, rollout_id, rollout_data_ref, external_data=None):
+        raise NotImplementedError("FSDP GRPO training is not implemented yet")
+
+    def save_model(self, rollout_id, force_sync=False):
+        raise NotImplementedError("FSDP checkpoint saving is not implemented yet")
+
+    def update_weights(self):
+        raise NotImplementedError("FSDP weight publication is not implemented yet")
+
+    def sleep(self, tags=None):
+        raise NotImplementedError("FSDP offload is not supported")
+
+    def wake_up(self, tags=None):
+        raise NotImplementedError("FSDP offload is not supported")
diff --git a/slime/backends/fsdp_utils/arguments.py b/slime/backends/fsdp_utils/arguments.py
new file mode 100644
index 00000000..8d62d18d
--- /dev/null
+++ b/slime/backends/fsdp_utils/arguments.py
@@ -0,0 +1,60 @@
+"""Parse FSDP configuration without importing the Megatron stack."""
+
+import argparse
+import os
+from pathlib import Path
+
+
+def validate_fsdp_args(args):
+    """Reject features that have not yet been integrated with this backend."""
+    if not args.fsdp_init_only:
+        raise ValueError("FSDP currently supports --fsdp-init-only; model training is not implemented yet")
+    if args.fsdp_init_report is None:
+        raise ValueError("--fsdp-init-only requires --fsdp-init-report")
+    executable = Path(args.fsdp_python_executable)
+    if not executable.is_absolute() or not executable.is_file() or not os.access(executable, os.X_OK):
+        raise ValueError("--fsdp-python-executable must name an absolute, executable Python path")
+    if args.actor_num_nodes != 1 or args.actor_num_gpus_per_node < 1:
+        raise ValueError("FSDP initialization currently requires one node and at least one training device")
+    if args.num_gpus_per_node < args.actor_num_gpus_per_node:
+        raise ValueError("--num-gpus-per-node must cover the training devices")
+    if args.distributed_timeout_minutes <= 0:
+        raise ValueError("--distributed-timeout-minutes must be positive")
+    if args.advantage_estimator != "grpo":
+        raise ValueError("FSDP currently supports only --advantage-estimator grpo")
+    for name in (
+        "colocate", "offload", "offload_train", "offload_rollout", "release_train",
+        "use_opd", "use_kl_loss", "kl_coef", "kl_loss_coef", "ref_load", "megatron_config_path",
+        "use_routing_replay", "use_rollout_routing_replay", "enable_mtp_training", "use_fault_tolerance",
+        "debug_rollout_only", "load", "save", "save_hf", "custom_config_path", "load_debug_rollout_data",
+    ):
+        if getattr(args, name, None):
+            raise ValueError(f"--{name.replace('_', '-')} is not supported by the FSDP initialization stage")
+    if args.rollout_data_transport != "object-store":
+        raise ValueError("FSDP currently requires --rollout-data-transport object-store")
+    if args.update_weight_mode != "full":
+        raise ValueError("FSDP currently supports only full weight updates")
+
+
+def parse_fsdp_args(extra_args_provider):
+    """Build the shared Slime arguments and explicitly owned FSDP options."""
+    from slime.utils.arguments import slime_validate_args
+
+    parser = extra_args_provider(argparse.ArgumentParser(allow_abbrev=False))
+    parser.add_argument("--train-backend", choices=["fsdp"], default="fsdp")
+    parser.add_argument("--fsdp-provider", choices=["fsdpturbo"], default="fsdpturbo")
+    parser.add_argument("--fsdp-python-executable", required=True)
+    parser.add_argument("--fsdp-init-only", action="store_true")
+    parser.add_argument("--fsdp-init-report", type=Path)
+    parser.add_argument("--debug-train-only", action="store_true")
+    parser.add_argument("--debug-rollout-only", action="store_true")
+    parser.add_argument("--load-debug-rollout-data")
+    parser.set_defaults(num_rollout=0, rollout_batch_size=2, n_samples_per_prompt=4,
+                        global_batch_size=8, advantage_estimator="grpo", kl_loss_coef=0.0)
+    args = parser.parse_args()
+    validate_fsdp_args(args)
+    # The initialization check owns no rollout engines or checkpoint state.
+    args.debug_train_only = True
+    args, restore_plan = slime_validate_args(args)
+    validate_fsdp_args(args)
+    return args, restore_plan
diff --git a/slime/backends/fsdp_utils/preflight.py b/slime/backends/fsdp_utils/preflight.py
new file mode 100644
index 00000000..5cf312c9
--- /dev/null
+++ b/slime/backends/fsdp_utils/preflight.py
@@ -0,0 +1,65 @@
+"""Exercise the normal Slime placement and actor factory without loading weights."""
+
+import importlib.metadata
+import json
+import sys
+
+import ray
+from ray.util.placement_group import remove_placement_group
+
+from slime.ray.placement_group import create_placement_groups
+
+
+@ray.remote(num_cpus=1)
+class ServingEnvironmentProbe:
+    """Verify that a default Ray worker keeps the serving interpreter."""
+
+    def inspect(self):
+        from sglang.srt.server_args import ServerArgs
+
+        return {"python": sys.executable, "transformers": importlib.metadata.version("transformers"),
+                "server_args": ServerArgs.__name__}
+
+
+def run_initialization_check(args):
+    """Initialize real training actors, check environment isolation, then release."""
+    from slime.ray.placement_group import allocate_train_group
+
+    placements = None
+    group = None
+    serving = None
+    try:
+        placements = create_placement_groups(args)
+        group = allocate_train_group(args, args.actor_num_nodes, args.actor_num_gpus_per_node,
+                                     placements["actor"])
+        start_ids = group.create()
+        ranks = ray.get([actor.check_runtime.remote() for actor in group._actor_handlers], timeout=120)
+        serving = ServingEnvironmentProbe.remote()
+        serving_state = ray.get(serving.inspect.remote(), timeout=120)
+        assert all(item["python"] == args.fsdp_python_executable for item in ranks)
+        assert all(not item["forbidden_imports"] for item in ranks), ranks
+        assert all(not item["imports_before_provider"] for item in ranks), ranks
+        assert len({item["device"] for item in ranks}) == len(ranks)
+        assert serving_state["python"] == sys.executable
+        assert start_ids == [args.start_rollout_id] * len(ranks)
+        shutdown = ray.get([actor.shutdown.remote() for actor in group._actor_handlers], timeout=60)
+        assert all(not item["distributed_initialized"] for item in shutdown)
+        result = {"passed": True, "scope": "actor initialization only; no model loaded or generation run",
+                  "ranks": ranks, "serving_environment": serving_state, "shutdown": shutdown}
+        args.fsdp_init_report.parent.mkdir(parents=True, exist_ok=True)
+        args.fsdp_init_report.write_text(json.dumps(result, indent=2) + "\n")
+        print("FSDP_ACTOR_INITIALIZATION_PASSED", json.dumps(result), flush=True)
+    finally:
+        if group is not None:
+            group.release()
+        if serving is not None:
+            ray.kill(serving, no_restart=True)
+        if placements is not None:
+            removed = set()
+            for value in placements.values():
+                if value is None:
+                    continue
+                placement = value[0]
+                if placement is not None and placement.id not in removed:
+                    remove_placement_group(placement)
+                    removed.add(placement.id)
