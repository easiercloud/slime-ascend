diff --git a/tests/test_fsdp_entry.py b/tests/test_fsdp_entry.py
new file mode 100644
index 00000000..5c8fbc8c
--- /dev/null
+++ b/tests/test_fsdp_entry.py
@@ -0,0 +1,61 @@
+"""Regression checks for the FSDP entry, run without optional trainer imports."""
+
+import importlib.abc
+import sys
+
+import pytest
+
+from slime.utils.arguments import parse_args
+
+
+class BlockTrainingDependencies(importlib.abc.MetaPathFinder):
+    def find_spec(self, fullname, path=None, target=None):
+        if fullname.split(".")[0] in {"megatron", "megatron_adaptor", "transformer_engine", "sglang"}:
+            raise AssertionError(f"Unexpected optional dependency: {fullname}")
+
+
+@pytest.fixture
+def cli(monkeypatch, tmp_path):
+    argv = ["train.py", "--train-backend", "fsdp", "--fsdp-provider", "fsdpturbo",
+            "--fsdp-init-only", "--fsdp-python-executable", sys.executable,
+            "--fsdp-init-report", str(tmp_path / "report.json"),
+            "--actor-num-gpus-per-node", "2", "--num-gpus-per-node", "4", "--rollout-batch-size", "2"]
+    monkeypatch.setattr(sys, "argv", argv)
+    blocker = BlockTrainingDependencies()
+    sys.meta_path.insert(0, blocker)
+    yield argv
+    sys.meta_path.remove(blocker)
+
+
+def test_fsdp_parser_owns_defaults_without_megatron(cli):
+    args, restore = parse_args(return_restore_plan=True)
+    assert args.train_backend == "fsdp"
+    assert args.actor_num_gpus_per_node == 2
+    assert args.start_rollout_id == 0
+    assert args.offload_train is False
+    assert args.debug_train_only is True
+    assert restore.mode == "new"
+
+
+@pytest.mark.parametrize("option", ["--colocate", "--offload-train", "--use-kl-loss", "--release-train"])
+def test_reject_unsupported_modes(cli, option):
+    cli.append(option)
+    with pytest.raises(ValueError, match="not supported"):
+        parse_args()
+
+
+def test_reject_training_until_implemented(cli):
+    cli.remove("--fsdp-init-only")
+    with pytest.raises(ValueError, match="not implemented"):
+        parse_args()
+
+
+def test_reject_unknown_argument(cli):
+    cli.append("--fsdp-typo")
+    with pytest.raises(SystemExit):
+        parse_args()
+
+
+def test_fsdp_actor_import_is_lazy(cli):
+    from slime.backends.fsdp_utils.actor import FSDPTrainRayActor
+    assert FSDPTrainRayActor.__name__ == "FSDPTrainRayActor"
