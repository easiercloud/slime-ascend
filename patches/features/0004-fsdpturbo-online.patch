diff --git a/slime/backends/fsdp_utils/online_check.py b/slime/backends/fsdp_utils/online_check.py
new file mode 100644
index 00000000..8fe6f47c
--- /dev/null
+++ b/slime/backends/fsdp_utils/online_check.py
@@ -0,0 +1,95 @@
+"""Bounded 2+2 NPU integration check using Slime's real rollout manager."""
+
+import json
+import math
+from pathlib import Path
+
+import ray
+import requests
+
+
+def probe_policy(url, input_ids):
+    response = requests.post(url + "/generate", json={
+        "input_ids": input_ids, "sampling_params": {"temperature": 0, "max_new_tokens": 1},
+        "return_logprob": True, "logprob_start_len": 0,
+    }, timeout=120)
+    response.raise_for_status()
+    result = response.json()
+    entries = result["meta_info"]["input_token_logprobs"]
+    values = [float(item[0]) for item in entries if item[0] is not None]
+    if not values or not all(math.isfinite(value) for value in values):
+        raise RuntimeError("Serving returned no finite fixed-input log probabilities")
+    return {"input_ids": input_ids, "log_probs": values, "response": result}
+
+
+def run_online_check(args, restore_plan):
+    from transformers import AutoTokenizer
+
+    from slime.observability.logging_utils import finish_tracking, init_tracking
+    from slime.ray.placement_group import create_rollout_manager, create_training_models
+    from slime.utils.data import process_rollout_data
+
+    startup = group = None
+    result = {"passed": False, "scope": "Qwen3 FSDPTurbo two-rollout GRPO and full disk publication",
+              "publications": [], "rollouts": []}
+    report_path = Path(args.fsdp_init_report)
+    report_path.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        init_tracking(args)
+        startup = create_rollout_manager(args, restore_plan=restore_plan)
+        args, manager = startup.args, startup.manager
+        group, critic = create_training_models(args, startup.placements, manager)
+        assert critic is None
+        result["runtime"] = ray.get([actor.check_runtime.remote() for actor in group._actor_handlers], timeout=120)
+        assert all(not item["forbidden_imports"] and not item["imports_before_provider"] for item in result["runtime"])
+        result["publications"].append(group.update_weights())
+        ray.get(manager.training_ready.remote(), timeout=120)
+        engines, *_ = ray.get(manager.get_updatable_engines_and_lock.remote(), timeout=120)
+        assert len(engines) == 1
+        url = ray.get(engines[0].get_url.remote(), timeout=120)
+        tokenizer = AutoTokenizer.from_pretrained(args.hf_checkpoint, local_files_only=True)
+        probe_ids = tokenizer.encode("The capital of France is Paris. Two plus two equals four.")
+        probes = [probe_policy(url, probe_ids)]
+        for rollout_id in range(2):
+            refs = ray.get(manager.generate.remote(rollout_id), timeout=600)
+            data = [process_rollout_data(refs, rank, 2) for rank in range(2)]
+            rewards = [float(value) for rank in data for value in rank["rewards"]]
+            if not any(value != 0 for value in rewards):
+                raise RuntimeError("Generated batch has zero GRPO advantages; cannot validate a policy update")
+            training = ray.get(group.async_train(rollout_id, refs), timeout=1200)
+            if not all(any(step["grad_norm"] > 0 for step in rank["steps"]) for rank in training):
+                raise RuntimeError("Real rollout produced no policy gradient")
+            ray.get(manager.training_completed.remote(rollout_id), timeout=120)
+            paused = ray.get(manager.pause_rollout_admission.remote(), timeout=120)
+            publication = group.update_weights()
+            if publication["sha256"] == result["publications"][-1]["sha256"]:
+                raise RuntimeError("GRPO did not change BF16 inference weights")
+            result["publications"].append(publication)
+            probes.append(probe_policy(url, probe_ids))
+            if str(probes[-1]["response"]["meta_info"]["weight_version"]) != publication["weight_version"]:
+                raise RuntimeError("Generation response used the wrong weight version")
+            delta = max(abs(a - b) for a, b in zip(probes[-1]["log_probs"], probes[-2]["log_probs"], strict=True))
+            if delta <= 1e-6:
+                raise RuntimeError("Serving fixed-input probabilities did not change after publication")
+            result["rollouts"].append({"rollout_id": rollout_id,
+                "normalized_rewards": rewards, "training": training,
+                "raw_rewards": [rank["local_raw_reward"] for rank in data],
+                "generated_response_lengths": [rank["response_lengths"] for rank in data],
+                "serving_logprob_max_change": delta})
+            if rollout_id == 0:
+                ray.get(manager.resume_rollout_admission.remote(paused), timeout=120)
+        result["probes"] = probes
+        result["shutdown"] = ray.get([actor.shutdown.remote() for actor in group._actor_handlers], timeout=120)
+        result["passed"] = True
+        print("FSDP_ONLINE_CHECK_PASSED", json.dumps(result), flush=True)
+    except Exception as exc:
+        result["error"] = f"{type(exc).__name__}: {exc}"
+        raise
+    finally:
+        report_path.write_text(json.dumps(result, indent=2) + "\n")
+        if group is not None:
+            group.release()
+        if startup is not None:
+            # This check is not resumable; dispose its own engines even on failure.
+            startup.close(failed=False)
+        finish_tracking(args)
diff --git a/slime/backends/fsdp_utils/publication.py b/slime/backends/fsdp_utils/publication.py
new file mode 100644
index 00000000..7300930c
--- /dev/null
+++ b/slime/backends/fsdp_utils/publication.py
@@ -0,0 +1,34 @@
+"""Driver-side disk publication without importing the training environment."""
+
+import ray
+
+
+def validate_acknowledgements(replies, versions, expected):
+    if not replies or len(replies) != len(versions):
+        raise RuntimeError("No complete serving acknowledgement")
+    if any(not isinstance(reply, dict) or reply.get("success") is not True for reply in replies):
+        raise RuntimeError(f"SGLang rejected weight reload: {replies}")
+    if any(str(value) != str(expected) for value in versions):
+        raise RuntimeError(f"Serving weight version mismatch: expected {expected}, got {versions}")
+
+
+def publish_to_engines(group):
+    if group._rollout_manager is None:
+        raise ValueError("FSDP disk publication requires a rollout manager")
+    expected = str(group._disk_weight_version + 1)
+    engines, *_ = ray.get(group._rollout_manager.get_updatable_engines_and_lock.remote(), timeout=120)
+    if not engines:
+        raise RuntimeError("FSDP publication requires a live serving engine")
+    exports = ray.get([actor.update_weights.remote() for actor in group._actor_handlers], timeout=1200)
+    if any(item != exports[0] for item in exports) or exports[0]["weight_version"] != expected:
+        raise RuntimeError("Training ranks disagree on exported snapshot")
+    ray.get([engine.pause_generation.remote(mode="abort") for engine in engines], timeout=120)
+    # On any failure leave engines paused: a partially updated fleet must not serve.
+    ray.get([engine.flush_cache.remote() for engine in engines], timeout=120)
+    replies = ray.get([engine.update_weights_from_disk.remote(
+        model_path=exports[0]["path"], weight_version=expected, flush_cache=True,
+        load_format="safetensors") for engine in engines], timeout=600)
+    versions = ray.get([engine.get_weight_version.remote() for engine in engines], timeout=120)
+    validate_acknowledgements(replies, versions, expected)
+    ray.get([engine.continue_generation.remote() for engine in engines], timeout=120)
+    return {**exports[0], "engine_versions": versions, "acknowledgements": replies}
diff --git a/slime/backends/fsdp_utils/weight_sync.py b/slime/backends/fsdp_utils/weight_sync.py
new file mode 100644
index 00000000..46b09e4c
--- /dev/null
+++ b/slime/backends/fsdp_utils/weight_sync.py
@@ -0,0 +1,89 @@
+"""Publish HF inference snapshots, not resumable optimizer checkpoints."""
+
+import hashlib
+import json
+import shutil
+import tempfile
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+from torch.distributed.fsdp import FSDPModule
+from torch.distributed.tensor import DTensor
+
+from slime.utils.distributed_utils import get_gloo_group
+
+
+def root_action(action):
+    """Propagate rank-zero filesystem failures before the next model collective."""
+    result = [None]
+    if dist.get_rank() == 0:
+        try:
+            result[0] = {"value": action()}
+        except Exception as exc:
+            result[0] = {"error": f"{type(exc).__name__}: {exc}"}
+    dist.broadcast_object_list(result, src=0, group=get_gloo_group())
+    if "error" in result[0]:
+        raise RuntimeError(f"HF weight publication failed: {result[0]['error']}")
+    return result[0]["value"]
+
+
+def write_snapshot(model, state, source, destination, version, optimizer_steps):
+    """A sibling temporary directory becomes visible only after a complete write."""
+    from safetensors.torch import save_file
+
+    destination = Path(destination)
+    if destination.exists():
+        raise FileExistsError(f"Refusing to replace existing snapshot: {destination}")
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = Path(tempfile.mkdtemp(prefix=f".{destination.name}-", dir=destination.parent))
+    try:
+        # Explicit cloning handles the tied embedding/head safetensors alias.
+        state = {name: tensor.contiguous().clone() for name, tensor in state.items()}
+        if model.config.tie_word_embeddings:
+            if not torch.equal(state["model.embed_tokens.weight"], state["lm_head.weight"]):
+                raise ValueError("Export lost tied embedding/head equality")
+        save_file(state, str(temporary / "model.safetensors"), metadata={"format": "pt"})
+        model.config.save_pretrained(temporary)
+        for name in ("tokenizer.json", "tokenizer_config.json", "special_tokens_map.json",
+                     "generation_config.json", "vocab.json", "merges.txt", "chat_template.jinja"):
+            path = Path(source) / name
+            if path.is_file():
+                shutil.copyfile(path, temporary / name)
+        with (temporary / "model.safetensors").open("rb") as stream:
+            digest = hashlib.file_digest(stream, "sha256").hexdigest()
+        report = {"weight_version": str(version), "optimizer_steps": optimizer_steps,
+                  "sha256": digest, "tensor_count": len(state), "dtype": "bfloat16",
+                  "path": str(destination), "resumable_training_checkpoint": False}
+        (temporary / "fsdp-publication.json").write_text(json.dumps(report, indent=2) + "\n")
+        temporary.rename(destination)
+        return report
+    finally:
+        if temporary.exists():
+            shutil.rmtree(temporary)
+
+
+@torch.no_grad()
+def export_weights(trainer, version):
+    model, args = trainer.model, trainer.args
+    target = Path(args.update_weight_disk_dir) / f"weight_v{version:06d}"
+    root_action(lambda: _check_destination(target))
+    for module in model.modules():
+        if isinstance(module, FSDPModule):
+            module.reshard()
+    state = {}
+    # All ranks take part in each gather. Only rank zero retains CPU tensors.
+    # Keep HF names unchanged, as in Miles' FSDP HF weight iterator.
+    for name, value in model.state_dict().items():
+        full = value.full_tensor() if isinstance(value, DTensor) else value
+        if dist.get_rank() == 0:
+            state[name] = full.to(dtype=torch.bfloat16, device="cpu").clone()
+        del full
+    return root_action(lambda: write_snapshot(model, state, args.hf_checkpoint, target,
+                                              version, trainer.optimizer_steps))
+
+
+def _check_destination(target):
+    if target.exists():
+        raise FileExistsError(f"Snapshot already exists: {target}")
+    target.parent.mkdir(parents=True, exist_ok=True)
