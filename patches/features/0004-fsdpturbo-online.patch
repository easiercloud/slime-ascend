diff --git a/tests/test_fsdp_weight_sync.py b/tests/test_fsdp_weight_sync.py
new file mode 100644
index 00000000..634ff54e
--- /dev/null
+++ b/tests/test_fsdp_weight_sync.py
@@ -0,0 +1,104 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+import torch
+from safetensors.torch import load_file
+
+from slime.backends.fsdp_utils.publication import validate_acknowledgements
+from slime.backends.fsdp_utils.weight_sync import write_snapshot
+
+
+class Config:
+    tie_word_embeddings = True
+
+    def save_pretrained(self, path):
+        (path / "config.json").write_text('{"model_type":"qwen3","tie_word_embeddings":true}')
+
+
+def test_export_preserves_tied_hf_names_without_alias(tmp_path):
+    source = tmp_path / "source"
+    source.mkdir()
+    (source / "tokenizer.json").write_text('{}')
+    tensor = torch.arange(12, dtype=torch.bfloat16).reshape(4, 3)
+    target = tmp_path / "weights/v1"
+    state = {"model.embed_tokens.weight": tensor, "lm_head.weight": tensor}
+    result = write_snapshot(SimpleNamespace(config=Config()), state, source, target, 1, 0)
+    loaded = load_file(target / "model.safetensors")
+    assert set(loaded) == set(state)
+    assert torch.equal(loaded["model.embed_tokens.weight"], loaded["lm_head.weight"])
+    assert loaded["lm_head.weight"].dtype == torch.bfloat16
+    assert json.loads((target / "fsdp-publication.json").read_text()) == result
+    assert not result["resumable_training_checkpoint"]
+    assert not list(target.parent.glob(".v1-*"))
+    with pytest.raises(FileExistsError):
+        write_snapshot(SimpleNamespace(config=Config()), state, source, target, 1, 0)
+    assert load_file(target / "model.safetensors")["lm_head.weight"].equal(tensor)
+
+
+def test_failed_export_never_publishes_partial_directory(tmp_path):
+    target = tmp_path / "v1"
+    state = {"model.embed_tokens.weight": torch.zeros(2), "lm_head.weight": torch.ones(2)}
+    with pytest.raises(ValueError, match="tied"):
+        write_snapshot(SimpleNamespace(config=Config()), state, tmp_path, target, 1, 0)
+    assert not target.exists()
+    assert not list(tmp_path.glob(".v1-*"))
+
+
