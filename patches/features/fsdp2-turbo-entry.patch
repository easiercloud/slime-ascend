diff --git a/slime/utils/fsdp2_arguments.py b/slime/utils/fsdp2_arguments.py
new file mode 100644
--- /dev/null
+++ b/slime/utils/fsdp2_arguments.py
@@ -0,0 +1,134 @@
+"""Strict, Megatron-independent arguments for the first offline FSDP2 GRPO path."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+
+def parse_fsdp2_args(add_slime_arguments, argv=None):
+    parser = argparse.ArgumentParser(allow_abbrev=False)
+    add_slime_arguments(parser)
+    parser.add_argument("--train-backend", choices=["fsdp2"], default="fsdp2")
+    parser.add_argument("--debug-train-only", action="store_true")
+    parser.add_argument("--debug-rollout-only", action="store_true")
+    parser.add_argument("--load-debug-rollout-data")
+    parser.add_argument("--fsdp-fixed-rollout", action="store_true", help="Use fixed tokens/rewards; no online generation")
+    parser.add_argument("--fsdp-model-config", required=True, help="Local Qwen3 configuration JSON")
+    parser.add_argument("--fsdp-turbo-config", help="Optional validated FSDPTurbo YAML plan")
+    parser.add_argument("--fsdp-random-init", action="store_true")
+    parser.add_argument(
+        "--fsdp-weight-receiver-path", default="slime.backends.fsdp2_utils.export.verify_exported_model"
+    )
+    parser.add_argument("--use-critic", action="store_true")
+    for option in ("tensor-model-parallel-size", "pipeline-model-parallel-size", "context-parallel-size",
+                   "expert-model-parallel-size", "expert-tensor-parallel-size"):
+        parser.add_argument("--" + option, type=int, default=1)
+    parser.add_argument("--bf16", action="store_true")
+    parser.set_defaults(
+        rollout_function_path="fixed_rollout.generate_rollout",
+        data_source_path="fixed_rollout.FixedDataSource",
+        distributed_backend="hccl", update_weight_transport="disk", update_weight_disk_keep_files=True,
+    )
+    args = parser.parse_args(argv)
+
+    def require(condition, message):
+        if not condition:
+            parser.error("fsdp2: " + message)
+
+    require(isinstance(args.train_env_vars, dict) and all(isinstance(k, str) and isinstance(v, str) for k, v in args.train_env_vars.items()),
+            "train-env-vars must be a JSON object with string keys/values")
+    require(args.rollout_top_p == 1.0 and args.rollout_top_k == -1, "sampler support replay is not implemented")
+    require(args.over_sampling_batch_size in (None, args.rollout_batch_size), "oversampling is not implemented")
+    require(args.fsdp_fixed_rollout, "first implementation requires --fsdp-fixed-rollout")
+    require(args.fsdp_random_init, "first implementation requires --fsdp-random-init")
+    require(args.actor_num_nodes == 1 and args.actor_num_gpus_per_node == 8, "requires one node with eight NPUs")
+    require(args.num_gpus_per_node == 8, "--num-gpus-per-node must be 8")
+    require(args.distributed_backend == "hccl", "--distributed-backend must be hccl")
+    for name in ("tensor_model_parallel_size", "pipeline_model_parallel_size", "context_parallel_size",
+                 "expert_model_parallel_size", "expert_tensor_parallel_size"):
+        require(getattr(args, name) == 1, name + " must be 1")
+    require(args.num_rollout is not None and args.num_rollout > 0, "requires positive --num-rollout")
+    require(args.num_epoch is None, "epoch-derived scheduling is not implemented")
+    require(args.n_samples_per_prompt >= 2, "GRPO requires --n-samples-per-prompt >= 2")
+    require(args.rollout_batch_size > 0 and args.micro_batch_size > 0, "batch sizes must be positive")
+    expected_batch = args.rollout_batch_size * args.n_samples_per_prompt
+    if args.global_batch_size is None:
+        args.global_batch_size = expected_batch
+    require(args.global_batch_size == expected_batch, "one optimizer step per rollout requires global batch = prompt groups * responses")
+    require(args.global_batch_size % (8 * args.micro_batch_size) == 0, "global batch must divide eight ranks times micro batch")
+    require(args.num_steps_per_rollout in (None, 1), "only one optimizer step per rollout is implemented")
+    require(args.advantage_estimator == "grpo" and args.loss_type == "policy_loss", "only GRPO policy loss is implemented")
+    require(args.pg_loss_type in (None, "ppo"), "only clipped PPO-style GRPO loss is implemented")
+    require(args.compute_advantages_and_returns and args.rewards_normalization, "requires global BatchBuilder reward normalization")
+    require(args.rollout_data_transport == "object-store", "first implementation requires object-store transport")
+    require(args.update_weight_mode == "full" and args.update_weight_transport == "disk", "requires full disk HF weight publication")
+    require(args.update_weight_disk_dir is not None, "--update-weight-disk-dir is required")
+    require(args.update_weight_disk_keep_files, "export evidence must be retained")
+    require(args.rollout_num_gpus in (None, 0), "fixed rollout uses no serving NPUs")
+    require(args.start_rollout_id in (None, 0), "recovery/resume is not implemented")
+    require(args.save_interval is None and args.save is None and args.save_hf is None,
+            "DCP/optimizer checkpoints are not implemented; HF weight exports use update-weight-disk-dir")
+    require(args.eval_interval is None and args.eval_config is None and args.eval_prompt_data is None, "evaluation is not implemented")
+    require(args.eps_clip >= 0 and (args.eps_clip_high is None or args.eps_clip_high >= 0), "clip ranges must be nonnegative")
+    require(args.lr > 0 and args.clip_grad > 0 and args.rollout_temperature > 0, "lr, clip-grad and temperature must be positive")
+    require(args.kl_coef == 0 and args.kl_loss_coef == 0 and args.entropy_coef == 0,
+            "KL and entropy penalties are not implemented")
+    disabled = (
+        "debug_rollout_only", "use_critic", "use_kl_loss", "use_unbiased_kl", "use_opd", "use_tis", "use_opsm",
+        "normalize_advantages", "use_score_centering", "use_rollout_entropy", "get_mismatch_metrics",
+        "calculate_per_token_loss", "use_dynamic_batch_size", "balance_data", "balance_by_flops",
+        "colocate", "offload", "offload_train", "offload_rollout", "release_train", "use_fault_tolerance",
+        "partial_rollout", "mask_offpolicy_in_partial_rollout", "use_routing_replay", "use_rollout_routing_replay",
+        "enable_mtp_training", "reset_optimizer_states", "use_stateless_adam", "freeze_indexer", "allgather_cp",
+        "check_weight_update_equal", "async_save", "post_self_attn_layernorm", "post_mlp_layernorm",
+    )
+    for name in disabled:
+        require(not getattr(args, name, False), name + " is not implemented")
+    unsupported_paths = (
+        "load", "hf_checkpoint", "ref_load", "opd_teacher_load", "megatron_config_path", "custom_model_provider_path",
+        "custom_loss_function_path", "custom_advantage_function_path", "custom_tis_function_path",
+        "custom_pg_loss_reducer_function_path", "custom_reward_post_process_path", "custom_convert_samples_to_train_data_path",
+        "custom_update_weight_post_write_path", "update_weight_local_checkpoint_dir", "custom_config_path",
+        "load_debug_rollout_data", "load_forge_rollout_data", "save_debug_rollout_data", "prompt_data",
+        "rollout_external_engine_addrs", "rollout_buffer_url", "custom_generate_function_path",
+        "custom_megatron_init_path", "custom_megatron_before_log_prob_hook_path", "custom_megatron_before_train_step_hook_path",
+        "only_train_params_name_list", "freeze_params_name_list", "ref_update_interval", "eps_clip_c", "mtp_num_layers",
+    )
+    for name in unsupported_paths:
+        require(getattr(args, name, None) is None, name + " is not implemented")
+    config_path = Path(args.fsdp_model_config).expanduser().resolve()
+    require(config_path.is_file(), "model configuration JSON does not exist")
+    with config_path.open() as file:
+        config = json.load(file)
+    require(config.get("model_type") == "qwen3", "first implementation supports dense Qwen3 only")
+    require(config.get("num_hidden_layers", 0) > 0, "model configuration must define positive layer count")
+    args.fsdp_model_config = str(config_path)
+    if args.fsdp_turbo_config is not None:
+        path = Path(args.fsdp_turbo_config).expanduser().resolve()
+        require(path.is_file(), "Turbo plan does not exist")
+        args.fsdp_turbo_config = str(path)
+    for name in ("HCCL_NPU_SOCKET_PORT_RANGE", "HCCL_HOST_SOCKET_PORT_RANGE"):
+        if name in os.environ:
+            args.train_env_vars.setdefault(name, os.environ[name])
+    args.train_env_vars.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD", "0")
+    args.update_weight_disk_dir = str(Path(args.update_weight_disk_dir).expanduser().resolve())
+    args.debug_train_only = True
+    args.debug_rollout_only = False
+    args.rollout_external = False
+    args.rollout_num_gpus = 0
+    args.offload_train = args.offload_rollout = False
+    args.bf16 = True
+    args.use_critic = False
+    args.pg_loss_type = "ppo"
+    args.eval_function_path = args.eval_function_path or args.rollout_function_path
+    args.eps_clip_high = args.eps_clip if args.eps_clip_high is None else args.eps_clip_high
+    args.over_sampling_batch_size = args.over_sampling_batch_size or args.rollout_batch_size
+    args.num_steps_per_rollout = 1
+    args.update_weight_start_version = -1
+    args.fsdp_weight_version = -1
+    args.ckpt_step = None
+    args.num_layers = config["num_hidden_layers"]
+    args.num_experts = None
+    args.moe_router_topk = 1
+    return args
