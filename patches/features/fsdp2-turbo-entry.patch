+def validate_fsdp2_publication(results, disk_weight_dir, weight_version):
+    """Require every rank to agree before the independent receiver reads files."""
+    if len(results) != 8 or any(not isinstance(result, dict) for result in results):
+        raise RuntimeError("Every FSDP2 rank must return a publication descriptor")
+    expected_dir = Path(disk_weight_dir).resolve()
+    expected = {
+        "weight_version": weight_version,
+        "model_path": str(expected_dir),
+        "manifest_path": str(expected_dir / "manifest.json"),
+    }
+    for result in results:
+        if type(result.get("weight_version")) is not int or result["weight_version"] != weight_version:
+            raise RuntimeError("FSDP2 rank published an unexpected weight version")
+        if any(result.get(key) != value for key, value in expected.items()):
+            raise RuntimeError("FSDP2 ranks disagree on the expected publication paths/version")
+    if not (expected_dir / "manifest.json").is_file() or not (expected_dir / "COMPLETE").is_file():
+        raise RuntimeError("FSDP2 export was not atomically completed")
+    return expected
