+    def accept_fsdp2_weights(self, model_path, weight_version, manifest_path):
+        """Cold-load a complete HF export; this is offline verification, not serving."""
+        if self.args.train_backend != "fsdp2" or not self.args.fsdp_fixed_rollout:
+            raise RuntimeError("Offline FSDP2 receiver requires the fixed-rollout backend")
+        expected_version = getattr(self.args, "fsdp_weight_version", -1) + 1
+        if type(weight_version) is not int or weight_version != expected_version:
+            raise RuntimeError(f"Expected FSDP2 weight version {expected_version}, got {weight_version}")
+        expected_dir = Path(self.args.update_weight_disk_dir) / f"weight_v{weight_version:06d}"
+        if Path(model_path).resolve() != expected_dir.resolve():
+            raise RuntimeError("FSDP2 receiver model path does not match the versioned export directory")
+        if Path(manifest_path).resolve() != (expected_dir / "manifest.json").resolve():
+            raise RuntimeError("FSDP2 receiver manifest does not belong to the exported model")
+        receiver = load_function(self.args.fsdp_weight_receiver_path)
+        receipt = receiver(model_path=model_path, manifest_path=manifest_path, weight_version=weight_version)
+        if (not isinstance(receipt, dict) or receipt.get("verified") is not True
+                or receipt.get("weight_version") != weight_version or receipt.get("model_path") != str(expected_dir)):
+            raise RuntimeError("FSDP2 receiver returned an invalid verification receipt")
+        # Publish the acceptance boundary only after the independent load succeeds.
+        self.args.fsdp_weight_version = weight_version
+        self.training_weight_version = weight_version
+        self.weight_version = weight_version
+        if not hasattr(self, "fsdp2_weight_receipts"):
+            self.fsdp2_weight_receipts = []
+        self.fsdp2_weight_receipts.append(receipt)
+        return receipt
