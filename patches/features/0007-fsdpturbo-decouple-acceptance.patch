diff --git a/slime/backends/fsdp_utils/audit.py b/slime/backends/fsdp_utils/audit.py
new file mode 100644
index 00000000..622790ed
--- /dev/null
+++ b/slime/backends/fsdp_utils/audit.py
@@ -0,0 +1,43 @@
+"""Driver-side durable audit of the synchronous training main loop.
+
+Separated from resume.py so the checkpoint/data-cursor boundary logic stays
+free of observability concerns. SyncReport only writes an audit JSON; it never
+participates in training decisions.
+"""
+
+import os
+from pathlib import Path
+
+from .resume import atomic_json
+
+
+class SyncReport:
+    """Small durable audit of the existing main loop, including failed attempts."""
+
+    def __init__(self, args, group):
+        import ray
+
+        self.path = Path(args.fsdp_init_report)
+        self.value = {"passed": False, "driver_pid": os.getpid(), "start_rollout_id": args.start_rollout_id,
+                      "num_rollout": args.num_rollout, "load": args.load, "save": args.save,
+                      "initial_progress": ray.get([actor.training_progress.remote() for actor in group._actor_handlers]),
+                      "publications": [], "rollouts": []}
+        self.write()
+
+    def write(self):
+        atomic_json(self.path, self.value, replace=True)
+
+    def publish(self, publication):
+        self.value["publications"].append(publication)
+        self.write()
+
+    def trained(self, rollout_id, training):
+        self.value["rollouts"].append({"rollout_id": rollout_id, "training": training})
+        self.write()
+
+    def finish(self, group):
+        import ray
+
+        self.value["final_progress"] = ray.get([actor.training_progress.remote() for actor in group._actor_handlers])
+        self.value["passed"] = True
+        self.write()
\ No newline at end of file
