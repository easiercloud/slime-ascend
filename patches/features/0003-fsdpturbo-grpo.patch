@@ -0,0 +1,47 @@
+"""Deterministic acceptance fixture using the existing Slime data and actor path."""
+
+import ray
+
+from slime.data.batch_builder import BatchBuilder
+from slime.utils.types import Sample
+
+
+def fixed_samples():
+    rewards = [1.0, 0.0, 0.5, 1.5, 0.0, 1.0, 0.0, 1.0]
+    samples = []
+    for rid, reward in enumerate(rewards):
+        for segment in range((3, 1, 2, 2, 1, 1, 1, 1)[rid]):
+            prompt, response = 5 + rid % 3 + segment, 4 + (rid + segment) % 4
+            tokens = [100 + rid * 53 + segment * 17 + pos * 37 for pos in range(prompt + response)]
+            tokens[-1] = 151645  # Qwen3 end-of-turn target, included in the loss.
+            mask = [int(pos % 3 != 1) for pos in range(response)]
+            samples.append(Sample(index=len(samples), rollout_id=rid, group_index=rid // 4,
+                                  tokens=tokens, response_length=response, reward=reward,
+                                  loss_mask=mask, remove_sample=(rid == 0 and segment == 1),
+                                  status=Sample.Status.TRUNCATED if rid == 7 else Sample.Status.COMPLETED))
+    return samples
+
+
+def run_grpo_check(args, group):
+    if (args.rollout_batch_size, args.n_samples_per_prompt, args.global_batch_size, args.micro_batch_size) != (2, 4, 4, 2):
+        raise ValueError("Fixed GRPO fixture requires rollout-batch-size=2, n-samples-per-prompt=4, global-batch-size=4, micro-batch-size=2")
+    if args.use_rollout_logprobs:
+        raise ValueError("Fixed fixture recomputes old actor logprobs; it has no sampler logprobs")
+    builder = BatchBuilder(args)
+    builder.train_parallel_config = {"dp_size": 2, "cp_size": 1, "vpp_size": 1,
+                                     "microbatch_group_size_per_vp_stage": 1}
+    samples = fixed_samples()
+    converted = builder.convert(samples)
+    refs = builder.split_by_dp(converted)
+    ray.get([actor.prepare_grpo_check.remote(refs) for actor in group._actor_handlers], timeout=1200)
+    ranks = ray.get(group.async_train(0, refs), timeout=1200)
+    owners = {}
+    for rank, result in enumerate(ranks):
+        for i in result["partition"]:
+            owners.setdefault(converted["rollout_ids"][i], set()).add(rank)
+    assert any(len(value) == 2 for value in owners.values()), "Fixture must exercise a rollout split across ranks"
+    return {"fixture": {"rollouts": 8, "segments": len(samples), "prompt_groups": 2,
+                         "segmented_rollout_crosses_ranks": True,
+                         "global_batch_size": 4, "micro_batch_size": 2,
+                         "normalized_rewards": converted["rewards"],
+                         "rollout_mask_sums": converted["rollout_mask_sums"]}, "ranks": ranks}
