diff --git a/slime/backends/fsdp_utils/grpo.py b/slime/backends/fsdp_utils/grpo.py
new file mode 100644
index 00000000..a78ede7f
--- /dev/null
+++ b/slime/backends/fsdp_utils/grpo.py
@@ -0,0 +1,115 @@
+"""Dense, padded GRPO primitives independent of Megatron and FSDPTurbo imports."""
+
+import math
+
+import torch
+import torch.nn.functional as F
+
+
+def validate_batch(data, vocab_size):
+    """Validate BatchBuilder's DP-local view before distributed model execution."""
+    required = ("tokens", "response_lengths", "total_lengths", "loss_masks", "rewards",
+                "rollout_ids", "rollout_mask_sums", "partition", "micro_batch_indices",
+                "num_microbatches", "global_batch_sizes")
+    for key in required:
+        if key not in data:
+            raise ValueError(f"Missing rollout field: {key}")
+    n = len(data["tokens"])
+    if not n:
+        raise ValueError("Every training rank must receive samples")
+    for key in required[:8]:
+        if len(data[key]) != n:
+            raise ValueError(f"Unaligned rollout field: {key}")
+    for key in ("multimodal_train_inputs", "teacher_log_probs", "rollout_routed_experts",
+                "rollout_top_p_token_ids", "rollout_top_p_token_offsets"):
+        if key in data:
+            raise ValueError(f"Unsupported GRPO payload: {key}")
+    for i in range(n):
+        tokens, mask = torch.as_tensor(data["tokens"][i]), torch.as_tensor(data["loss_masks"][i])
+        length, response = data["total_lengths"][i], data["response_lengths"][i]
+        if not isinstance(length, int) or not isinstance(response, int):
+            raise ValueError("Sequence and response lengths must be integers")
+        if not isinstance(data["rollout_ids"][i], int) or not isinstance(data["partition"][i], int):
+            raise ValueError("Rollout IDs and partition indices must be integers")
+        if tokens.ndim != 1 or tokens.dtype not in (torch.int32, torch.int64):
+            raise ValueError("Tokens must be one-dimensional integer arrays")
+        if len(tokens) != length or not 0 <= response < length:
+            raise ValueError("Response length must leave at least one prompt token")
+        if int(tokens.min()) < 0 or int(tokens.max()) >= vocab_size:
+            raise ValueError("Token ID outside model vocabulary")
+        if mask.ndim != 1 or mask.numel() != response or not torch.all((mask == 0) | (mask == 1)):
+            raise ValueError("Loss masks must be binary and response-aligned")
+        if not math.isfinite(float(data["rewards"][i])):
+            raise ValueError("Rewards must be finite")
+        denominator = float(data["rollout_mask_sums"][i])
+        if not math.isfinite(denominator) or denominator < mask.sum().item():
+            raise ValueError("Invalid whole-rollout loss-mask denominator")
+    if "rollout_log_probs" in data:
+        if len(data["rollout_log_probs"]) != n:
+            raise ValueError("Unaligned rollout log probabilities")
+        for old, length in zip(data["rollout_log_probs"], data["response_lengths"], strict=True):
+            old = torch.as_tensor(old)
+            if old.ndim != 1 or old.numel() != length or not torch.isfinite(old).all():
+                raise ValueError("Rollout log probabilities must be finite and response-aligned")
+    counts, sizes = data["num_microbatches"], data["global_batch_sizes"]
+    if not counts or len(counts) != len(sizes) or any(not isinstance(x, int) or x <= 0 for x in [*counts, *sizes]):
+        raise ValueError("Invalid optimizer-step schedule")
+    microbatches = data["micro_batch_indices"]
+    if len(microbatches) != sum(counts) or any(not mb for mb in microbatches):
+        raise ValueError("Invalid microbatch schedule")
+    flat = [i for mb in microbatches for i in mb]
+    if any(not isinstance(i, int) for i in flat) or sorted(flat) != list(range(n)):
+        raise ValueError("Microbatch schedule must consume each local sample exactly once")
+    if len(data["partition"]) != n or len(set(data["partition"])) != n:
+        raise ValueError("Invalid global sample partition")
+
+
+def collate(data, indices, device):
+    """Right-pad independent sequences; use attention masks for HF eager attention."""
+    lengths = [data["total_lengths"][i] for i in indices]
+    ids = torch.zeros((len(indices), max(lengths)), dtype=torch.long, device=device)
+    attention = torch.zeros_like(ids)
+    for row, (i, length) in enumerate(zip(indices, lengths, strict=True)):
+        ids[row, :length] = torch.as_tensor(data["tokens"][i], device=device, dtype=torch.long)
+        attention[row, :length] = 1
+    return {"input_ids": ids, "attention_mask": attention, "use_cache": False}
+
+
+def response_log_probs(logits, input_ids, lengths, response_lengths, temperature):
+    """The first response target is predicted at prompt_length-1, including EOS."""
+    result = []
+    for row, (length, response) in enumerate(zip(lengths, response_lengths, strict=True)):
+        prompt = length - response
+        rows = logits[row, prompt - 1:length - 1].float() / temperature
+        targets = input_ids[row, prompt:length]
+        result.append(-F.cross_entropy(rows, targets, reduction="none"))
+    return result
+
+
+def clipped_policy_loss(new, old, advantage, clip_low, clip_high, dual_clip=None):
+    """Eager PPO clip objective, matching slime.utils.ppo_utils without torch.compile."""
+    ratio = (new - old.detach()).exp()
+    advantage = torch.as_tensor(advantage, dtype=new.dtype, device=new.device).detach()
+    unclipped = -ratio * advantage
+    clipped = -ratio.clamp(1 - clip_low, 1 + clip_high) * advantage
+    loss = torch.maximum(unclipped, clipped)
+    if dual_clip is not None:
+        loss = torch.where(advantage < 0, torch.minimum(loss, -dual_clip * advantage), loss)
+    return loss, (clipped > unclipped).float(), old.detach() - new
+
+
+def microbatch_loss(args, data, indices, new_log_probs, old_log_probs):
+    """Sum each segment's share of its rollout mean; caller scales for DP/step."""
+    loss = sum(log_probs.sum() * 0 for log_probs in new_log_probs)
+    metrics = loss.detach().new_zeros(3)
+    for i, new in zip(indices, new_log_probs, strict=True):
+        old = old_log_probs[i].to(device=new.device, dtype=torch.float32)
+        values, clipped, kl = clipped_policy_loss(new, old, data["rewards"][i], args.eps_clip,
+                                                 args.eps_clip_high, args.eps_clip_c)
+        mask = torch.as_tensor(data["loss_masks"][i], device=new.device, dtype=torch.float32)
+        denominator = max(float(data["rollout_mask_sums"][i]), 1.0)
+        term = (values * mask).sum() / denominator
+        loss = loss + term
+        metrics += torch.stack((term.detach(), (clipped * mask).sum() / denominator,
+                                (kl.detach() * mask).sum() / denominator))
+    return loss, metrics
diff --git a/slime/backends/fsdp_utils/grpo_check.py b/slime/backends/fsdp_utils/grpo_check.py
new file mode 100644
index 00000000..040bdecf
--- /dev/null
+++ b/slime/backends/fsdp_utils/grpo_check.py
@@ -0,0 +1,167 @@
+"""Independent, stepwise unsharded GRPO oracle on identical input weights.
+
+Each step starts from the actor's FP32 weights. Reference AdamW moments and
+original old logprobs are retained independently. This isolates backend math
+from BF16 boundary crossings due to preceding optimizer rounding differences.
+It is NOT an independent multi-step trajectory-equivalence test.
+"""
+
+import math
+
+import torch
+import torch.distributed as dist
+from torch.distributed.tensor import DTensor
+
+from slime.utils import accelerator
+from .model import load_qwen3
+from .model_check import Comparison
+
+
+def reference_forward(model, data, indices, temperature, device):
+    lengths = [len(data["tokens"][i]) for i in indices]
+    ids = torch.zeros(len(indices), max(lengths), dtype=torch.long, device=device)
+    mask = torch.zeros_like(ids)
+    for row, (i, length) in enumerate(zip(indices, lengths, strict=True)):
+        ids[row, :length] = torch.as_tensor(data["tokens"][i], device=device)
+        mask[row, :length] = 1
+    logits = model(input_ids=ids, attention_mask=mask, use_cache=False).logits
+    result = []
+    for row, i in enumerate(indices):
+        end, response = lengths[row], data["response_lengths"][i]
+        start = end - response
+        distribution = (logits[row, start - 1:end - 1].float() / temperature).log_softmax(-1)
+        result.append(distribution.gather(-1, ids[row, start:end, None]).squeeze(-1))
+    return result
+
+
+class GRPOOracle:
+    def __init__(self, args, data):
+        from fsdp_turbo.utils.device import set_accelerator_compatible
+
+        set_accelerator_compatible()
+        self.args, self.data = args, data
+        self.rank, self.world = dist.get_rank(), dist.get_world_size()
+        self.device = torch.device(accelerator.device_type(), accelerator.current_device())
+        print(f"[grpo-check rank={self.rank}] independent unsharded reference", flush=True)
+        self.reference = load_qwen3(args.hf_checkpoint, torch.bfloat16).to(self.device)
+        self.master = load_qwen3(args.hf_checkpoint, torch.float32).to(self.device)
+        self.optimizer = torch.optim.AdamW(self.master.parameters(), lr=args.lr,
+                                          betas=(args.fsdp_adam_beta1, args.fsdp_adam_beta2),
+                                          eps=args.fsdp_adam_eps, weight_decay=args.fsdp_weight_decay, foreach=False)
+        self.old = [None] * len(data["tokens"])
+        with torch.no_grad():
+            for indices in data["micro_batch_indices"]:
+                for i, lp in zip(indices, reference_forward(self.reference, data, indices, args.rollout_temperature, self.device), strict=True):
+                    self.old[i] = lp.cpu().clone()
+        self.expected, self.comparisons, self.steps = [], [], []
+        self.old_comparison, self.initial_comparison = Comparison(), Comparison()
+        self.fp32_grads = True
+        self.previous = {}
+
+    def check_old(self, actual):
+        for a, b in zip(actual, self.old, strict=True):
+            self.old_comparison.add(a, b)
+
+    def prepare_step(self, step, model):
+        args, data, device = self.args, self.data, self.device
+        parameters = dict(self.master.named_parameters())
+        compute = dict(self.reference.named_parameters())
+        print(f"[grpo-check rank={self.rank}] independent reference step {step + 1}", flush=True)
+        with torch.no_grad():
+            for name, p in model.named_parameters():
+                actual = p.full_tensor().detach()
+                if step == 0:
+                    self.initial_comparison.add(actual, parameters[name])
+                self.previous[name] = actual.cpu()
+                parameters[name].copy_(actual)
+                compute[name].copy_(actual.to(torch.bfloat16))
+        # Never copy actor optimizer state: the reference retains its own moments.
+        grads = {name: torch.zeros_like(p, device="cpu") for name, p in parameters.items()}
+        log_probs = {}
+        metrics = torch.zeros(3, device=device)
+        offset = sum(data["num_microbatches"][:step])
+        count, global_size = data["num_microbatches"][step], data["global_batch_sizes"][step]
+        for indices in data["micro_batch_indices"][offset:offset + count]:
+            self.reference.zero_grad(set_to_none=True)
+            values = reference_forward(self.reference, data, indices, args.rollout_temperature, device)
+            loss = sum(lp.sum() * 0 for lp in values)
+            for i, lp in zip(indices, values, strict=True):
+                log_probs[i] = lp.detach().cpu()
+                old = self.old[i].to(device)
+                ratio = torch.exp(lp - old)
+                advantage = float(data["rewards"][i])
+                bounded = torch.clamp(ratio, 1 - args.eps_clip, 1 + args.eps_clip_high)
+                objective = torch.minimum(ratio * advantage, bounded * advantage)
+                if args.eps_clip_c is not None and advantage < 0:
+                    objective = torch.maximum(objective, objective.new_tensor(args.eps_clip_c * advantage))
+                mask = torch.as_tensor(data["loss_masks"][i], device=device)
+                divisor = max(float(data["rollout_mask_sums"][i]), 1.0)
+                term = -(objective * mask).sum() / divisor
+                loss = loss + term
+                metrics += torch.stack((term.detach(),
+                                        (((bounded * advantage) < (ratio * advantage)).float() * mask).sum() / divisor,
+                                        ((old - lp.detach()) * mask).sum() / divisor))
+            (loss * self.world / global_size).backward()
+            for name, p in self.reference.named_parameters():
+                grad = p.grad.float()
+                dist.all_reduce(grad)
+                grads[name].add_(grad.cpu(), alpha=1 / self.world)
+                p.grad = None
+        dist.all_reduce(metrics)
+        metrics /= global_size
+        norm = math.sqrt(sum(g.square().sum(dtype=torch.float64).item() for g in grads.values()))
+        scale = min(1.0, args.clip_grad / (norm + 1e-6)) if args.clip_grad > 0 else 1.0
+        for name, p in parameters.items():
+            p.grad = grads[name].to(device) * scale
+        self.optimizer.step()
+        self.optimizer.zero_grad(set_to_none=True)
+        deltas = {name: p.detach().cpu() - self.previous[name] for name, p in parameters.items()}
+        self.expected.append({"grads": grads, "deltas": deltas, "log_probs": log_probs,
+                              "metrics": metrics.cpu().tolist(), "grad_norm": norm})
+        self.comparisons.append({"log_probs": Comparison(), "gradients": Comparison(), "delta": Comparison()})
+
+    def check_log_probs(self, step, indices, actual):
+        for i, value in zip(indices, actual, strict=True):
+            self.comparisons[step]["log_probs"].add(value, self.expected[step]["log_probs"][i])
+
+    def check_gradients(self, step, model):
+        print(f"[grpo-check rank={self.rank}] compare raw gradients step {step + 1}", flush=True)
+        for name, p in model.named_parameters():
+            self.fp32_grads &= isinstance(p.grad, DTensor) and p.dtype == p.grad.dtype == torch.float32
+            self.comparisons[step]["gradients"].add(p.grad.full_tensor(), self.expected[step]["grads"].pop(name))
+
+    def check_update(self, step, model, report):
+        for name, p in model.named_parameters():
+            actual = p.full_tensor().detach().cpu()
+            self.comparisons[step]["delta"].add(actual - self.previous[name], self.expected[step]["deltas"].pop(name))
+        self.steps.append(dict(report))
+
+    def report(self, trainer):
+        limits = {"logprob_max_abs": 1e-3, "loss_abs": 1e-3, "gradient_relative_l2": 0.03,
+                  "gradient_cosine_min": 0.999, "update_relative_l2": 0.10, "grad_norm_relative": 0.03}
+        details = []
+        for step, (actual, expected) in enumerate(zip(self.steps, self.expected, strict=True)):
+            metrics = {name: value.report() for name, value in self.comparisons[step].items()}
+            checks = {"log_probs": metrics["log_probs"]["max_abs"] <= limits["logprob_max_abs"],
+                      "loss": abs(actual["loss"] - expected["metrics"][0]) <= limits["loss_abs"],
+                      "gradients": metrics["gradients"]["relative_l2"] <= limits["gradient_relative_l2"],
+                      "gradient_direction": metrics["gradients"]["cosine"] >= limits["gradient_cosine_min"],
+                      "grad_norm": abs(actual["grad_norm"] - expected["grad_norm"]) / max(expected["grad_norm"], 1e-12) <= limits["grad_norm_relative"],
+                      "update": 0 < metrics["delta"]["actual_norm"] and metrics["delta"]["relative_l2"] <= limits["update_relative_l2"]}
+            details.append({"checks": checks, "metrics": metrics, "reference_loss": expected["metrics"][0],
+                            "reference_grad_norm": expected["grad_norm"]})
+        parameters = list(trainer.model.parameters())
+        checks = {"two_updates": trainer.optimizer_steps == 2 and len(self.steps) == 2,
+                  "initial_exact": self.initial_comparison.report()["max_abs"] == 0,
+                  "old_log_probs": self.old_comparison.report()["max_abs"] <= limits["logprob_max_abs"],
+                  "half_storage": all(isinstance(p, DTensor) and p.to_local().numel() * 2 == p.numel() for p in parameters),
+                  "fp32_master_and_gradients": self.fp32_grads,
+                  "optimizer_states_sharded": len(trainer.optimizer.state) == len(parameters) and all(
+                      isinstance(state[k], DTensor) and state[k].to_local().shape == p.to_local().shape
+                      for p, state in trainer.optimizer.state.items() for k in ("exp_avg", "exp_avg_sq")),
+                  "optimizer_moments_retained": all(int(state["step"].item()) == 2 for state in trainer.optimizer.state.values()),
+                  "numerical_steps": all(all(item["checks"].values()) for item in details)}
+        return {"passed": all(checks.values()), "rank": self.rank, "checks": checks,
+                "comparison_mode": "stepwise identical input weights; independent persistent AdamW moments",
+                "independent_trajectory_equivalence": False,
+                "limits": limits, "steps": details, "old_log_probs": self.old_comparison.report()}
