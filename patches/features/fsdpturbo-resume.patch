diff --git a/tests/test_fsdp_resume.py b/tests/test_fsdp_resume.py
new file mode 100644
index 00000000..a6473b50
--- /dev/null
+++ b/tests/test_fsdp_resume.py
@@ -0,0 +1,181 @@
+import json
+import sys
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from slime.backends.fsdp_utils import resume
+
+
+def fixture(tmp_path, step=0):
+    dataset = tmp_path / 'data.jsonl'
+    dataset.write_text('{"prompt":"test"}\n')
+    model = tmp_path / 'hf'
+    model.mkdir(exist_ok=True)
+    (model / 'config.json').write_text('{"model_type":"qwen3"}')
+    (model / 'tokenizer.json').write_text('{}')
+    args = SimpleNamespace(save=str(tmp_path / 'ckpt'), load=None, ckpt_step=None,
+                           start_rollout_id=None, num_rollout=2, prompt_data=str(dataset),
+                           hf_checkpoint=str(model), update_weight_disk_dir=str(tmp_path / 'weights'))
+    args.fsdp_data_signature = resume.data_signature(args)
+    root = tmp_path / 'ckpt'
+    trainer = root / f'iter_{step:07d}'
+    trainer.mkdir(parents=True, exist_ok=True)
+    (trainer / 'COMMITTED.json').write_text(json.dumps({
+        'format': 'slime-fsdpturbo-training-v1', 'rollout_id': step, 'next_rollout_id': step + 1,
+        'optimizer_steps': step + 1, 'weight_version': step + 1}))
+    (root / 'rollout').mkdir(exist_ok=True)
+    torch.save({'epoch_id': 0, 'sample_offset': 2 * (step + 1), 'sample_group_index': 2 * (step + 1),
+                'sample_index': 8 * (step + 1), 'buffer': [], 'consumers': {}},
+               root / 'rollout' / f'global_dataset_state_dict_{step}.pt')
+    return args, root
+
+
+def test_joint_commit_and_version_collision_avoidance(tmp_path):
+    args, root = fixture(tmp_path)
+    value = resume.commit(args, 0, 1)
+    assert resume.read_boundary(root, None, args.fsdp_data_signature) == value
+    (tmp_path / 'weights/weight_v000002').mkdir(parents=True)
+    args.load = str(root)
+    resume.resolve(args)
+    assert args.start_rollout_id == 1 and args.ckpt_step == 0
+    assert args.update_weight_start_version == 2
+    assert args.fsdp_checkpoint_load == root / 'iter_0000000'
+
+
+@pytest.mark.parametrize('failure', ['no_boundary', 'no_data', 'corrupt_data', 'corrupt_model', 'dataset',
+                                    'tokenizer', 'wrong_progress', 'wrong_start', 'save_collision'])
+def test_incomplete_or_incompatible_resume_fails_closed(tmp_path, failure):
+    args, root = fixture(tmp_path)
+    resume.commit(args, 0, 1)
+    args.load = str(root)
+    if failure == 'no_boundary':
+        resume.boundary_path(root, 0).unlink()
+    elif failure == 'no_data':
+        (root / 'rollout/global_dataset_state_dict_0.pt').unlink()
+    elif failure == 'corrupt_data':
+        (root / 'rollout/global_dataset_state_dict_0.pt').write_bytes(b'broken')
+    elif failure == 'corrupt_model':
+        (root / 'iter_0000000/COMMITTED.json').write_text('{}')
+    elif failure == 'dataset':
+        (tmp_path / 'data.jsonl').write_text('changed')
+    elif failure == 'tokenizer':
+        (tmp_path / 'hf/tokenizer.json').write_text('changed')
+    elif failure == 'wrong_progress':
+        path = resume.boundary_path(root, 0)
+        value = json.loads(path.read_text())
+        value['optimizer_steps'] = 98
+        path.write_text(json.dumps(value))
+    elif failure == 'wrong_start':
+        args.start_rollout_id = 0
+    elif failure == 'save_collision':
+        (root / 'iter_0000001').mkdir()
+    with pytest.raises((OSError, ValueError)):
+        resume.resolve(args)
+
+
+def test_failed_tracker_keeps_previous_boundary(tmp_path, monkeypatch):
+    args, root = fixture(tmp_path)
+    resume.commit(args, 0, 1)
+    args, _ = fixture(tmp_path, step=1)
+    original = resume.atomic_json
+    def fail_latest(path, value, **kwargs):
+        if path.name == resume.LATEST:
+            raise OSError('interrupted before tracker publication')
+        original(path, value, **kwargs)
+    monkeypatch.setattr(resume, 'atomic_json', fail_latest)
+    with pytest.raises(OSError):
+        resume.commit(args, 1, 2)
+    assert resume.read_boundary(root, None, args.fsdp_data_signature)['rollout_id'] == 0
+    assert resume.read_boundary(root, 1, args.fsdp_data_signature)['rollout_id'] == 1
+    with pytest.raises(FileExistsError):
+        resume.prepare_save(args, 1)
+
+
+@pytest.mark.parametrize('component', ['model', 'cursor'])
+def test_incomplete_save_does_not_advance_tracker(tmp_path, component):
+    args, root = fixture(tmp_path)
+    target = root / ('iter_0000000/COMMITTED.json' if component == 'model' else 'rollout/global_dataset_state_dict_0.pt')
+    target.unlink()
+    with pytest.raises(OSError):
+        resume.commit(args, 0, 1)
+    assert not (root / resume.LATEST).exists()
+    assert not resume.boundary_path(root, 0).exists()
+
+
+@pytest.mark.parametrize('unsupported_hook', [False, True])
+def test_sync_parser_reuses_common_load_without_megatron(tmp_path, monkeypatch, unsupported_hook):
+    from slime.utils.arguments import parse_args
+
+    args, root = fixture(tmp_path)
+    argv = ['train.py', '--train-backend', 'fsdp', '--fsdp-sync-train',
+            '--fsdp-python-executable', sys.executable, '--fsdp-init-report', str(tmp_path / 'report.json'),
+            '--hf-checkpoint', args.hf_checkpoint, '--prompt-data', args.prompt_data,
+            '--save', str(tmp_path / 'save'), '--save-interval', '1', '--num-rollout', '1',
+            '--rollout-batch-size', '2',
+            '--actor-num-gpus-per-node', '2', '--num-gpus-per-node', '4', '--rollout-num-gpus', '2',
+            '--rollout-num-gpus-per-engine', '2', '--update-weight-transport', 'disk',
+            '--update-weight-disk-dir', args.update_weight_disk_dir, '--update-weight-disk-keep-files',
+            '--flush-cache-interval', '1', '--rollout-top-k', '-1', '--rollout-top-p', '1']
+    monkeypatch.setattr(sys, 'argv', argv)
+    if unsupported_hook:
+        argv += ['--rollout-sample-hook-path', 'custom.sample_hook']
+        with pytest.raises(ValueError, match='rollout_sample_hook_path'):
+            parse_args(return_restore_plan=True)
+        return
+    initial, _ = parse_args(return_restore_plan=True)
+    assert initial.start_rollout_id == 0
+    # Make the fake trainer/data files describe the actual parsed data options.
+    initial.save = str(root)
+    resume.commit(initial, 0, 1)
+    argv[argv.index('--num-rollout') + 1] = '2'
+    argv += ['--load', str(root)]
+    restored, _ = parse_args(return_restore_plan=True)
+    assert restored.start_rollout_id == 1
+    assert restored.fsdp_checkpoint_load == root / 'iter_0000000'
+    assert not any(name == 'megatron' or name.startswith('megatron.') for name in sys.modules)
+
+
+@pytest.mark.parametrize('shuffle', [False, True])
+def test_builtin_source_restores_next_groups_across_epoch(tmp_path, shuffle):
+    import random
+    from slime.data.data_source import RolloutDataSourceWithBuffer
+    from slime.utils.types import Sample
+
+    class Dataset:
+        def __init__(self):
+            self.original = [Sample(prompt=str(i)) for i in range(6)]
+            self.samples = list(self.original)
+        def shuffle(self, epoch):
+            self.samples = list(self.original)
+            random.Random(42 + epoch).shuffle(self.samples)
+        def __len__(self):
+            return len(self.samples)
+
+    def source():
+        # Use the actual source cursor/save/load and sample allocation code,
+        # replacing only tokenizer-backed dataset construction.
+        result = RolloutDataSourceWithBuffer.__new__(RolloutDataSourceWithBuffer)
+        result.args = SimpleNamespace(save=str(tmp_path), load=str(tmp_path), rollout_shuffle=shuffle, n_samples_per_prompt=4)
+        result.dataset = Dataset()
+        if shuffle:
+            result.dataset.shuffle(0)
+        result.sample_offset = result.epoch_id = result.sample_group_index = result.sample_index = 0
+        result.consumers = {}
+        result._restored_consumers = {}
+        result.metadata = {}
+        result.buffer = []
+        return result
+
+    original = source()
+    original.get_samples(4)
+    original.save(0)
+    expected = original.get_samples(4)
+    restored = source()
+    restored.load(0)
+    actual = restored.get_samples(4)
+    def ids(groups):
+        return [[(s.prompt, s.group_index, s.index) for s in group] for group in groups]
+    assert ids(actual) == ids(expected)
+    assert restored.state_dict() == original.state_dict()
