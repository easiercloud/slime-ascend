+"""Driver-side commit of a synchronous trainer checkpoint and Slime data cursor.
+
+The existing RolloutDataSource owns cursor serialization. This module only binds
+its output to the trainer's committed directory and selects complete boundaries.
+"""
+
+import hashlib
+import json
+import os
+import tempfile
+from pathlib import Path
+
+
+FORMAT = "slime-fsdpturbo-object-store-v1"
+LATEST = "fsdp_latest.json"
+DATA_FIELDS = ("input_key", "label_key", "metadata_key", "tool_key", "multimodal_keys",
+               "apply_chat_template", "apply_chat_template_kwargs", "rollout_seed", "rollout_shuffle",
+               "rollout_max_prompt_len", "rollout_batch_size", "n_samples_per_prompt", "data_source_path",
+               "rollout_function_path", "rm_type", "reward_key", "rollout_temperature", "rollout_top_p",
+               "rollout_top_k", "rollout_max_response_len", "rollout_max_context_len", "rollout_stop",
+               "rollout_stop_token_ids", "rollout_skip_special_tokens", "rollout_keep_special_tokens")
+
+
+def record(path):
+    with Path(path).open("rb") as stream:
+        return {"size": os.fstat(stream.fileno()).st_size,
+                "sha256": hashlib.file_digest(stream, "sha256").hexdigest()}
+
+
+def data_signature(args):
+    # Initial synchronous support deliberately uses one local dataset, without
+    # slicing/globbing, custom hooks or background/partial rollout producers.
+    dataset = Path(args.prompt_data)
+    model = Path(args.hf_checkpoint)
+    tokenizer = {name: record(model / name) for name in
+                 ("tokenizer.json", "tokenizer_config.json", "chat_template.jinja", "special_tokens_map.json")
+                 if (model / name).is_file()}
+    value = {"dataset": record(dataset), "tokenizer": tokenizer,
+             "fields": {key: getattr(args, key, None) for key in DATA_FIELDS}}
+    return json.loads(json.dumps(value, sort_keys=True))
+
+
+def atomic_json(path, value, *, replace=False):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists() and not replace:
+        raise FileExistsError(f"Refusing to overwrite checkpoint boundary: {path}")
+    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w") as stream:
+            json.dump(value, stream, indent=2)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        if replace:
+            os.replace(temporary, path)
+        else:
+            # Exclusive publication also rejects concurrent writers.
+            os.link(temporary, path)
+        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def boundary_path(root, rollout_id):
+    return Path(root) / "rollout" / f"fsdp_committed_{rollout_id:07d}.json"
+
+
+def prepare_save(args, rollout_id):
+    root = Path(args.save)
+    for path in (boundary_path(root, rollout_id), root / f"iter_{rollout_id:07d}",
+                 root / "rollout" / f"global_dataset_state_dict_{rollout_id}.pt"):
+        if path.exists():
+            raise FileExistsError(f"Checkpoint output already exists: {path}; use a new --save directory")
+
+
+def cursor_summary(path):
+    import torch
+
+    # This is Slime's existing trusted local dataset state format (it may hold
+    # Sample objects); validate hashes before calling during restoration.
+    state = torch.load(path, map_location="cpu", weights_only=False)
+    keys = ("epoch_id", "sample_offset", "sample_group_index", "sample_index")
+    if not isinstance(state, dict) or any(type(state.get(key)) is not int or state[key] < 0 for key in keys):
+        raise ValueError("Invalid dataset cursor")
+    if state.get("buffer") or state.get("consumers"):
+        raise ValueError("Synchronous FSDP resume does not support buffered or background rollout state")
+    return {key: state[key] for key in keys}
+
+
+def commit(args, rollout_id, weight_version):
+    root = Path(args.save)
+    model_name = f"iter_{rollout_id:07d}/COMMITTED.json"
+    cursor_name = f"rollout/global_dataset_state_dict_{rollout_id}.pt"
+    model = json.loads((root / model_name).read_text())
+    if (model.get("format") != "slime-fsdpturbo-training-v1" or model.get("rollout_id") != rollout_id
+            or model.get("next_rollout_id") != rollout_id + 1 or model.get("weight_version") != weight_version):
+        raise ValueError("Trainer checkpoint does not match the data/weight boundary")
+    if data_signature(args) != args.fsdp_data_signature:
+        raise ValueError("Dataset or tokenizer changed during training")
+    files = {name: record(root / name) for name in (model_name, cursor_name)}
+    for name in files:
+        with (root / name).open("rb") as stream:
+            os.fsync(stream.fileno())
+    value = {"format": FORMAT, "rollout_id": rollout_id, "next_rollout_id": rollout_id + 1,
+             "optimizer_steps": model["optimizer_steps"], "weight_version": weight_version,
+             "data_signature": args.fsdp_data_signature, "files": files,
+             "cursor": cursor_summary(root / cursor_name)}
+    atomic_json(boundary_path(root, rollout_id), value)
+    atomic_json(root / LATEST, {"format": FORMAT, "rollout_id": rollout_id}, replace=True)
+    return value
+
+
+def read_boundary(root, step, expected_signature):
+    root = Path(root)
+    if step is None:
+        latest = json.loads((root / LATEST).read_text())
+        if latest.get("format") != FORMAT:
+            raise ValueError("Not an FSDP object-store checkpoint root")
+        step = latest["rollout_id"]
+    if type(step) is not int or step < 0:
+        raise ValueError("Invalid checkpoint rollout ID")
+    value = json.loads(boundary_path(root, step).read_text())
+    if (value.get("format") != FORMAT or value.get("rollout_id") != step
+            or value.get("next_rollout_id") != step + 1 or value.get("data_signature") != expected_signature):
+        raise ValueError("Checkpoint data configuration or training boundary mismatch")
+    names = {f"iter_{step:07d}/COMMITTED.json", f"rollout/global_dataset_state_dict_{step}.pt"}
+    if set(value.get("files", {})) != names:
+        raise ValueError("Incomplete joint checkpoint manifest")
+    for name in names:
+        path = root / name
+        if path.is_symlink() or not path.resolve().is_relative_to(root.resolve()) or record(path) != value["files"][name]:
+            raise ValueError(f"Checkpoint component missing or corrupted: {name}")
+    model = json.loads((root / f"iter_{step:07d}/COMMITTED.json").read_text())
+    for key in ("rollout_id", "next_rollout_id", "optimizer_steps", "weight_version"):
+        if type(value.get(key)) is not int or value[key] < 0 or value[key] != model.get(key):
+            raise ValueError(f"Joint/model checkpoint progress mismatch: {key}")
+    if value["optimizer_steps"] <= 0 or cursor_summary(root / f"rollout/global_dataset_state_dict_{step}.pt") != value["cursor"]:
+        raise ValueError("Invalid model step or data cursor")
+    return value
+
+
+def resolve(args):
+    """Select only an explicit complete boundary, never silently start from HF."""
+    args.fsdp_data_signature = data_signature(args)
+    if args.load:
+        value = read_boundary(args.load, args.ckpt_step, args.fsdp_data_signature)
+        if args.start_rollout_id not in (None, value["next_rollout_id"]):
+            raise ValueError("--start-rollout-id differs from saved checkpoint")
+        args.ckpt_step = value["rollout_id"]
+        args.start_rollout_id = value["next_rollout_id"]
+        args.fsdp_checkpoint_load = Path(args.load) / f"iter_{args.ckpt_step:07d}"
+        args.update_weight_start_version = value["weight_version"]
+    else:
+        if args.ckpt_step is not None or args.start_rollout_id not in (None, 0):
+            raise ValueError("Starting after rollout zero requires --load")
+        args.start_rollout_id = 0
+        args.update_weight_start_version = 0
+    if args.num_rollout <= args.start_rollout_id:
+        raise ValueError("--num-rollout is a total count and must exceed restored progress")
+    args.fsdp_checkpoint_save = Path(args.save)
+    # Do not overwrite incomplete or later checkpoints when rewinding a job.
+    if Path(args.save).exists():
+        for path in Path(args.save).glob("iter_*"):
+            if path.name.removeprefix("iter_").isdigit() and int(path.name[5:]) >= args.start_rollout_id:
+                raise ValueError("Save directory contains this or later rollouts; choose a new --save directory")
+    # Saving precedes the normal post-train weight publication. A prior attempt
+    # may have already published a later version: allocate beyond every file,
+    # retaining no-overwrite semantics even when rolling back a checkpoint.
+    weights = Path(args.update_weight_disk_dir)
+    versions = [int(p.name[8:]) for p in weights.glob("weight_v*") if p.name[8:].isdigit()]
+    args.update_weight_start_version = max([args.update_weight_start_version, *versions])
