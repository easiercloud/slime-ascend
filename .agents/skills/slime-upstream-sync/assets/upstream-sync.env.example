# 必填：必须确实包含 refactor 分支和 slime 子模块。
SLIME_ASCEND_REPO_URL=https://gitcode.com/may_feimei/slime-ascend.git
SLIME_ASCEND_BASE_BRANCH=refactor

SLIME_UPSTREAM_REPO_URL=https://github.com/THUDM/slime.git
SLIME_UPSTREAM_BRANCH=main
SLIME_UPSTREAM_SUBMODULE_PATH=slime

SLIME_SYNC_STATE_DIR=/var/lib/slime-upstream-sync
SLIME_SYNC_WORK_ROOT=/var/tmp/slime-upstream-sync
SLIME_SYNC_PUSH_REMOTE=origin
SLIME_SYNC_PUSH_BRANCH_PREFIX=sync/upstream-slime
SLIME_SYNC_SUCCESS_TAG_PREFIX=sync-success/slime-main

# 可按部署环境覆盖；不要把 token 写进此文件。
SLIME_SYNC_AGENT_COMMAND=codex exec
# 成功工作区是否保留；失败工作区始终保留以便审计和排障。
SLIME_SYNC_KEEP_WORKSPACE=0

# 当前机器试运行时由部署环境设置；长期全量机器也使用同名变量。
# SLIME_TEST_HF_WEIGHTS_ROOT=/local/path/to/weights
# SLIME_TEST_DATASETS_ROOT=/local/path/to/datasets
# SLIME_TEST_MEGATRON_WEIGHTS_ROOT=/local/path/to/weights-MA
# 自动升级节奏建议：使用 assets/slime-upstream-sync.cron 或 systemd timer 每两周运行一次。
# 每次 run 必须重新扫描当前 upstream 的 slime/tests/**/test_*.py；不要配置固定 inventory 路径。
