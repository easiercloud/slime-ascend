# Ascend A3, CANN 9.1.0, Python 3.12. Build from the repository root.
FROM quay.io/ascend/cann:9.1.0-a3-ubuntu22.04-py3.12

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG SGL_KERNEL_NPU_VERSION=2026.9.0.post10
ARG SGL_KERNEL_NPU_URL
ENV http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    SGL_KERNEL_NPU_VERSION=${SGL_KERNEL_NPU_VERSION} \
    SGL_KERNEL_NPU_URL=${SGL_KERNEL_NPU_URL} \
    SLIME_ASCEND_DEPS_ROOT=/workspace \
    NPU_DEVICE=A3

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake curl git jq libnuma-dev unzip wget && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/slime-ascend
COPY . .

# quick_install.sh is the single dependency and third-party patch entry point.
# build.sh applies the Slime v0.4.0 patch series from patches/MANIFEST.toml.
RUN python -c 'import sys; assert sys.version_info[:2] == (3, 12), sys.version' && \
    bash scripts/quick_install.sh && \
    python -c 'import slime; import torch; import torch_npu; print(torch.__version__)'

CMD ["/bin/bash"]
