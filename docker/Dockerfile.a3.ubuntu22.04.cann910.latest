FROM --platform=linux/arm64 quay.io/ascend/cann:9.1.0-a3-ubuntu22.04-py3.12

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV http_proxy=$HTTP_PROXY
ENV https_proxy=$HTTPS_PROXY
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY

WORKDIR /workspace

# 基础系统依赖
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        gcc g++ cmake libnuma-dev wget git curl jq vim build-essential unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --upgrade pip packaging setuptools==80.10.2 && \
    python -c 'import sys; assert sys.version_info[:2] == (3, 12), sys.version' && \
    grep -q '^version=9.1.0$' /usr/local/Ascend/ascend-toolkit/latest/aarch64-linux/ascend_toolkit_install.info && \
    test "$(uname -m)" = aarch64 && \
    git config --global user.email 'temp@example.com' && git config --global user.name 'temp'

# 从仓库根目录构建，保留 Git 元数据以回放子模块补丁
COPY . /workspace/slime-ascend
RUN python /workspace/slime-ascend/scripts/check_patch_manifest.py

# 安装 PyTorch 和 torch_npu
RUN pip install torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install torch_npu==2.10.0.post6 --extra-index-url https://ascend.devcloud.huaweicloud.com/pypi/simple/

# 1. 安装 SGLang v0.5.21，匹配当前 Slime main
RUN git clone --depth 1 --branch v0.5.21 https://github.com/sgl-project/sglang.git /workspace/sglang && \
    cd /workspace/sglang && git checkout v0.5.21 && \
    test "$(git rev-parse HEAD)" = e00930c5489053f26d86b179cee0d087f846acbb && \
    for patch in sglang.patch sglang-top_p.patch sglang-release_hicache.patch sglang-pull_weights.patch sglang-deterministic.patch; do \
        git apply "/workspace/slime-ascend/patches/third_party/sglang/${patch}" || exit; \
    done && \
    git add -A && git -c user.name=slime-sync -c user.email=slime-sync@localhost commit -m 'Apply Slime v0.5.21 SGLang integration patches' && \
    git am /workspace/slime-ascend/patches/third_party/sglang/0001-v0.5.21-tms-forward-graph-args.patch && \
    mv python/pyproject.toml python/pyproject.toml.backup && \
    mv python/pyproject_npu.toml python/pyproject.toml && \
    grep -q '"transformers==5.12.1"' python/pyproject.toml && \
    pip install -e 'python[all_npu]'

# 2. 安装基础依赖和 NPU 内核预编译包
RUN pip install \
        pybind11==3.0.3 \
        transformers==5.12.1 \
        https://github.com/triton-lang/triton-ascend/releases/download/v3.2.1/triton_ascend-3.2.1-cp312-cp312-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl \
        https://obs-memfabric-hybrid.obs.cn-north-4.myhuaweicloud.com/mf/v1.2.1/20260923.4/memfabric_hybrid-1.2.1-cp312-cp312-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl \
        memfabric-zbal==1.1.3 && \
    pip install sglang-router==0.3.2 --force-reinstall && \
    python -c 'import sglang_router' && \
    cd /tmp && \
    wget https://github.com/sgl-project/sgl-kernel-npu/releases/download/2026.9.0.post11/sgl-kernel-npu-2026.9.0.post11-torch2.10.0-py312-cann9.1.0-a3-aarch64.zip -O sgl-kernel-npu-a3.zip && \
    echo "1fec018f7842f505cdf13555a0bd948e4f5b6c8b0ef2c6a4dc800d1df8373e97  sgl-kernel-npu-a3.zip" | sha256sum -c - && \
    unzip sgl-kernel-npu-a3.zip && \
    pip install torch_memory_saver*.whl && \
    pip install sgl_kernel_npu*.whl attentions*.whl && \
    pip install deep_ep*.whl && \
    cd "$(pip show deep-ep | awk '/^Location:/ {print $2}')" && \
    ln -s deep_ep/deep_ep_cpp*.so

# 3. 仅重新构建已打补丁的 torch-memory-saver wheel
RUN git clone https://github.com/sgl-project/sgl-kernel-npu.git /tmp/sgl-kernel-npu-src && \
    cd /tmp/sgl-kernel-npu-src && git checkout 9765e27532b8f854717eba1d3fb9a0bb97a0c887 && \
    git am /workspace/slime-ascend/patches/third_party/sgl-kernel-npu/0001-fix-torch-memory-saver-allocation-lifecycle.patch \
           /workspace/slime-ascend/patches/third_party/sgl-kernel-npu/0002-fix-tms-sglang-cuda-graph-api-and-preload-mode.patch \
           /workspace/slime-ascend/patches/third_party/sgl-kernel-npu/0003-fix-tms-unaligned-allocations-and-nested-regions.patch && \
    cd contrib/torch_memory_saver/python && \
    python3 setup.py clean --all && python3 setup.py bdist_wheel && \
    pip install --force-reinstall dist/torch_memory_saver*.whl

# 4. 安装 mbridge、Megatron-Bridge 和 Megatron-LM
RUN git clone https://github.com/ISEEKYAN/mbridge.git /workspace/mbridge && \
    cd /workspace/mbridge && git checkout 89eb10887887bc74853f89a4de258c0702932a1c && \
    git am /workspace/slime-ascend/patches/third_party/mbridge/0001-fix-device-type.patch && pip install -e . && \
    git clone https://github.com/fzyzcjy/Megatron-Bridge.git /workspace/Megatron-Bridge && \
    cd /workspace/Megatron-Bridge && git checkout 35b4ebfc486fb15dcc0273ceea804c3606be948a && \
    git am /workspace/slime-ascend/patches/third_party/megatron-bridge/0001-ascend-megatron-bridge-patch-for-slime-v0.3.2.patch \
           /workspace/slime-ascend/patches/third_party/megatron-bridge/0002-adapts-to-transformer-5.3.0-for-VL-model.patch \
           /workspace/slime-ascend/patches/third_party/megatron-bridge/0003-megatron-Bridge-for-Qwen.patch && \
    pip install 'nvidia-modelopt[torch]==0.46.1' --no-build-isolation && \
    git clone --recursive https://github.com/NVIDIA/Megatron-LM.git /workspace/Megatron-LM && \
    cd /workspace/Megatron-LM && git checkout 4b4acac9a1d28ea6829c8d4f566d75698a21249d && \
    git am /workspace/slime-ascend/patches/third_party/megatron/megatron-npu-v040-rebased.patch \
           /workspace/slime-ascend/patches/third_party/megatron/0002-ascend-async-checkpoint-worker.patch && pip install -e .

# 5. 安装 MegatronAdaptor 和 TransformerEngineNPU
RUN git clone https://gitcode.com/Ascend/MegatronAdaptor.git /workspace/MegatronAdaptor && \
    cd /workspace/MegatronAdaptor && git checkout eb0e5043438dd753099432bc3b3d8e5916ed1844 && \
    git am /workspace/slime-ascend/patches/third_party/megatron-adaptor/0001-async-preload-pickle.patch && pip install -e . && \
    git clone https://gitcode.com/Ascend/TransformerEngineNPU.git /workspace/TransformerEngineNPU && \
    cd /workspace/TransformerEngineNPU && git checkout 2b8529f94c3fd10497bf772bdc5b448b7ed4659a && \
    pip install -e .

# 6. 固定 Triton-Ascend 并回放 Slime main 补丁
RUN pip uninstall -y triton triton-ascend opencv-python && \
    pip install https://github.com/triton-lang/triton-ascend/releases/download/v3.2.1/triton_ascend-3.2.1-cp312-cp312-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl --no-cache-dir && \
    echo 'source /usr/local/Ascend/ascend-toolkit/set_env.sh' >> /root/.bashrc && \
    echo 'source /usr/local/Ascend/nnal/atb/set_env.sh' >> /root/.bashrc && \
    cd /workspace/slime-ascend && git submodule update --init --recursive && \
    bash build.sh && pip install -e slime && mkdir -p logs && \
    python -c 'import slime, torch, torch_npu; print(torch.__version__)'

RUN pip list && unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY

CMD ["/bin/bash"]
